#!/usr/bin/env python3
"""mango-keys: the keybinding cheatsheet (super+/) and the which-key cards, from ~/.config/mango/bind.conf.

usage: mango-keys              open the cheatsheet (a floating Ghostty running fzf); again closes it
       mango-keys --tui        the fzf interface itself (what the Ghostty window runs)
       mango-keys --rank Q     fzf's rows for query Q, best first, matches highlighted
       mango-keys --card ROW   the group card of row ROW (fzf's preview pane)
       mango-keys --pango MODE the group card of key mode MODE as Pango markup (mango-whichkey)
       mango-keys --print      every row as plain text: group, keys, description

bind.conf: `## Name` starts a group, `#: text ~ words` describes the bind below it (the words after
` ~ ` are searchable, not shown), `key_mode=NAME` starts a mode's binds. A mode's keys are shown
after the keys that open it (`setkeymode,NAME`), so its binds read `Super+M › H`.
Colors come from ~/.config/theme/colors.sh (the active palette): the caps wear the keyboard's
neutrals (THEME_KEY_*: dark modifiers, grey letters) and group names are quiet labels. Color is kept
for what it means: the signal (accent) on the pointer, the selected row's mark and its action key
(key_accent); the route color (link) under the letters a search matched.
"""
import html
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
from pathlib import Path

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
CONF = Path(os.environ.get("MANGO_KEYS_CONF", CONFIG / "mango/bind.conf"))
COLORS = Path(os.environ.get("MANGO_KEYS_COLORS", CONFIG / "theme/colors.sh"))
CACHE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"mango-keys-{os.getuid()}.json"
APP_ID = "com.mitchellh.ghostty-keys"
SELF = os.path.realpath(__file__)

# mango's dispatchers -> a description, for binds without a `#: ` line; {0} is the first argument
ACTIONS = {
    "view": "Show tag {0}", "tag": "Move window to tag {0}", "toggleview": "Also show tag {0}",
    "toggletag": "Also put window on tag {0}", "killclient": "Close window", "setkeymode": "Mode: {0}",
}
SYNONYMS = {  # extra words for the generated rows
    "view": "workspace switch go", "tag": "move send workspace", "toggleview": "add workspace",
    "toggletag": "add workspace",
}
KEYS = {  # how a key name reads on a cap
    "return": "Enter", "escape": "Esc", "backslash": "\\", "slash": "/", "backspace": "Bksp",
    "left": "←", "right": "→", "up": "↑", "down": "↓", "tab": "Tab", "space": "Space", "print": "PrtSc",
    "equal": "=", "minus": "-", "bracketleft": "[", "bracketright": "]",
    "btn_left": "L-click", "btn_right": "R-click", "btn_middle": "M-click",
    "xf86audioraisevolume": "Vol+", "xf86audiolowervolume": "Vol-", "xf86audiomute": "Mute",
    "xf86audiomicmute": "Mic", "xf86monbrightnessup": "Bri+", "xf86monbrightnessdown": "Bri-",
    "xf86audioplay": "Play", "xf86audionext": "Next", "xf86audioprev": "Prev",
}
KEY_WORDS = {  # what you may type to find a key
    "Enter": "enter return", "Esc": "esc escape", "←": "left arrow",
    "→": "right arrow", "↑": "up arrow", "↓": "down arrow", "/": "slash", "PrtSc": "print prtsc",
    "Tab": "tab", "=": "equal plus", "-": "minus", "[": "bracket", "]": "bracket",
}
MODS = {"super": "Super", "ctrl": "Ctrl", "alt": "Alt", "shift": "Shift"}
DIRS = {"left": "←", "right": "→", "up": "↑", "down": "↓"}


# ---------------------------------------------------------------- parsing

def step(mods, key):
    """One chord: modifier caps and the key cap."""
    caps = [MODS[m.lower()] for m in mods.split("+") if m.lower() in MODS]
    label = KEYS.get(key.lower(), key.upper() if len(key) == 1 else key)
    return caps + [label]


def parse(text):
    """Rows from bind.conf: dicts with group, mode, steps (list of chords), desc, syn, action."""
    raw, group, note, mode = [], "", None, "default"
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("## "):
            group, note = line[3:], None
        elif line.startswith("#: "):
            note = line[3:]
        elif line.startswith("key_mode="):
            mode = line.split("=", 1)[1].strip()
        elif m := re.match(r"(bind[slrpc]*|mousebind|gesturebind)=(.*)", line):
            kind, f = m[1], [x.strip() for x in m[2].split(",")]
            if kind == "gesturebind":
                chord, action, args = [f"{f[2]} fingers", DIRS[f[1].lower()]], f[3], f[4:]
            else:
                chord, action, args = step(f[0], f[1]), f[2], f[3:]
            raw.append(dict(group=group, mode=mode, chord=chord, action=action,
                            args=[a for a in args if a], note=note))
            note = None
        elif not line.startswith("#"):
            note = None
    # the keys that open each mode: a setkeymode bind in its parent mode (the first one: NONE before SUPER)
    opens = {}
    for r in raw:
        if r["action"] == "setkeymode" and r["args"] and r["args"][0] not in ("default", r["mode"]):
            opens.setdefault(r["args"][0], (r["mode"], r["chord"]))

    def path(mode, seen=()):
        if mode in ("default", "common") or mode not in opens or mode in seen:
            return []
        parent, chord = opens[mode]
        return path(parent, seen + (mode,)) + [chord]

    rows, done = [], set()
    for r in raw:
        if r["action"] == "setkeymode" and r["args"] and r["args"][0] == "default" and not r["note"]:
            continue  # the second half of a one-shot, or an exit key
        key = (r["mode"], r["action"], tuple(r["args"]))
        if key in done:
            continue  # the same bind with super still held (leader)
        done.add(key)
        desc, _, syn = (r["note"] or "").partition(" ~ ")
        if not desc:
            a = r["args"]
            desc = ACTIONS.get(r["action"], r["action"].replace("_", " ").capitalize()).format(*(a or [""])).strip()
            syn = SYNONYMS.get(r["action"], "")
        rows.append(dict(group=r["group"], mode=r["mode"], steps=path(r["mode"]) + [r["chord"]],
                         desc=desc.strip(), syn=syn.strip(), action=r["action"], args=r["args"]))
    return collapse(rows)


def collapse(rows):
    """Runs of binds that differ only by a tag digit (also their first argument) become one row: 1-9."""
    out = []
    for r in rows:
        last = r["steps"][-1]
        digit = last[-1].isdigit() and r["args"] and r["args"][0] == last[-1]
        p = out[-1] if out else None
        if (digit and p and p.get("digit") and p["group"] == r["group"] and p["action"] == r["action"]
                and p["steps"][-1][:-1] == last[:-1]):
            p["steps"][-1][-1] = f"{p['first']}-{last[-1]}"
            p["desc"] = re.sub(r"\s*\b\d+$", "", p["desc"])
            continue
        r = dict(r, digit=bool(digit), first=last[-1])
        out.append(r)
    for r in out:
        r.pop("digit"), r.pop("first")
    return out


def rows():
    """The parsed rows, cached per bind.conf change (fzf reruns the ranking on every key press)."""
    stamp = f"{CONF.stat().st_mtime_ns}:{CONF.stat().st_size}:{os.stat(SELF).st_mtime_ns}"
    try:
        c = json.loads(CACHE.read_text())
        if c["stamp"] == stamp:
            return c["rows"]
    except (OSError, ValueError, KeyError):
        pass
    r = parse(CONF.read_text())
    try:
        CACHE.write_text(json.dumps({"stamp": stamp, "rows": r}))
    except OSError:
        pass
    return r


# ---------------------------------------------------------------- search

def words(text):
    return re.findall(r"[a-z0-9]+", text.lower())


def key_words(r):
    out = []
    for chord in r["steps"]:
        for k in chord:
            out += KEY_WORDS.get(k, k.lower()).split()
    return out


def damerau(a, b, limit):
    """Edit distance with adjacent swaps, or limit+1 once it is past limit."""
    if abs(len(a) - len(b)) > limit:
        return limit + 1
    prev2, prev = None, list(range(len(b) + 1))
    for i in range(1, len(a) + 1):
        cur = [i] + [0] * len(b)
        for j in range(1, len(b) + 1):
            cost = a[i - 1] != b[j - 1]
            cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                cur[j] = min(cur[j], prev2[j - 2] + 1)
        if min(cur) > limit:
            return limit + 1
        prev2, prev = prev, cur
    return prev[-1]


def subsequence(t, w):
    """Positions of t's letters in order in w (fzf-style), or None."""
    pos, i = [], 0
    for ch in t:
        i = w.find(ch, i)
        if i < 0:
            return None
        pos.append(i)
        i += 1
    return pos


def word_score(t, w):
    """How well query word t matches word w, and which letters of w matched."""
    if w == t:
        return 100, range(len(w))
    if w.startswith(t):
        return 80 + 10 * len(t) / len(w), range(len(t))
    if len(t) >= 3 and t in w:
        i = w.index(t)
        return 60, range(i, i + len(t))
    if len(t) >= 3 and t[0] == w[0] and (pos := subsequence(t, w)):
        gaps = pos[-1] - pos[0] + 1 - len(t)
        return max(45 - 4 * gaps, 25), pos
    if len(t) >= 4:
        limit = 2 if len(t) >= 7 else 1
        if damerau(t, w, limit) <= limit:
            return 40 - 5 * damerau(t, w, limit), range(len(w))
        if len(w) > len(t) and damerau(t, w[:len(t)], 1) <= 1:  # a typo while typing a longer word
            return 32, range(len(t))
    return 0, ()


def rank(query, rs):
    """(row index, score, {desc word index: matched letters}) for rows matching every query word."""
    terms = [t for t in re.split(r"[\s+›>]+", query.lower()) if t]
    if not terms:
        return [(i, 0, {}) for i in range(len(rs))]
    out = []
    for i, r in enumerate(rs):
        dw, gw, sw, kw = words(r["desc"]), words(r["group"]), words(r["syn"]), key_words(r)
        total, marks = 0, {}
        for t in terms:
            best, hit = 0, None
            for k in kw:  # keys: single letters only match exactly; a digit matches a range (1-9)
                if k == t or (len(t) > 1 and k.startswith(t)):
                    best = max(best, 90 if k == t else 70)
                elif t.isdigit() and (m := re.fullmatch(r"(\d+)-(\d+)", k)) and int(m[1]) <= int(t) <= int(m[2]):
                    best = max(best, 90)
            for n, w in enumerate(dw):
                if len(t) == 1:
                    s, p = (30, range(1)) if w.startswith(t) else (0, ())
                else:
                    s, p = word_score(t, w)
                if s > best:
                    best, hit = s, (n, p)
            for w in gw + sw:
                if len(t) > 1:
                    s = word_score(t, w)[0] * 0.8
                    if s > best:
                        best, hit = s, None
            if best == 0:
                break
            total += best
            if hit:
                marks.setdefault(hit[0], set()).update(hit[1])
        else:
            # equal matches: fewer keys to press, then the more specific (shorter) description first
            # extra keys in the chord rank below an exact chord (super d: the launcher, not super+ctrl+d)
            out.append((i, total - sum(len(c) for c in r["steps"]) - 0.5 * len(dw), marks))
    out.sort(key=lambda x: (-x[1], x[0]))
    return out


# ---------------------------------------------------------------- drawing

def palette():
    out = {}
    try:
        text = COLORS.read_text()
    except OSError:
        text = ""
    for line in text.splitlines():
        if m := re.match(r'THEME_(\w+)="([^"]*)"', line):
            out[m[1].lower()] = m[2]
    if "fg_text" not in out:
        sys.exit(f"mango-keys: no palette in {COLORS} (run: theme set <palette>)")
    return out


def mix(a, b, t):
    pa, pb = [int(a[i:i + 2], 16) for i in (1, 3, 5)], [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(pa, pb))


class Ink:
    """ANSI truecolor from the palette."""

    def __init__(self, p):
        self.p = p

    def c(self, role):
        return self.p.get(role) or self.p["fg_text"]

    @staticmethod
    def fg(h):
        return f"\x1b[38;2;{int(h[1:3], 16)};{int(h[3:5], 16)};{int(h[5:7], 16)}m"

    @staticmethod
    def bg(h):
        return f"\x1b[48;2;{int(h[1:3], 16)};{int(h[3:5], 16)};{int(h[5:7], 16)}m"

    def cap_colors(self, role):
        """A cap's face, its round ends and its legend. A modifier cap's ends are a step toward the frame's
        aluminium: an edge, as the dark cap would lose its shape on a dark background (and on the
        selected row's bar) without one."""
        face = self.c(role)
        return face, mix(face, self.c("key_frame"), 0.3) if role == "key_mod" else face, self.c("key_legend")

    def cap(self, label, role):
        face, edge, legend = self.cap_colors(role)
        bold = "" if role == "key_mod" else "\x1b[1m"
        return f"{self.fg(edge)}{self.bg(face)}{self.fg(legend)}{bold}{label}\x1b[0m{self.fg(edge)}\x1b[0m"

    def keys(self, steps, lit=False):
        """The caps of a bind's chords: held keys join with +, chords pressed in turn with ›."""
        frame = self.fg(self.c("key_frame"))
        return f" {frame}›\x1b[0m ".join(f"{frame}+\x1b[0m".join(self.cap(k, role) for k, role in chord)
                                         for chord in cap_roles(steps, lit))


def cap_roles(steps, lit=False):
    """Each key of each chord with the palette role of its cap: modifiers on the dark caps, every other
    key on a grey letter cap. `lit` is the selected row: the key that names its action takes the
    accent cap, the one saturated cap on screen."""
    return [[(k, "key_mod" if j < len(chord) - 1 else "key_accent" if lit and n == len(steps) - 1 else "key_cap")
             for j, k in enumerate(chord)] for n, chord in enumerate(steps)]


def visible(s):
    return len(re.sub(r"\x1b\[[0-9;]*m", "", s))


# The grid. A cap's background fills its cell from top to bottom, so caps on consecutive lines would
# touch: every view keeps one line between rows of caps (fzf's --gap in the list, a blank line in the
# card, a thin spacer line in the popup). Columns are GUTTER cells apart, and caps are right-aligned
# so the key that names the action always sits next to its description.
GUTTER = 2
MARGIN = 3  # the card's left margin: the mark of the selected row sits in it
EDGE = 2  # fzf's side margin in cells (one line above and below): with Ghostty's padding, 34 px all round


def chip(ink, group):
    return f"{ink.fg(ink.c('fg_muted'))}{group.lower()}\x1b[0m"  # labels whisper: lowercase, regular, muted


def highlight(ink, desc, marks):
    """The description with matched letters in the highlight color."""
    if not marks:
        return f"{ink.fg(ink.c('fg_text'))}{desc}\x1b[0m"
    out, n, base, hi = [], -1, ink.fg(ink.c("fg_text")), ink.fg(ink.c("link")) + "\x1b[1;4m"
    for tok in re.split(r"([A-Za-z0-9]+)", desc):
        if re.fullmatch(r"[A-Za-z0-9]+", tok):
            n += 1
            m = marks.get(n, ())
            out.append("".join(f"{hi}{ch}\x1b[0m{base}" if i in m else ch for i, ch in enumerate(tok)))
        else:
            out.append(tok)
    return base + "".join(out) + "\x1b[0m"


def list_field(rs, caps):
    """Width of the list's first field: the group's name on the left, the caps on the right, GUTTER apart
    in its tightest row. From every row, not just the matches, so the layout doesn't shift as you type."""
    return max(len(r["group"]) + GUTTER + visible(k) for r, k in zip(rs, caps))


def list_lines(query):
    rs, ink = rows(), Ink(palette())
    caps = [ink.keys(r["steps"]) for r in rs]
    field = list_field(rs, caps)
    out = []
    for i, _, marks in rank(query, rs):
        r = rs[i]
        pad = " " * (field - len(r["group"]) - visible(caps[i]))
        out.append(f"{i}\t {chip(ink, r['group'])}{pad}{caps[i]}{' ' * GUTTER}{highlight(ink, r['desc'], marks)}")
    return out


def entry(rs, mode):
    """How a mode is opened, as text: Super+M."""
    for r in rs:
        if r["action"] == "setkeymode" and r["args"] and r["args"][0] == mode:
            return " › ".join("+".join(c) for c in r["steps"])
    return ""


def card_caps(ink, group, sel=None):
    """Each row's caps as its group's card shows them. A mode's rows drop the keys that open it when the
    card also shows the row that opens it, and read `› H` below that row. `sel` is the selected row."""
    shown = [r["steps"] for r in group]
    then = f"{ink.fg(ink.c('key_frame'))}›\x1b[0m "
    return [then + ink.keys(r["steps"][-1:], r is sel) if r["steps"][:-1] in shown else ink.keys(r["steps"], r is sel)
            for r in group]


def card(i):
    """A group's keys for fzf's preview pane: its title, then a row of caps on every other line (the
    lines the list's rows are on)."""
    rs, ink = rows(), Ink(palette())
    if not i.isdigit():  # no row: nothing matched the query
        return ""
    sel = rs[int(i)]
    group = [r for r in rs if r["group"] == sel["group"]]
    caps, signal = card_caps(ink, group, sel), ink.c("accent")
    width = max(map(visible, caps))
    cols, lines = (int(os.environ.get(v) or 0) for v in ("FZF_PREVIEW_COLUMNS", "FZF_PREVIEW_LINES"))
    room = max(cols - MARGIN - width - GUTTER, 10) if cols else 200  # for the description
    head = [f"{' ' * MARGIN}{ink.fg(ink.c('fg_bright'))}\x1b[1m{sel['group'].lower()}\x1b[0m", ""]
    body, at = [], 0
    for r, k in zip(group, caps):
        mark, tone = (f"{ink.fg(signal)}▌\x1b[0m", "fg_bright") if r is sel else (" ", "fg_text")
        if r is sel:
            at = len(body)
        # a description wider than the pane continues on the line between caps
        first, *more = textwrap.wrap(r["desc"], room) or [""]
        body.append(f" {mark} {' ' * (width - visible(k))}{k}{' ' * GUTTER}{ink.fg(ink.c(tone))}{first}\x1b[0m")
        body += [f"{' ' * (MARGIN + width + GUTTER)}{ink.fg(ink.c(tone))}{t}\x1b[0m" for t in more]
        body += [""] * (1 - len(more) % 2)
    if not body[-1]:
        body.pop()
    if lines and len(head) + len(body) > lines:  # a group taller than the pane: the rows around the selected one
        fit = (lines - len(head)) // 2 * 2
        top = max(0, min(at - fit // 2, len(body) - fit))
        top += top % 2  # start on a row of caps
        body = body[top:top + fit]
    return "\n".join(head + body)


def pango(mode):
    """A key mode's card as Pango markup for the which-key popup: the same caps as the list's."""
    rs, ink = rows(), Ink(palette())
    group = [r for r in rs if r["mode"] == mode]
    if not group:
        return ""
    e, frame = html.escape, ink.c("key_frame")

    def cap(label, role):
        face, edge, legend = ink.cap_colors(role)
        weight = "normal" if role == "key_mod" else "bold"
        return (f"<span foreground='{edge}'></span><span background='{face}' foreground='{legend}' "
                f"weight='{weight}'>{e(label)}</span><span foreground='{edge}'></span>")

    plus = f"<span foreground='{frame}'>+</span>"
    chords = [cap_roles(r["steps"][-1:])[0] for r in group]
    sizes = [sum(len(k) + 3 for k, _ in chord) - 1 for chord in chords]
    out = [f"<span foreground='{ink.c('fg_bright')}' weight='bold'>"
           f"{e(group[0]['group'].lower())}</span>   <span foreground='{frame}'>{e(entry(rs, mode))}</span>", ""]
    for r, chord, size in zip(group, chords, sizes):
        out.append(f"{' ' * (max(sizes) - size)}{plus.join(cap(k, role) for k, role in chord)}{' ' * GUTTER}"
                   f"<span foreground='{ink.c('fg_text')}'>{e(r['desc'])}</span>")
    out += ["", f"<span foreground='{frame}'>Esc leaves</span>"]
    # a thin line between rows so the caps don't touch (a background fills the whole line height)
    gap = "\n<span size='3pt'> </span>\n"
    return "\n".join(out[:2]) + "\n" + gap.join(out[2:-2]) + "\n" + "\n".join(out[-2:])


# ---------------------------------------------------------------- the window

# the modifiers you hold and the groups they reach, for the legend under the list
LAYERS = [("Super", ("go", "open")), ("+Shift", ("carry",)), ("+Alt", ("window",)), ("+Ctrl", ("layout",))]


def tui():
    rs, ink, me = rows(), Ink(palette()), SELF
    c = ink.c
    colors = ",".join([
        f"fg:{c('fg_text')}", f"bg:{c('bg_desktop')}", f"hl:{c('link')}", f"fg+:{c('fg_bright')}",
        f"bg+:{c('bg_hover')}", f"hl+:{c('link')}", f"info:{c('key_frame')}", f"prompt:{c('key_frame')}",
        f"pointer:{c('accent')}", f"spinner:{c('key_frame')}", f"footer:{c('key_frame')}",
        f"ghost:{c('key_frame')}:regular", f"border:{c('border_hairline')}",
        f"preview-border:{c('border_hairline')}", f"query:{c('fg_bright')}", f"gutter:{c('bg_desktop')}"
    ])
    # the legend: each layer's modifiers and its groups, drawn as the list's chips; the rest in the footer's color
    text = ink.fg(c("fg_text"))
    legend = "   ".join(f"{text}{mods}\x1b[0m " + " · ".join(chip(ink, g) for g in names) for mods, names in LAYERS)
    legend = f" {legend}   {text}Esc\x1b[0m closes"
    # The panes: the list and the card show the same descriptions, so both get the same room for them
    # after their own columns (all of the longest description if the window is wide enough). fzf takes
    # its margins, the pointer, a spare column beside the list and the pane's border and padding.
    caps, groups = [ink.keys(r["steps"]) for r in rs], {}
    for r in rs:
        groups.setdefault(r["group"], []).append(r)
    in_list = 1 + list_field(rs, caps) + GUTTER + 1  # a cell free at each end of the selected row's bar
    in_card = MARGIN + max(visible(k) for g in groups.values() for k in card_caps(ink, g)) + GUTTER
    size = shutil.get_terminal_size()
    free = size.columns - 2 * EDGE - 4 - in_list - in_card
    pane = in_card + max(min(max(len(r["desc"]) for r in rs), free // 2), 10)
    rank_cmd = f"{me} --rank {{q}}"
    # the first list: fzf runs this when its input is a terminal (instead of its default `find`)
    os.environ["FZF_DEFAULT_COMMAND"] = f"{shlex.quote(me)} --rank ''"
    # top to bottom: a margin, the input, a blank line (an empty header), the rows with a blank line
    # after each (--gap; the last one sets the legend apart), the legend, a margin. The rows need an
    # even number of lines or the last one loses its blank line: the bottom margin takes an odd one.
    below = 1 + (size.lines - 5) % 2
    os.execvp("fzf", [
        "fzf", "--ansi", "--disabled", "--no-sort", "--layout=reverse", "--delimiter=\t", "--with-nth=2..",
        "--gap", "--gap-line= ", "--highlight-line", "--pointer=▌", "--marker=", "--no-scrollbar", "--ellipsis=…",
        "--prompt=❯ ", "--ghost=type to search", "--info=inline-right", "--no-separator", "--header= ",
        "--footer", legend, "--footer-border=none", "--border=none",
        "--color", colors, f"--margin=1,{EDGE},{below}", "--padding=0",
        "--preview", f"{me} --card {{1}}", "--preview-window", f"right,{pane},border-left,noinfo",
        "--bind", f"change:reload({rank_cmd})+first",
        "--bind", "enter:abort,esc:abort,ctrl-c:abort",
    ])


def toggle():
    """Close the cheatsheet if it is open, else open it."""
    if subprocess.run(["pkill", "-f", f"{SELF} --tui"], check=False).returncode == 0:
        return
    term = shutil.which("ghostty") or "ghostty"
    # the window is sized to the grid (mango's window_rule); should its size stop being a whole number
    # of cells, the leftover goes to every side instead of the right and the bottom
    subprocess.Popen([term, f"--class={APP_ID}", "--title=Keybindings", "--window-padding-balance=true", "--background-opacity=0.85",
                      "-e", SELF, "--tui"],
                     start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    a = sys.argv[1:]
    if not a:
        return toggle()
    if a[0] == "--tui":
        return tui()
    if a[0] == "--rank":
        sys.stdout.write("".join(line + "\n" for line in list_lines(" ".join(a[1:]))))
    elif a[0] == "--card":
        print(card(a[1]))
    elif a[0] == "--pango":
        print(pango(a[1]))
    elif a[0] == "--print":
        for r in rows():
            print(f"{r['group']:<14}{' › '.join('+'.join(c) for c in r['steps']):<24}{r['desc']}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
