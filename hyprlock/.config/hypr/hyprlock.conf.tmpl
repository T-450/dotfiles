# Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
# The lock screen (hyprlock), "Viewport" (SGI CAD): keeps the lock image (~/.local/state/wallpaper/lock)
# dimmed and crisp, with a centered 0px opaque vp_bar CAD auth console framed by a 1px cyan 45%
# border, hairline divider, integer-scaled Terminess clock, uppercase cyan date, and square 0px
# password field. Colors come from the palette's vp_* roles.

general {
    hide_cursor = true
    ignore_empty_input = true
}

# 150 ms fades on the desktop's one curve (mango's quadratic ease-out)
animations {
    enabled = true
    bezier = easeOut, 0.5, 1, 0.89, 1
    animation = fadeIn, 1, 1.5, easeOut
    animation = fadeOut, 1, 1.5, easeOut
    animation = inputFieldColors, 1, 1.5, easeOut
    animation = inputFieldDots, 1, 1.5, easeOut
}

background {
    monitor =
    path = {{home}}/.local/state/wallpaper/lock
    color = rgb({{bg_desktop|bare}})
    blur_passes = 0
    brightness = 0.50
    contrast = 1.0
    vibrancy = 0
}

# centered 0px opaque CAD auth console (border pre-mixed over vp_bar to avoid hyprlock alpha bleed)
shape {
    monitor =
    size = 420, 260
    color = rgb({{vp_bar|bare}})
    rounding = 0
    border_size = 1
    border_color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    position = 0, 0
    halign = center
    valign = center
    zindex = 1
}

# hairline header rule under SYSTEM LOCKED
shape {
    monitor =
    size = 418, 1
    color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    rounding = 0
    border_size = 0
    position = 0, 96
    halign = center
    valign = center
    zindex = 2
}

# header bar label
label {
    monitor =
    text = <span letter_spacing="1024">SYSTEM LOCKED</span>
    color = rgb({{vp_cyan|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = 0, 113
    halign = center
    valign = center
    zindex = 3
}

# integer-scaled pixel Terminess clock (3x 16px)
label {
    monitor =
    text = <b>$TIME</b>
    color = rgb({{vp_text|bare}})
    font_family = Terminess Nerd Font
    font_size = 48
    position = 0, 44
    halign = center
    valign = center
    zindex = 3
}

# uppercase cyan date readout
label {
    monitor =
    text = cmd[update:60000] date '+%^a · %-d %^b %Y'
    color = rgb({{vp_cyan|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = 0, -4
    halign = center
    valign = center
    zindex = 3
}

# square 0px password input: signal focus, warn capslock, crit failure
input-field {
    monitor =
    size = 340, 36
    outline_thickness = 1
    rounding = 0
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    outer_color = rgb({{vp_signal|bare}})
    inner_color = rgb({{vp_bar|bare}})
    font_color = rgb({{vp_text|bare}})
    font_family = Terminess Nerd Font
    fade_on_empty = false
    placeholder_text = <span foreground="##{{vp_dim|bare}}" letter_spacing="1024">PASSWORD</span>
    check_color = rgb({{vp_cyan|bare}})
    fail_color = rgb({{vp_crit|bare}})
    fail_text = <span foreground="##{{vp_crit|bare}}" letter_spacing="1024">AUTH FAILED</span>
    capslock_color = rgb({{vp_warn|bare}})
    position = 0, -68
    halign = center
    valign = center
    zindex = 3
}
