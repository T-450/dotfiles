# Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
# The lock screen (hyprlock), after the Quiet Instrument philosophy: its own image (the Blue Dawn
# eclipse, centred so the clock sits inside the black sun) lightly blurred and dimmed. No panel: the
# black sun is the card, and the time, the date and a slim password pill sit inside its disc (about
# 360 px across at 1080p), a soft shadow keeping them legible on any other image. An image, not a
# screenshot, so nothing on screen shows through the lock. Colours come from the palette.

general {
    hide_cursor = true
    ignore_empty_input = true
}

# 150 ms fades on the desktop's one curve (mango's quadratic ease-out)
animations {
    enabled = true
    bezier = easeOut, 0.5, 1, 0.89, 1
    animation = fadeIn, 1, 1.5, easeOut
    animation = fadeOut, 1, 1.5, easeOut
    animation = inputFieldColors, 1, 1.5, easeOut
    animation = inputFieldDots, 1, 1.5, easeOut
}

# the lock image (wallpaper-set --lock's link; swaybg/setup.sh points it at the Blue Dawn eclipse),
# blurred only enough to soften its linework and dimmed to two thirds; the ground colour when there
# is none. A video wallpaper can't show here: hyprlock draws images only.
background {
    monitor =
    path = {{home}}/.local/state/wallpaper/lock
    color = rgb({{bg_desktop|bare}})
    blur_passes = 1
    blur_size = 4
    brightness = 0.68
    contrast = 1.0
    vibrancy = 0
    noise = 0.012
}

# primary fact at full brightness, light weight
label {
    monitor =
    text = <span font_weight="300">$TIME</span>
    color = rgb({{fg_bright|bare}})
    font_family = IBM Plex Sans
    font_size = 64
    shadow_passes = 2
    shadow_size = 6
    shadow_color = rgba({{shadow|bare}}99)
    position = 0, 56
    halign = center
    valign = center
}

# a label whispers: lowercase, muted
label {
    monitor =
    text = cmd[update:60000] date '+%A, %-d %B' | tr '[:upper:]' '[:lower:]'
    color = rgb({{fg_muted|bare}})
    font_family = IBM Plex Sans
    font_size = 13
    shadow_passes = 2
    shadow_size = 4
    shadow_color = rgba({{shadow|bare}}99)
    position = 0, 4
    halign = center
    valign = center
}

# the field is the one thing that matters here, so its edge is the signal; rose on a wrong password,
# amber while Caps Lock is on. A pill, its fill half see-through so it reads as part of the image
input-field {
    monitor =
    size = 240, 40
    outline_thickness = 1
    rounding = -1
    dots_size = 0.18
    dots_spacing = 0.4
    dots_center = true
    outer_color = rgb({{accent|bare}})
    inner_color = rgba({{bg_surface|bare}}80)
    font_color = rgb({{fg_bright|bare}})
    font_family = IBM Plex Sans
    fade_on_empty = false
    placeholder_text = <span foreground="##{{fg_muted|bare}}">password</span>
    check_color = rgb({{accent|bare}})
    fail_color = rgb({{error|bare}})
    fail_text = <span foreground="##{{error|bare}}">wrong password</span>
    capslock_color = rgb({{warning|bare}})
    position = 0, -64
    halign = center
    valign = center
}
