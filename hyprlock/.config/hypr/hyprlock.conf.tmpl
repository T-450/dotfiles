# Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
# The lock screen (hyprlock), "Viewport" (SGI CAD): dimmed Blue Dawn eclipse framed by 38px top
# and bottom Viewport status bars (matching waybar's λ, clock, and hairline cyan rules) and a
# centered 0px opaque vp_bar CAD auth console with a 2px signal focus rail and square password box.

general {
    hide_cursor = true
    ignore_empty_input = true
}

# 150 ms fades on the desktop's one curve (mango's quadratic ease-out)
animations {
    enabled = true
    bezier = easeOut, 0.5, 1, 0.89, 1
    animation = fadeIn, 1, 1.5, easeOut
    animation = fadeOut, 1, 1.5, easeOut
    animation = inputFieldColors, 1, 1.5, easeOut
    animation = inputFieldDots, 1, 1.5, easeOut
}

background {
    monitor =
    path = {{home}}/.local/state/wallpaper/lock
    color = rgb({{bg_desktop|bare}})
    blur_passes = 0
    brightness = 0.48
    contrast = 1.0
    vibrancy = 0
}

# ---------------------------------------------------------------- top 38px Viewport status bar
shape {
    monitor =
    size = 100%, 38
    color = rgb({{vp_bar|bare}})
    rounding = 0
    border_size = 0
    position = 0, 0
    halign = center
    valign = top
    zindex = 1
}

shape {
    monitor =
    size = 100%, 1
    color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    rounding = 0
    border_size = 0
    position = 0, -37
    halign = center
    valign = top
    zindex = 2
}

label {
    monitor =
    text = <b>λ</b>
    color = rgb({{vp_text|bare}})
    font_family = Terminess Nerd Font
    font_size = 24
    position = 18, -5
    halign = left
    valign = top
    zindex = 3
}

shape {
    monitor =
    size = 1, 16
    color = rgb({{vp_cyan|mix:vp_bar:0.30|bare}})
    rounding = 0
    border_size = 0
    position = 48, -11
    halign = left
    valign = top
    zindex = 3
}

label {
    monitor =
    text = cmd[update:0] printf '<span foreground="##{{vp_cyan|bare}}" letter_spacing="1024">%s</span>   <span foreground="##{{vp_orange|bare}}" letter_spacing="1024"><b>[LOCKED]</b></span>' "$(uname -n | tr '[:lower:]' '[:upper:]')"
    color = rgb({{vp_cyan|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = 62, -13
    halign = left
    valign = top
    zindex = 3
}

label {
    monitor =
    text = cmd[update:10000] printf '<span foreground="##{{vp_cyan|bare}}" font_size="12pt" letter_spacing="1024">%s</span>  <span foreground="##{{vp_text|bare}}" font_size="15pt"><b>%s</b></span>  <span foreground="##{{vp_cyan|bare}}" font_size="12pt" letter_spacing="1024">%s</span>' "$(date '+%^a')" "$(date '+%H:%M')" "$(date '+%-d %^b')"
    color = rgb({{vp_text|bare}})
    font_family = Terminess Nerd Font
    font_size = 14
    position = 0, -9
    halign = center
    valign = top
    zindex = 3
}

label {
    monitor =
    text = cmd[update:30000] sh -c 'b=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1); s=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1); if [ -n "$b" ]; then tag=BAT; [ "$s" = Charging ] && tag=CHG; printf "<span foreground=\"##{{vp_cyan|bare}}\" letter_spacing=\"1024\">%s %s%%</span>  <span foreground=\"##{{vp_dim|bare}}\" letter_spacing=\"1024\">·  MANGO</span>" "$tag" "$b"; else printf "<span foreground=\"##{{vp_dim|bare}}\" letter_spacing=\"1024\">SESSION · MANGO</span>"; fi'
    color = rgb({{vp_dim|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = -16, -13
    halign = right
    valign = top
    zindex = 3
}

# ---------------------------------------------------------------- bottom 38px Viewport floor bar
shape {
    monitor =
    size = 100%, 38
    color = rgb({{vp_bar|bare}})
    rounding = 0
    border_size = 0
    position = 0, 0
    halign = center
    valign = bottom
    zindex = 1
}

shape {
    monitor =
    size = 100%, 1
    color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    rounding = 0
    border_size = 0
    position = 0, 37
    halign = center
    valign = bottom
    zindex = 2
}

label {
    monitor =
    text = <span letter_spacing="1024">VIEWPORT · HYPRLOCK</span>
    color = rgb({{vp_cyan|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = 16, 13
    halign = left
    valign = bottom
    zindex = 3
}

label {
    monitor =
    text = <span letter_spacing="1024">ESC CLEAR  ·  ENTER UNLOCK</span>
    color = rgb({{vp_dim|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = -16, 13
    halign = right
    valign = bottom
    zindex = 3
}

# ---------------------------------------------------------------- centered 0px CAD auth console
shape {
    monitor =
    size = 460, 290
    color = rgb({{vp_bar|bare}})
    rounding = 0
    border_size = 1
    border_color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    position = 0, 0
    halign = center
    valign = center
    zindex = 1
}

# hairline header rule under console title strip
shape {
    monitor =
    size = 458, 1
    color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    rounding = 0
    border_size = 0
    position = 0, 109
    halign = center
    valign = center
    zindex = 2
}

# hairline footer rule inside console
shape {
    monitor =
    size = 458, 1
    color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    rounding = 0
    border_size = 0
    position = 0, -109
    halign = center
    valign = center
    zindex = 2
}

# console title bar (left: λ SYSTEM LOCKED, right: uppercase USER)
label {
    monitor =
    text = <span foreground="##{{vp_text|bare}}"><b>λ</b></span>  <span foreground="##{{vp_cyan|bare}}" letter_spacing="1024"><b>SYSTEM LOCKED</b></span>
    color = rgb({{vp_cyan|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = -132, 127
    halign = center
    valign = center
    zindex = 3
}

label {
    monitor =
    text = cmd[update:0] printf '<span letter_spacing="1024">USER · %s</span>' "$(id -un | tr '[:lower:]' '[:upper:]')"
    color = rgb({{vp_dim|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = 148, 127
    halign = center
    valign = center
    zindex = 3
}

# integer-scaled pixel Terminess clock (3x 16px)
label {
    monitor =
    text = <b>$TIME</b>
    color = rgb({{vp_text|bare}})
    font_family = Terminess Nerd Font
    font_size = 48
    position = 0, 52
    halign = center
    valign = center
    zindex = 3
}

# uppercase cyan date readout
label {
    monitor =
    text = cmd[update:60000] date '+%^a · %-d %^b %Y'
    color = rgb({{vp_cyan|bare}})
    font_family = Terminess Nerd Font
    font_size = 12
    position = 0, 4
    halign = center
    valign = center
    zindex = 3
}

# 2px signal left focus rail beside the square password field (mirrors Walker & mango-keys-ui)
shape {
    monitor =
    size = 2, 38
    color = rgb({{vp_signal|bare}})
    rounding = 0
    border_size = 0
    position = -180, -56
    halign = center
    valign = center
    zindex = 4
}

# square 0px password input: signal focus, warn capslock, crit failure
input-field {
    monitor =
    size = 360, 38
    outline_thickness = 1
    rounding = 0
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    outer_color = rgb({{vp_cyan|mix:vp_bar:0.55|bare}})
    inner_color = rgb({{vp_bar|bare}})
    font_color = rgb({{vp_text|bare}})
    font_family = Terminess Nerd Font
    fade_on_empty = false
    placeholder_text = <span foreground="##{{vp_dim|bare}}" letter_spacing="1024">PASSWORD</span>
    check_color = rgb({{vp_cyan|bare}})
    fail_color = rgb({{vp_crit|bare}})
    fail_text = <span foreground="##{{vp_crit|bare}}" letter_spacing="1024">AUTH FAILED ($ATTEMPTS)</span>
    capslock_color = rgb({{vp_warn|bare}})
    position = 0, -56
    halign = center
    valign = center
    zindex = 3
}

# console footer hint
label {
    monitor =
    text = <span letter_spacing="1024">AUTHENTICATE TO RESUME SESSION</span>
    color = rgb({{vp_dim|bare}})
    font_family = Terminess Nerd Font
    font_size = 11
    position = 0, -127
    halign = center
    valign = center
    zindex = 3
}
