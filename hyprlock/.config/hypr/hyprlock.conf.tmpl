# Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
# The lock screen (hyprlock), after the Quiet Instrument philosophy: the wallpaper blurred and dimmed
# behind one raised panel holding the time, the date and a slim password field. The wallpaper, not
# a screenshot, so nothing on screen shows through the lock. Colours come from the palette.

general {
    hide_cursor = true
    ignore_empty_input = true
}

# 150 ms fades on the desktop's one curve (mango's quadratic ease-out)
animations {
    enabled = true
    bezier = easeOut, 0.5, 1, 0.89, 1
    animation = fadeIn, 1, 1.5, easeOut
    animation = fadeOut, 1, 1.5, easeOut
    animation = inputFieldColors, 1, 1.5, easeOut
    animation = inputFieldDots, 1, 1.5, easeOut
}

# the wallpaper you picked (wallpaper-set's link), blurred and at half brightness; the ground colour
# when there is none
background {
    monitor =
    path = {{home}}/.local/state/wallpaper/current
    color = rgb({{bg_desktop|bare}})
    blur_passes = 3
    blur_size = 8
    brightness = 0.5
    contrast = 1.0
    vibrancy = 0
    noise = 0.012
}

# the raised panel: bg_widget at 85% over the blur, no border, no shadow, the panel radius
shape {
    monitor =
    size = 420, 264
    color = rgba({{bg_widget|bare}}d9)
    rounding = 8
    border_size = 0
    position = 0, 0
    halign = center
    valign = center
}

# primary fact at full brightness, light weight
label {
    monitor =
    text = <span font_weight="300">$TIME</span>
    color = rgb({{fg_bright|bare}})
    font_family = IBM Plex Sans
    font_size = 64
    position = 0, 56
    halign = center
    valign = center
}

# a label whispers: lowercase, muted
label {
    monitor =
    text = cmd[update:60000] date '+%A, %-d %B' | tr '[:upper:]' '[:lower:]'
    color = rgb({{fg_muted|bare}})
    font_family = IBM Plex Sans
    font_size = 13
    position = 0, 4
    halign = center
    valign = center
}

# the field is the one thing that matters here, so its edge is the signal; rose on a wrong password,
# amber while Caps Lock is on
input-field {
    monitor =
    size = 280, 40
    outline_thickness = 1
    rounding = 4
    dots_size = 0.18
    dots_spacing = 0.4
    dots_center = true
    outer_color = rgb({{accent|bare}})
    inner_color = rgb({{bg_surface|bare}})
    font_color = rgb({{fg_bright|bare}})
    font_family = IBM Plex Sans
    fade_on_empty = false
    placeholder_text = <span foreground="##{{fg_muted|bare}}">password</span>
    check_color = rgb({{accent|bare}})
    fail_color = rgb({{error|bare}})
    fail_text = <span foreground="##{{error|bare}}">wrong password</span>
    capslock_color = rgb({{warning|bare}})
    position = 0, -64
    halign = center
    valign = center
}
