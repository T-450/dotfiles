{
  "stateDir": "{{home}}/.local/state/runner-up",
  "github": {
    "repos": [
      "T-450/dotfiles"
    ]
  },
  "pools": [
    {
      "label": "arch-kvm"
    }
  ],
  "machines": [
    {
      "name": "laptop",
      "agent": "{{home}}/.local/bin/runner-up",
      "cores": 8,
      "memoryMB": 15614,
      "roomCores": 4,
      "roomMemoryMB": 8192,
      "places": [
        {
          "id": "laptop-1",
          "provider": "kvm",
          "pools": [
            "arch-kvm"
          ],
          "cores": 4,
          "memoryMB": 6144,
          "image": "{{home}}/.local/share/runner-up/images/Arch-Linux-x86_64-cloudimg-20261101.620452.qcow2",
          "diskGB": 30
        }
      ]
    }
  ],
  "announceCapacity": 50,
  "startTimeoutSeconds": 600,
  "bootTimeoutSeconds": 300,
  "guestCheckSeconds": 30,
  "maxJobSeconds": 21600,
  "tickSeconds": 10,
  "logKeepDays": 30
}
