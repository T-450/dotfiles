# runner-up coordinator: hears of jobs for runs-on: arch-kvm and starts each in a fresh KVM VM.
# Not tied to the graphical session: CI runs while logged out (runner-up/setup.sh enables linger).
[Unit]
Description=runner-up coordinator (GitHub Actions jobs on this machine)
After=network-online.target
# it serves through gh's sign-in: until `gh auth login` ran, skip (not fail)
ConditionPathExists=%h/.config/gh/hosts.yml

[Service]
ExecStart=/usr/bin/runner-up serve --config %h/.config/runner-up/config.json
Restart=on-failure
# stop only the coordinator: running jobs' place runners carry on
KillMode=process

[Install]
WantedBy=default.target
