[Unit]
Description=Idle manager (swayidle): dim 4m, lock 5m, displays off 10m
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# sleep stops way-displays and holds a lid inhibitor, and only the resume handler undoes both; a
# swayidle restart while idle would leave them. wake is idempotent: CONT on a running unit is a
# no-op, and with no inhibitor there is nothing to end.
ExecStartPre=-%h/.local/bin/mango-monitor wake
ExecStart=/usr/bin/swayidle -w \
  timeout 240 '/usr/bin/dimland -a 0.3' \
  resume '/usr/bin/pkill -x dimland' \
  timeout 300 '/bin/sh -c "pidof -q hyprlock || /usr/bin/hyprlock &"' \
  timeout 600 '%h/.local/bin/mango-monitor sleep' \
  resume '%h/.local/bin/mango-monitor wake' \
  before-sleep '/bin/sh -c "pidof -q hyprlock || { /usr/bin/hyprlock --immediate-render --no-fade-in & sleep 1; }"' \
  lock '/bin/sh -c "pidof -q hyprlock || /usr/bin/hyprlock &"'
Restart=on-failure
# hyprlock runs until unlock and has no fork-once-locked flag (swaylock -f had one), and swayidle -w
# waits for each command, so every lock starts in the background. Before sleep it also skips the
# fade and swayidle waits 1s (logind allows up to 5s) so the lock is up before the machine suspends.
# KillMode=process keeps hyprlock alive if swayidle restarts or crashes (else the screen unlocks)
KillMode=process

[Install]
WantedBy=graphical-session.target
