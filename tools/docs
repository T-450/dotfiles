#!/usr/bin/env python3
"""docs: keep docs/ in step with the repo.

usage: tools/docs            regenerate the generated blocks in docs/ (and stub pages for new apps)
       tools/docs --check    exit 1 if a block is stale, an app has no page, or a page no app
       tools/docs --drift    compare `pacman -Qe` with every <app>/packages (this machine only)
       tools/docs --snapshot write docs/reference/installed.md: each declared package's version here

Hand-written text lives outside the generated blocks; a block sits between
`<!-- generated by tools/docs: NAME -->` and `<!-- end generated -->` and is rewritten whole.
Generated blocks depend only on the repo (no versions), so --check means the same on any machine.
"""
import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
DOCS = REPO / "docs"
NOT_APPS = {".git", ".github", "plans", "tests", "tools", "docs"}
BLOCK = re.compile(r"(<!-- generated by tools/docs: (\S+) -->\n).*?(<!-- end generated -->)", re.S)
ROLE = re.compile(r"\{\{\s*([a-z_0-9]+)")
# AUR helper is bootstrapped by install.sh, not declared; debug split packages are noise
DRIFT_IGNORE = re.compile(r"^(yay|yay-bin|paru)$|-debug$")


def apps():
    out = []
    for d in sorted(REPO.iterdir()):
        if d.is_dir() and d.name not in NOT_APPS and not d.name.startswith("."):
            if any((d / f).exists() for f in ("packages", "pkg", "root", "setup.sh", ".stow-local-ignore")):
                out.append(d.name)
    return out


def packages(app):
    """[(name, comment)] from <app>/packages."""
    f = REPO / app / "packages"
    res = []
    if f.exists():
        for line in f.read_text().splitlines():
            body, _, comment = line.partition("#")
            for name in body.split():
                res.append((name, comment.strip()))
    return res


def first_comment(path):
    """The script's header: comment lines after the shebang, up to the first non-comment."""
    lines = []
    for line in path.read_text().splitlines()[1:]:
        if not line.startswith("#"):
            break
        lines.append(line.lstrip("# ").rstrip())
    text = " ".join(lines)
    text = re.sub(r"\s*\(run by `theme set`\)", "", text)
    return re.sub(rf"^{re.escape(path.parent.name)}/{re.escape(path.name)}:\s*", "", text)


def home_files(app):
    """Files stow links into $HOME, as ~/ paths (templates by their rendered name)."""
    root = REPO / app
    if not (root / ".stow-local-ignore").exists():
        return []
    out = set()
    for dp, dns, fns in os.walk(root):
        rel = Path(dp).relative_to(root)
        if rel == Path("."):
            dns[:] = [d for d in dns if d.startswith(".")]
            fns = [f for f in fns if f.startswith(".") and f not in (".gitignore", ".stow-local-ignore")]
        for f in fns:
            name = f[:-5] if f.endswith(".tmpl") else f
            out.add("~/" + str(rel / name) if str(rel) != "." else "~/" + name)
    return sorted(out)


def templates(app):
    res = []
    for p in sorted((REPO / app).rglob("*.tmpl")):
        roles = sorted(set(ROLE.findall(p.read_text())))
        res.append((p.relative_to(REPO), roles))
    return res


def system_files(app):
    """Files install.sh --system copies to /, by their installed path (templates by their output)."""
    root = REPO / app / "root"
    if not root.exists():
        return []
    # only what the repo defines: generated files (render.sh output, gitignored) exist only after
    # `theme` ran, and the block must read the same on a fresh clone
    ignored = {l.strip() for l in (REPO / app / ".gitignore").read_text().splitlines()
               if l.strip() and not l.startswith("#")} if (REPO / app / ".gitignore").exists() else set()
    out = set()
    for p in root.rglob("*"):
        if p.is_file() or p.is_symlink():
            rel = "/" + str(p.relative_to(root))
            if rel.endswith(".tmpl"):
                out.add(rel[:-5])
            elif "/root" + rel not in ignored:
                out.add(rel)
    return sorted(out)


def pkgbuilds(app):
    return sorted(p.parent.name for p in (REPO / app).glob("pkg/*/PKGBUILD"))


def units(app):
    d = REPO / app / ".config/systemd/user"
    return sorted(p.name for p in d.glob("*.service")) if d.exists() else []


def app_block(app):
    out = []
    pk = packages(app)
    if pk:
        out.append("**Packages** (`" + app + "/packages`): " + ", ".join(
            f"`{n}`" + (f" ({c})" if c else "") for n, c in pk))
    pb = pkgbuilds(app)
    if pb:
        out.append("**Built here** (`" + app + "/pkg/*/PKGBUILD`, makepkg): " + ", ".join(f"`{n}`" for n in pb))
    hf = home_files(app)
    if hf:
        out.append("**Linked into your home** (stow, `install.sh --link`):\n\n" + "\n".join(f"- `{f}`" for f in hf))
    tm = templates(app)
    if tm:
        out.append("**Rendered from the palette** (`theme`):\n\n" + "\n".join(
            f"- `{t}` → `{t.with_suffix('')}`" + (f": {', '.join(f'`{r}`' for r in roles)}" if roles else "")
            for t, roles in tm))
    un = units(app)
    if un:
        out.append("**User units** (enabled by `install.sh --units`): " + ", ".join(f"`{u}`" for u in un))
    sf = system_files(app)
    if sf:
        out.append("**System files** (`" + app + "/root/`, copied by `install.sh --system`):\n\n"
                   + "\n".join(f"- `{f}`" for f in sf))
    for script in ("setup.sh", "render.sh", "reload.sh"):
        p = REPO / app / script
        if p.exists():
            when = {"setup.sh": "run by `install.sh --setup`", "render.sh": "run by `theme` after rendering",
                    "reload.sh": "run by `theme set`"}[script]
            out.append(f"**`{script}`** ({when}): {first_comment(p)}")
    return "\n\n".join(out) + "\n"


def index_block():
    rows = ["| app | what | packages |", "|---|---|---|"]
    for a in apps():
        page = DOCS / "apps" / f"{a}.md"
        what = ""
        if page.exists():
            m = re.search(r"^# .*\n\n(.+)$", page.read_text(), re.M)
            what = m.group(1).split(". ")[0].rstrip(".") if m else ""
        pk = ", ".join(n for n, _ in packages(a)) or "—"
        rows.append(f"| [{a}](apps/{a}.md) | {what} | {pk} |")
    return "\n".join(rows) + "\n"


def roles_block():
    used = {}
    for a in apps():
        for _, roles in templates(a):
            for r in roles:
                used.setdefault(r, set()).add(a)
    rows = ["| role / word | used by |", "|---|---|"]
    for r in sorted(used):
        rows.append(f"| `{r}` | " + ", ".join(sorted(used[r])) + " |")
    return "\n".join(rows) + "\n"


def blocks_for(path):
    rel = path.relative_to(DOCS)
    if rel.parts[0] == "apps":
        return {"reference": lambda: app_block(rel.stem)}
    return {"apps": index_block, "roles": roles_block}


def stub(app):
    return (f"# {app}\n\n(what it is, one sentence.)\n\n## Reference\n\n"
            f"<!-- generated by tools/docs: reference -->\n<!-- end generated -->\n")


def render(path):
    text = path.read_text()
    gens = blocks_for(path)

    def sub(m):
        fn = gens.get(m.group(2))
        if fn is None:
            raise SystemExit(f"{path.relative_to(REPO)}: unknown generated block {m.group(2)!r}")
        return m.group(1) + fn() + m.group(3)

    return BLOCK.sub(sub, text)


def main(argv):
    check = "--check" in argv
    if "--drift" in argv:
        return drift()
    if "--snapshot" in argv:
        return snapshot()
    problems = 0
    pages = {p.stem for p in (DOCS / "apps").glob("*.md")}
    for a in apps():
        if a not in pages:
            if check:
                print(f"docs/apps/{a}.md: missing (run tools/docs to stub it, then describe the app)")
                problems += 1
            else:
                (DOCS / "apps").mkdir(parents=True, exist_ok=True)
                (DOCS / "apps" / f"{a}.md").write_text(stub(a))
                print(f"stub    docs/apps/{a}.md")
    for p in sorted(pages - set(apps())):
        print(f"docs/apps/{p}.md: no app folder {p}/ (remove the page)")
        problems += 1
    for path in sorted(DOCS.rglob("*.md")):
        old = path.read_text()
        new = render(path)
        if new != old:
            if check:
                print(f"{path.relative_to(REPO)}: generated block is stale (run tools/docs)")
                problems += 1
            else:
                path.write_text(new)
                print(f"update  {path.relative_to(REPO)}")
    if check:
        print("ok: docs/ matches the repo" if not problems else f"{problems} problem(s)")
    return 1 if problems else 0


def declared():
    names = {n for a in apps() for n, _ in packages(a)}
    for a in apps():  # local PKGBUILDs count as declared too
        names.update(pkgbuilds(a))
    return names


def drift():
    explicit = set(subprocess.run(["pacman", "-Qeq"], capture_output=True, text=True, check=True).stdout.split())
    installed = set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, check=True).stdout.split())
    extra = sorted(p for p in explicit - declared() if not DRIFT_IGNORE.search(p))
    missing = sorted(declared() - installed)
    for p in extra:
        print(f"undeclared  {p}  (installed explicitly; add it to an <app>/packages, or remove it)")
    for p in missing:
        print(f"missing     {p}  (declared, not installed; run install.sh --packages)")
    print("ok: installed packages match the declared ones" if not (extra or missing) else
          f"{len(extra)} undeclared, {len(missing)} missing")
    return 1 if extra or missing else 0


def snapshot():
    q = subprocess.run(["pacman", "-Q", *sorted(declared())], capture_output=True, text=True)
    versions = dict(line.split(" ", 1) for line in q.stdout.splitlines())
    lines = ["# Installed versions", "",
             "Snapshot of each declared package's version on the reference machine (ThinkPad T14),",
             "written by `tools/docs --snapshot`. For reference only; install.sh installs the current ones.", "",
             "| app | package | version |", "|---|---|---|"]
    for a in apps():
        for n, _ in packages(a):
            lines.append(f"| {a} | `{n}` | {versions.get(n, 'not installed')} |")
    out = DOCS / "reference" / "installed.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(lines) + "\n")
    print(f"wrote {out.relative_to(REPO)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
