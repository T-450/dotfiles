# Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
# Included at the top of mako/config. mako gives each file its own section
# state, so these [urgency=*] sections don't leak into the main config.
# Material 3 roles: the card is surface_container_high with the body in on_surface_variant and the
# title in on_surface (title medium: 12pt, 500); low urgency dims the title to on_surface_variant;
# a critical notification is an error_container card.
background-color={{m3_surface_container_high}}
text-color={{m3_on_surface_variant}}
border-color={{m3_outline_variant}}
progress-color=over {{m3_primary_container}}
format=<span size="12pt" weight="500" foreground="{{m3_on_surface}}">%s</span>\n%b

[urgency=low]
format=<span size="12pt" weight="500" foreground="{{m3_on_surface_variant}}">%s</span>\n%b

[urgency=critical]
background-color={{m3_error_container}}
text-color={{m3_on_error_container}}
format=<span size="12pt" weight="500" foreground="{{m3_on_error_container}}">%s</span>\n%b

[app-name=mango-whichkey]
background-color={{bg_surface|hex:d9}}
border-color={{border_inactive}}
text-color={{fg_text}}
