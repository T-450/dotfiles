# Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
# Included at the top of mako/config. mako gives each file its own section
# state, so these [urgency=*] sections don't leak into the main config.
# The accent marks focus only, so a notification is common UI: a bright summary on a muted cool
# (ansi6) border, a comment when low (on the inactive border), the error color when critical.
background-color={{bg_widget|hex:d9}}
text-color={{fg_text}}
border-color={{ansi6|mix:bg_widget:0.5}}
progress-color=over {{selection_bg}}
format=<b><span foreground="{{fg_bright|legible:bg_widget}}">%s</span></b>\n%b

[urgency=low]
text-color={{fg_secondary}}
border-color={{border_inactive}}
format=<b><span foreground="{{syn_comment|legible:bg_widget}}">%s</span></b>\n%b

[urgency=critical]
border-color={{error}}
format=<b><span foreground="{{error|legible:bg_widget}}">%s</span></b>\n%b

[app-name=mango-whichkey]
background-color={{bg_surface|hex:d9}}
border-color={{border_inactive}}
text-color={{fg_text}}
