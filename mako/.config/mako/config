# mako. Colors come from the active palette (colors, rendered from colors.tmpl).
# A Material 3 card (docs/designs/material-shapeshifter/SPEC-bar.md): surface_container_high,
# corner large (16px), 16px padding, no border; the title in title medium and the body in body
# medium (colors.tmpl's format; Pango points at 96 dpi: 10.5pt is 14px). It opens top right, 8px
# under the bar (mako's margin counts from the bar's exclusive zone) and 8px from the edge, the
# bar's own margin, so the card's right edge lines up with the power piece.
include=~/.config/mako/colors
font=IBM Plex Sans 10.5
border-size=0
border-radius=16
padding=16
margin=8
width=360
default-timeout=5000
anchor=top-right
layer=overlay
max-icon-size=48

[urgency=critical]
default-timeout=0

[mode=do-not-disturb]
invisible=1

# the which-key popup (mango-whichkey): the open key mode's keys, bottom center, until the mode ends.
# mango-keys --pango draws the body; it never takes focus, so the mode keeps every key.
[app-name=mango-whichkey]
anchor=bottom-center
width=460
height=640
margin=12,12,24,12
padding=14,20
font=JetBrainsMono Nerd Font 11
markup=1
format=%b
default-timeout=0
history=0
border-size=1
border-radius=8

[mode=do-not-disturb app-name=mango-whichkey]
invisible=0
