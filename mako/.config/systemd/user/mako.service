[Unit]
Description=Notifications (mako)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/bin/mako
ExecReload=/usr/bin/makoctl reload
Restart=on-failure
# a hung mako ignores SIGTERM and held a logout for the default 90s: give up after 10s and
# abort it, so systemd-coredump keeps the stack of the hang (coredumpctl info mako)
TimeoutStopSec=10
TimeoutStopFailureMode=abort

[Install]
WantedBy=graphical-session.target
