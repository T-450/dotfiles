# mako. Colors come from the active palette (theme/templates/mako -> colors)
include=~/.config/mako/colors
font=Inter 11
border-size=1
border-radius=4
padding=12,14
margin=12
width=320
default-timeout=5000
anchor=top-right
layer=overlay
max-icon-size=48

[urgency=critical]
default-timeout=0

[mode=do-not-disturb]
invisible=1
