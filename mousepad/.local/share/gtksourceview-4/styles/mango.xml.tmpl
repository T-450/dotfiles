<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
     Editor surfaces from the palette roles; syntax from the terminal's ANSI colors, made legible
     on the editor background, so code reads like it does in helix and the shell. -->
<style-scheme id="mango" name="Mango" version="1.0">
  <author>dotfiles theme</author>
  <description>Editor colors from the active palette ({{name}})</description>

  <style name="text"                  foreground="{{fg_editor}}" background="{{bg_desktop}}"/>
  <style name="selection"             foreground="{{selection_fg}}" background="{{selection_bg}}"/>
  <style name="selection-unfocused"   foreground="{{fg_text}}" background="{{bg_hover}}"/>
  <style name="cursor"                foreground="{{term_cursor}}"/>
  <style name="secondary-cursor"      foreground="{{fg_muted}}"/>
  <style name="current-line"          background="{{bg_surface}}"/>
  <style name="line-numbers"          foreground="{{fg_muted}}" background="{{bg_desktop}}"/>
  <style name="current-line-number"   foreground="{{fg_bright}}" background="{{bg_surface}}"/>
  <style name="right-margin"          foreground="{{border_inactive}}" background="{{bg_surface}}"/>
  <style name="background-pattern"    background="{{bg_surface}}"/>
  <style name="draw-spaces"           foreground="{{fg_disabled}}"/>
  <style name="bracket-match"         foreground="{{fg_bright}}" background="{{bg_hover}}" bold="true"/>
  <style name="bracket-mismatch"      foreground="{{error}}" underline="true"/>
  <style name="search-match"          foreground="{{badge|ink}}" background="{{badge}}"/>
  <style name="map-overlay"           background="{{bg_hover}}"/>

  <style name="def:comment"           foreground="{{fg_muted|legible:bg_desktop}}" italic="true"/>
  <style name="def:shebang"           foreground="{{fg_muted|legible:bg_desktop}}" bold="true"/>
  <style name="def:doc-comment-element" foreground="{{fg_secondary|legible:bg_desktop}}" italic="true"/>
  <style name="def:keyword"           foreground="{{ansi13|legible:bg_desktop}}"/>
  <style name="def:statement"         foreground="{{ansi13|legible:bg_desktop}}"/>
  <style name="def:type"              foreground="{{ansi11|legible:bg_desktop}}"/>
  <style name="def:function"          foreground="{{ansi12|legible:bg_desktop}}"/>
  <style name="def:builtin"           foreground="{{ansi14|legible:bg_desktop}}"/>
  <style name="def:string"            foreground="{{ansi10|legible:bg_desktop}}"/>
  <style name="def:special-char"      foreground="{{ansi14|legible:bg_desktop}}"/>
  <style name="def:character"         foreground="{{ansi10|legible:bg_desktop}}"/>
  <style name="def:constant"          foreground="{{ansi9|legible:bg_desktop}}"/>
  <style name="def:special-constant"  foreground="{{ansi9|legible:bg_desktop}}"/>
  <style name="def:boolean"           foreground="{{ansi9|legible:bg_desktop}}"/>
  <style name="def:number"            foreground="{{ansi9|legible:bg_desktop}}"/>
  <style name="def:floating-point"    foreground="{{ansi9|legible:bg_desktop}}"/>
  <style name="def:preprocessor"      foreground="{{ansi14|legible:bg_desktop}}"/>
  <style name="def:identifier"        foreground="{{fg_editor}}"/>
  <style name="def:net-address"       foreground="{{link|legible:bg_desktop}}" underline="true"/>
  <style name="def:error"             foreground="{{error|legible:bg_desktop}}" underline="error"/>
  <style name="def:warning"           foreground="{{warning|legible:bg_desktop}}"/>
  <style name="def:note"              foreground="{{warning|ink}}" background="{{warning}}" bold="true"/>
  <style name="def:insertion"         foreground="{{ansi10|legible:bg_desktop}}"/>
  <style name="def:deletion"          foreground="{{ansi9|legible:bg_desktop}}" strikethrough="true"/>

  <style name="def:heading"           foreground="{{ansi12|legible:bg_desktop}}" bold="true"/>
  <style name="def:emphasis"          italic="true"/>
  <style name="def:strong-emphasis"   bold="true"/>
  <style name="def:inline-code"       foreground="{{ansi10|legible:bg_desktop}}"/>
  <style name="def:preformatted-section" foreground="{{ansi10|legible:bg_desktop}}"/>
  <style name="def:link-text"         foreground="{{link|legible:bg_desktop}}"/>
  <style name="def:link-destination"  foreground="{{fg_muted|legible:bg_desktop}}" underline="true"/>
  <style name="def:link-symbol"       foreground="{{fg_muted|legible:bg_desktop}}"/>
  <style name="def:list-marker"       foreground="{{ansi13|legible:bg_desktop}}" bold="true"/>
  <style name="def:thematic-break"    foreground="{{fg_muted|legible:bg_desktop}}"/>

  <style name="diff:added-line"       foreground="{{ansi10|legible:bg_desktop}}"/>
  <style name="diff:removed-line"     foreground="{{ansi9|legible:bg_desktop}}"/>
  <style name="diff:changed-line"     foreground="{{ansi11|legible:bg_desktop}}"/>
  <style name="diff:location"         foreground="{{ansi14|legible:bg_desktop}}"/>
  <style name="diff:diff-file"        foreground="{{ansi12|legible:bg_desktop}}" bold="true"/>
  <style name="diff:special-case"     foreground="{{fg_muted|legible:bg_desktop}}"/>
</style-scheme>
