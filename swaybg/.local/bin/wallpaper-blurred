#!/usr/bin/env bash
# wallpaper-blurred: print the path of a softly blurred copy of the current wallpaper
# (~/.local/state/wallpaper/current), the image swaybg.service shows: the desktop, and so mango's
# overview, sit on a blur instead of the sharp picture. The copy is rendered once per image (its
# path, size and time in the name) into ~/.cache/wallpaper/, replacing the previous one; it blurs
# at a quarter of 4K and scales back up, about half a second. If ImageMagick fails, the original's
# path is printed, so the desktop still shows the picture.
set -euo pipefail
src=$(realpath -- "$HOME/.local/state/wallpaper/current")
cache=${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper
key=$(stat -c '%n %s %Y' -- "$src" | md5sum)
out=$cache/blurred-${key%% *}.png
if [[ ! -f $out ]]; then
	mkdir -p "$cache"
	if ! magick "$src" -resize '960x540^' -blur 0x5 -resize '3840x2160^' -depth 8 "$out.part" 2>/dev/null; then
		rm -f -- "$out.part"
		printf '%s\n' "$src"
		exit 0
	fi
	find "$cache" -maxdepth 1 -name 'blurred-*.png' -delete
	mv -- "$out.part" "$out"
fi
printf '%s\n' "$out"
