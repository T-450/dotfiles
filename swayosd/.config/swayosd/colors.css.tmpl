/* Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit. */
@define-color osd_bg     {{bg_widget}};
@define-color osd_border {{border_inactive|mix:fg_muted:0.2}};
@define-color osd_fg     {{fg_text}};
@define-color osd_trough {{bg_hover|mix:fg_muted:0.15}};
/* the level in the cool ansi6: common UI, so it never competes with the accent */
@define-color osd_fill   {{ansi6|legible:bg_widget}};
