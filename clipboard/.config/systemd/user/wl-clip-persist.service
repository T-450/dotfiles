[Unit]
Description=Keep clipboard after source exits (wl-clip-persist)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/wl-clip-persist --clipboard regular --reconnect-tries 0
Restart=on-failure

[Install]
WantedBy=graphical-session.target
