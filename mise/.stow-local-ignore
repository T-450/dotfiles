# stow ignores these: only dot-entries at the package root (.config, .local, .zshrc …) belong in
# $HOME; everything else there is package metadata (packages, setup.sh, reload.sh, etc/, …).
# A pattern with / matches the path from the package root; one without, the whole file name.
^/[^.].*
^/\.gitignore
.+\.tmpl
# dependency sidecars: mise reads them next to the lockfile's real path (the repo) and refuses
# to read them through symlinks, so they stay out of $HOME
^/\.config/mise/locks
