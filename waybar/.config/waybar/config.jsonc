// waybar, "Viewport": two bars in one process (style.css), after SGI CAD workstations. The first
// is the 30px status line at the top, with a ruler on its bottom edge. Left: the λ launcher, tags
// 1-4 and tag 0 (the special tag), a rule, the layout glyph, the key mode and window state chips,
// then the windows in view. Center: day, time, date. Right: recording, then the status chips
// (network, volume, cpu, memory, temperature, disk, battery) as labels and values with a
// registration cross between them, a rule, night light, wallpaper, bluetooth, the tray, the bell,
// and power in the corner. The second is the media bar at the bottom (below).
// Labels are Pango spans (12px Terminess capitals: a label, not a fact; the value is 14px bold).
// A zero-width space is a visible-but-empty label: waybar hides a module whose format is empty.
[
    {
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 0,
        "reload_style_on_change": true,

        "modules-left": ["custom/start", "mango/workspaces", "custom/special", "custom/divider#left", "custom/layout", "mango/keymode", "custom/winstate", "custom/windows",
            "custom/win#1", "custom/win#2", "custom/win#3", "custom/win#4", "custom/win#5", "custom/win#6"],
        "modules-center": ["group/datetime"],
        "modules-right": [
            "custom/record", "network", "pulseaudio", "cpu", "memory",
            "custom/temperature", "disk", "battery", "custom/divider#tray", "custom/nightlight",
            "custom/wallpaper", "bluetooth", "tray", "custom/notifications", "custom/power"
        ],

        // the λ is type; wallpaper and power are icons: the label is a zero-width space, style.css
        // draws the SVG
        "custom/start": {
            "format": "λ",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>LAUNCHER</span>  <span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='80%'>SUPER D</span>",
            "on-click": "rofi -show drun"
        },
        "custom/wallpaper": {
            "format": "\u200b",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>WALLPAPER</span>  Open picker  <span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='80%'>SUPER W</span>",
            "on-click": "waypaper"
        },
        "custom/power": {
            "format": "\u200b",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>POWER</span>  Session menu  <span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='80%'>SUPER ESC  P</span>",
            "on-click": "wlogout -b 6 --protocol layer-shell"
        },

        // tags 1-4 (super+1..4); style.css gives .empty, occupied, .active and .urgent their own looks
        "mango/workspaces": {
            "format": "{name}",
            "tag-filter": [1, 2, 3, 4],
            "on-click": "activate",
            "on-click-right": "toggle"
        },

        // the drawable glyph (layouts/<symbol>-symbolic.svg); waybar-layout prints the symbol as the
        // class and the tooltip (mango/layout has no tooltip support)
        "custom/layout": {
            "exec": "~/.local/bin/waybar-layout",
            "return-type": "json",
            "restart-interval": 1,
            "format": "{}",
            "on-click": "mmsg dispatch switch_layout"
        },

        // windows pinned, kept on top or minimized (states nothing else shows); hidden when none is.
        // mango sends no event for them, so mango-state signals it (11); it also rechecks every 10s
        "custom/winstate": {
            "exec": "~/.local/bin/waybar-winstate",
            "return-type": "json",
            "interval": 10,
            "signal": 11,
            "on-click": "~/.local/bin/mango-state --clear"
        },

        // the open key mode (super+esc, super+n or super+m)
        "mango/keymode": {
            "format": "{mode}",
            // waybar names mango's normal mode "default" and shows it; an empty format hides the chip
            "format-default": ""
        },

        // the windows in view by title, one chip each (mango has no wlr-foreign-toplevel-management for
        // waybar's taskbar). custom/windows is the hidden feed: it follows mango's window stream and
        // signals the six slots (12); a click focuses that window, the wheel moves focus along
        "custom/windows": {
            "exec": "~/.local/bin/waybar-windows feed",
            "restart-interval": 1,
            "tooltip": false
        },
        "custom/win#1": {
            "exec": "~/.local/bin/waybar-windows slot 1",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 1",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#2": {
            "exec": "~/.local/bin/waybar-windows slot 2",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 2",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#3": {
            "exec": "~/.local/bin/waybar-windows slot 3",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 3",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#4": {
            "exec": "~/.local/bin/waybar-windows slot 4",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 4",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#5": {
            "exec": "~/.local/bin/waybar-windows slot 5",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 5",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#6": {
            "exec": "~/.local/bin/waybar-windows slot 6",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 6",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },

        // tag 0, mango's special tag (super+0 shows it over the view, super+shift+0 sends a window);
        // its state comes with the window list's signal
        "custom/special": {
            "exec": "~/.local/bin/waybar-windows special",
            "return-type": "json",
            "signal": 12,
            "format": "0",
            "tooltip": false,
            "on-click": "mmsg dispatch toggle_special_tag"
        },

        // day, time (calendar tooltip) and date; style.css styles the group's box as #datetime
        "group/datetime": {
            "orientation": "horizontal",
            "modules": ["custom/day", "clock#time", "custom/date"]
        },
        // the day and date in capitals, labels around the time (waybar's clock can't upper-case)
        "custom/day": { "exec": "date '+%^a'", "interval": 60, "tooltip": false },
        "clock#time": {
            "format": "{:%H:%M}",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>CALENDAR</span>  {:%A, %e %B %Y · W%V}\n\n<tt>{calendar}</tt>"
        },
        // waybar's clock zero-pads the day; a custom module keeps "12 NOV"
        "custom/date": { "exec": "date '+%-d %^b'", "interval": 60 },

        "network": {
            "format-wifi": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>NET</span> {essid}",
            "format-ethernet": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>NET</span> {ifname}",
            "format-disconnected": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>OFFLINE</span>",
            "format-alt": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>DN</span> {bandwidthDownBytes} <span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>UP</span> {bandwidthUpBytes}",
            // a long SSID ends in an ellipsis before it reaches the centered clock (16 characters of
            // SSID after the 4 of "NET ")
            "max-length": 20,
            "align": 1,
            "tooltip-format-wifi": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>WI-FI</span>  {essid} · {signalStrength}%\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click toggles speeds</span>",
            "tooltip-format-ethernet": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>ETHERNET</span>  {ifname} · connected\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click toggles speeds</span>",
            "tooltip-format-disconnected": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>NETWORK</span>  Offline\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click toggles speeds</span>"
        },
        "pulseaudio": {
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>VOL</span> {volume}",
            "format-muted": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>MUTE</span>",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>VOLUME</span>  {volume}%\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Scroll ±5 · Click, right- or middle-click mutes</span>",
            "align": 1,
            "on-click": "pamixer -t",
            "on-click-right": "pamixer -t",
            "on-click-middle": "pamixer -t",
            "on-scroll-up": "pamixer -i 5",
            "on-scroll-down": "pamixer -d 5"
        },
        "cpu": {
            "interval": 5,
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>CPU</span> {usage}",
            // full load is work, not a failure: a warning, no critical tier
            "states": { "warning": 85 },
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>CPU</span>  {usage}%",
            "align": 1
        },
        "memory": {
            "interval": 5,
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>MEM</span> {percentage}",
            "states": { "warning": 80, "critical": 90 },
            "align": 1,
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>MEMORY</span>  {percentage}%"
        },
        // CPU package temperature. Waybar's temperature module ignores "states", so waybar-temperature
        // prints the label and its own classes: "high" from 80 C, "critical" from 95 C
        "custom/temperature": {
            "exec": "~/.local/bin/waybar-temperature",
            "return-type": "json",
            "interval": 5,
            "align": 1,
            "format": "{}"
        },
        "disk": {
            "interval": 30,
            "paths": ["/"],
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>DSK</span> {percentage_used}",
            "states": { "warning": 80, "critical": 90 },
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>DISK</span>  {percentage_used}%",
            "align": 1
        },
        "battery": {
            // charge counts down: a warning at 20% and below, critical at 10% (style.css shows them on
            // battery only)
            "states": { "warning": 20, "critical": 10 },
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>BAT</span> {capacity}",
            "format-charging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>CHG</span> {capacity}",
            "format-plugged": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>AC</span> {capacity}",
            "format-full": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>AC</span> {capacity}",
            "format-not-charging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768'>AC</span> {capacity}",
            "tooltip-format-discharging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BATTERY</span>  {capacity}% · on battery\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click opens the session menu</span>",
            "tooltip-format-charging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BATTERY</span>  {capacity}% · charging\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click opens the session menu</span>",
            "tooltip-format-plugged": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BATTERY</span>  {capacity}% · plugged in\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click opens the session menu</span>",
            "tooltip-format-full": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BATTERY</span>  {capacity}% · full\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click opens the session menu</span>",
            "align": 1,
            "on-click": "wlogout -b 6 --protocol layer-shell"
        },

        // wlsunset (wlsunset/.local/bin/nightlight): automatic rests, warm is held, off is faded
        "custom/nightlight": {
            "exec": "~/.local/bin/nightlight status",
            "return-type": "json",
            "interval": 60,
            "signal": 9,
            "format": "\u200b",
            "on-click": "~/.local/bin/nightlight toggle",
            "on-click-right": "~/.local/bin/nightlight menu"
        },

        // gpurecord prints a line only while recording; the zero-width label keeps it hidden otherwise
        "custom/record": {
            "exec": "~/.local/bin/gpurecord status",
            "signal": 8,
            "format": "\u200b",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>RECORDING</span>  Click stops",
            "on-click": "~/.local/bin/gpurecord"
        },

        "custom/notifications": {
            "exec": "~/.local/bin/waybar-notifications",
            "return-type": "json",
            "interval": 2,
            "signal": 10,
            "format": "{}",
            "on-click": "makoctl restore; pkill -RTMIN+10 waybar",
            "on-click-middle": "makoctl dismiss --all; pkill -RTMIN+10 waybar",
            "on-click-right": "makoctl mode -t do-not-disturb; pkill -RTMIN+10 waybar"
        },

        "bluetooth": {
            "format": "\u200b",
            "format-connected": "{num_connections}",
            "format-off": "\u200b",
            "format-disabled": "\u200b",
            "format-no-controller": "",
            "tooltip-format-on": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BLUETOOTH</span>  On · none connected",
            "tooltip-format-connected": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BLUETOOTH</span>  {num_connections} connected",
            "tooltip-format-off": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BLUETOOTH</span>  Off",
            "tooltip-format-disabled": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>BLUETOOTH</span>  Off",
            "on-click": "blueman-manager"
        },

        "tray": { "icon-size": 14, "spacing": 0 },

        // 1x12 rules (style.css paints them); zero-width labels keep the custom module alive
        "custom/divider#left": { "format": "\u200b" },
        "custom/divider#tray": { "format": "\u200b" }
    },
    // the media bar (style.css "the media bar"): the floor of the viewport. The XYZ axis triad,
    // the left channel's ribbon, the player (prev, play, next, title, artist, time), the right
    // channel's ribbon, and the CLUT key in the corner. The player hides while no player runs;
    // the ribbons (waybar-ribbons, pkg/waybar-ribbons) lie flat in silence and fill the bar up
    // to the player ("expand"). Every output gets one, like the status bar.
    {
        "layer": "top",
        "position": "bottom",
        "height": 30,
        "spacing": 0,
        "expand-left": true,
        "expand-right": true,

        "modules-left": ["custom/triad", "cffi/ribbons#left"],
        "modules-center": ["mpris#prev", "mpris#play", "mpris#next", "mpris#title", "mpris#artist", "mpris#time"],
        "modules-right": ["cffi/ribbons#right", "custom/clut"],

        // the axis triad and the CLUT key are drawn by style.css: zero-width labels, no tooltip
        "custom/triad": { "format": "\u200b", "tooltip": false },
        "custom/clut": { "format": "\u200b", "tooltip": false },

        "cffi/ribbons#left": { "module_path": "/usr/lib/waybar-ribbons/ribbons.so", "channel": "left", "expand": true },
        "cffi/ribbons#right": { "module_path": "/usr/lib/waybar-ribbons/ribbons.so", "channel": "right", "expand": true },

        // the player: waybar's mpris module once per part, so each part has its own color.
        // Buttons are zero-width labels with an SVG (style.css; play shows pause while playing);
        // a click on any part but prev and next plays or pauses
        "mpris#prev": { "format": "\u200b", "tooltip": false, "on-click": "playerctl previous" },
        "mpris#play": { "format": "\u200b", "tooltip": false },
        "mpris#next": { "format": "\u200b", "tooltip": false, "on-click": "playerctl next" },
        "mpris#title": {
            "format": "{title}",
            "title-len": 20,
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='768' fgalpha='60%'>PLAYING</span>  {title} · {artist} · {player}\n<span font_desc='Terminess Nerd Font 12px' fgalpha='60%'>Click plays or pauses · Middle-click previous · Right-click next</span>"
        },
        "mpris#artist": { "format": "{artist}", "artist-len": 14, "tooltip": false },
        "mpris#time": { "format": "{position}/{length}", "interval": 1, "tooltip": false }
    }
]
