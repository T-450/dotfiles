// waybar, "taskbar": one flat surface with 24px controls 4px apart (style.css). Left: the launcher,
// the nine tags and the layout button, then the focused window. Center: one clock pill. Right:
// recording, brightness, night light, power, wallpaper, bluetooth, a divider, the live chips
// (network, volume, cpu, memory, temperature, disk, battery), then the tray and the notification bell.
// A zero-width space is a visible-but-empty label: waybar hides a module whose format is empty.
{
    "layer": "top",
    "position": "bottom",
    "height": 38,
    "margin-left": 7,
    "margin-right": 7,
    "margin-bottom": 7,
    "spacing": 4,
    "reload_style_on_change": true,

    // levels.json adds the "states" object (one class per integer) to the modules whose 2px level
    // bar style.css draws; waybar deep-merges included objects, so each module keeps the rest of
    // its settings here. The states live apart because they are 7 x 101 repetitive lines.
    "include": ["~/.config/waybar/levels.json"],

    "modules-left": ["custom/start", "mango/workspaces", "custom/divider#left", "custom/layout", "mango/window"],
    "modules-center": ["group/datetime"],
    "modules-right": [
        "custom/record", "backlight", "custom/nightlight", "custom/power", "custom/wallpaper",
        "bluetooth", "custom/divider#right", "network", "pulseaudio", "cpu", "memory",
        "custom/temperature", "disk", "battery", "tray", "custom/notifications"
    ],

    // icon-only 24x24 buttons: the label is a zero-width space, style.css draws the SVG
    "custom/start": {
        "format": "\u200b",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>LAUNCHER</span>  <span font_desc='Inter Medium 11px' fgalpha='82%'>Super D</span>",
        "on-click": "rofi -show drun"
    },
    "custom/wallpaper": {
        "format": "\u200b",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>WALLPAPER</span>  Open picker  <span font_desc='Inter Medium 11px' fgalpha='82%'>Super W</span>",
        "on-click": "waypaper"
    },
    "custom/power": {
        "format": "\u200b",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>POWER</span>  Session menu  <span font_desc='Inter Medium 11px' fgalpha='82%'>Super Shift Esc</span>\n<span font_desc='Inter 11px' fgalpha='66%'>Right-click toggles do not disturb</span>",
        "on-click": "wlogout -b 6 --protocol layer-shell",
        "on-click-right": "makoctl mode -t do-not-disturb"
    },

    // all nine tags; style.css gives .empty, occupied, .active and .urgent their own marks
    "mango/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-click-right": "toggle"
    },

    // the drawable glyph (layouts/<symbol>-symbolic.svg) and a chevron; waybar-layout prints the
    // symbol as the class and the tooltip (mango/layout has no tooltip support)
    "custom/layout": {
        "exec": "~/.local/bin/waybar-layout",
        "return-type": "json",
        "restart-interval": 1,
        "format": "{}",
        "on-click": "mmsg dispatch switch_layout"
    },

    "mango/window": {
        "format": "{title}",
        "max-length": 64
    },

    // one pill: day, time (calendar tooltip) and date; style.css styles the group's box as #datetime
    "group/datetime": {
        "orientation": "horizontal",
        "modules": ["clock#day", "clock#time", "custom/date"]
    },
    "clock#day": { "format": "{:%a}", "tooltip": false },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>CALENDAR</span>  {:%A, %e %B %Y · W%V}\n\n<tt>{calendar}</tt>"
    },
    // waybar's clock zero-pads the day; a custom module keeps "12 Nov" (the design's form)
    "custom/date": { "exec": "date '+%-d %b'", "interval": 60 },

    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "{ifname}",
        "format-disconnected": "offline",
        "format-alt": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
        // a long SSID ends in an ellipsis before it reaches the centered clock
        "max-length": 16,
        "align": 1,
        "tooltip-format-wifi": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>WI-FI</span>  {essid} · {signalStrength}%\n<span font_desc='Inter 11px' fgalpha='66%'>Click toggles speeds</span>",
        "tooltip-format-ethernet": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>ETHERNET</span>  {ifname} · connected\n<span font_desc='Inter 11px' fgalpha='66%'>Click toggles speeds</span>",
        "tooltip-format-disconnected": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>NETWORK</span>  Offline\n<span font_desc='Inter 11px' fgalpha='66%'>Click toggles speeds</span>"
    },
    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "muted",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>VOLUME</span>  {volume}%\n<span font_desc='Inter 11px' fgalpha='66%'>Scroll ±5 · Click, right- or middle-click mutes</span>",
        "align": 1,
        "on-click": "pamixer -t",
        "on-click-right": "pamixer -t",
        "on-click-middle": "pamixer -t",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5"
    },
    "backlight": {
        "format": "{percent}%",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BRIGHTNESS</span>  {percent}%\n<span font_desc='Inter 11px' fgalpha='66%'>Scroll ±1</span>",
        "align": 1,
        "on-scroll-up": "~/.local/bin/osd-brightness bup",
        "on-scroll-down": "~/.local/bin/osd-brightness bdown"
    },
    "cpu": {
        "interval": 5,
        "format": "{usage}%",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>CPU</span>  {usage}%",
        "align": 1
    },
    "memory": {
        "interval": 5,
        "format": "{percentage}%",
        "align": 1,
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>MEMORY</span>  {percentage}%"
    },
    // CPU package temperature. Waybar's temperature module ignores "states", so waybar-temperature
    // prints the lN level class itself (min(100, C)) and "critical" from 80 C
    "custom/temperature": {
        "exec": "~/.local/bin/waybar-temperature",
        "return-type": "json",
        "interval": 5,
        "align": 1,
        "format": "{}"
    },
    "disk": {
        "interval": 30,
        "paths": ["/"],
        "format": "{percentage_used}%",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>DISK</span>  {percentage_used}%",
        "align": 1
    },
    "battery": {
        "format": "{capacity}%",
        "format-charging": "{capacity}%",
        "format-plugged": "{capacity}%",
        "tooltip-format-discharging": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BATTERY</span>  {capacity}% · on battery\n<span font_desc='Inter 11px' fgalpha='66%'>Click opens the session menu</span>",
        "tooltip-format-charging": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BATTERY</span>  {capacity}% · charging\n<span font_desc='Inter 11px' fgalpha='66%'>Click opens the session menu</span>",
        "tooltip-format-plugged": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BATTERY</span>  {capacity}% · plugged in\n<span font_desc='Inter 11px' fgalpha='66%'>Click opens the session menu</span>",
        "tooltip-format-full": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BATTERY</span>  {capacity}% · full\n<span font_desc='Inter 11px' fgalpha='66%'>Click opens the session menu</span>",
        "align": 1,
        "on-click": "wlogout -b 6 --protocol layer-shell"
    },

    // wlsunset (wlsunset/.local/bin/nightlight): moon = on; auto is neutral, warm orange, off hollow
    "custom/nightlight": {
        "exec": "~/.local/bin/nightlight status",
        "return-type": "json",
        "interval": 60,
        "signal": 9,
        "format": "\u200b",
        "on-click": "~/.local/bin/nightlight toggle",
        "on-click-right": "~/.local/bin/nightlight menu"
    },

    // gpurecord prints a line only while recording; the zero-width label keeps it hidden otherwise
    "custom/record": {
        "exec": "~/.local/bin/gpurecord status",
        "signal": 8,
        "format": "\u200b",
        "tooltip-format": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>RECORDING</span>  Click stops",
        "on-click": "~/.local/bin/gpurecord"
    },

    "custom/notifications": {
        "exec": "~/.local/bin/waybar-notifications",
        "return-type": "json",
        "interval": 2,
        "signal": 10,
        "format": "{}",
        "on-click": "makoctl restore; pkill -RTMIN+10 waybar",
        "on-click-middle": "makoctl dismiss --all; pkill -RTMIN+10 waybar",
        "on-click-right": "makoctl mode -t do-not-disturb; pkill -RTMIN+10 waybar"
    },

    "bluetooth": {
        "format": "\u200b",
        "format-connected": "{num_connections}",
        "format-off": "\u200b",
        "format-disabled": "\u200b",
        "format-no-controller": "",
        "tooltip-format-on": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BLUETOOTH</span>  On · none connected",
        "tooltip-format-connected": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BLUETOOTH</span>  {num_connections} connected",
        "tooltip-format-off": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BLUETOOTH</span>  Off",
        "tooltip-format-disabled": "<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>BLUETOOTH</span>  Off",
        "on-click": "blueman-manager"
    },

    "tray": { "icon-size": 16, "spacing": 4 },

    // 1px lines (style.css paints the 14px rule); zero-width labels keep the custom module alive
    "custom/divider#left": { "format": "\u200b" },
    "custom/divider#right": { "format": "\u200b" }
}
