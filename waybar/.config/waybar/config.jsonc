// waybar: cjbassi's layout (github.com/cjbassi/config, .config/waybar) as powerline segments, each on
// one of the palette's accents and split by thin chevrons (style.css, colors.css). Each module draws
// its own arrow edges (style.css + edges/), so there are no separator modules.
{
    "layer": "top",
    "position": "bottom",
    "height": 26,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": ["custom/arch", "ext/workspaces", "mango/layout"],
    "modules-center": ["clock#day", "clock#time", "clock#date"],
    // network, battery, disk and the night light change color with their state; none of them sit
    // side by side, so each owns both of its arrows (style.css)
    "modules-right": [
        "network", "pulseaudio", "backlight", "battery",
        "memory", "disk", "cpu",
        "custom/nightlight", "tray", "custom/record", "custom/power"
    ],

    // the Arch logo: the text is blank, style.css draws arch-symbolic.svg; opens the launcher that
    // mango binds to super+d
    "custom/arch": {
        "format": "  ",
        "tooltip-format": "Applications (super+d)",
        "on-click": "rofi -show drun"
    },

    // mango tags over ext-workspace-v1; empty tags are "hidden" there, so they stay out
    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "ignore-hidden": true,
        "sort-by-id": true
    },

    // the current layout as an AwesomeWM-style icon: the text is blank, style.css draws
    // layouts/<name>-symbolic.svg for the symbol class mango reports (mmsg get layouts)
    "mango/layout": {
        "format": "  ",
        "tooltip": false,
        "on-click": "mmsg dispatch switch_layout"
    },

    // one pill in style.css: "Tue 14:32 10 Nov"
    "clock#day":  { "format": "{:%a}", "tooltip": false },
    "clock#time": { "format": "{:%H:%M}", "tooltip-format": "<tt>{calendar}</tt>" },
    "clock#date": { "format": "{:%d %b}", "tooltip": false },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭 offline",
        "format-alt": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
        "tooltip-format": "{ifname} {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pamixer -t",
        "on-scroll-up": "pamixer -i 2",
        "on-scroll-down": "pamixer -d 2"
    },
    "backlight": {
        "format": "󰃠 {percent}%",
        "on-scroll-up": "~/.local/bin/osd-brightness bup",
        "on-scroll-down": "~/.local/bin/osd-brightness bdown"
    },
    "memory": {
        "interval": 5,
        "format": "mem {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "cpu": {
        "interval": 5,
        "format": "cpu {usage}%"
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "disk": {
        "interval": 30,
        "paths": ["/"],
        "states": { "warning": 80, "critical": 90 },
        "format": "disk {percentage_used}%"
    },
    // wlsunset (wlsunset/.local/bin/nightlight): moon = on, sun = off; menu sets mode and temperature
    "custom/nightlight": {
        "exec": "~/.local/bin/nightlight status",
        "return-type": "json",
        "interval": 60,
        "signal": 9,
        "on-click": "~/.local/bin/nightlight toggle",
        "on-click-right": "~/.local/bin/nightlight menu"
    },
    "tray": { "icon-size": 14, "spacing": 6 },

    // gpurecord prints a line only while recording, and pokes signal 8 on start/stop
    "custom/record": {
        "exec": "~/.local/bin/gpurecord status",
        "signal": 8,
        "format": "{}",
        "on-click": "~/.local/bin/gpurecord"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout -b 6 --protocol layer-shell",
        "on-click-right": "makoctl mode -t do-not-disturb"
    }
}
