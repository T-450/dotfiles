// waybar, "Viewport": two 38px bars in one process (style.css), after SGI CAD workstations.
// Top bar: live controls & wide window list (24px λ, tags 1-4 + bracketed [0], layout, keymode,
// magenta winstate, windows | day/time/date | recording, NET, BRI, VOL, BAT/CHG, icons).
// Bottom bar: optical floor with mirrored top ruler, triad, CPU/MEM flanks, GPU ribbons, player
// with 1px cyan progress rail, TMP/DSK flanks, and the 16-step CLUT key.
[
    {
        "layer": "top",
        "position": "top",
        "height": 38,
        "spacing": 0,
        "reload_style_on_change": true,

        "modules-left": ["custom/start", "mango/workspaces", "custom/special", "custom/divider#left", "custom/layout", "mango/keymode", "custom/winstate", "custom/windows",
            "custom/win#1", "custom/win#2", "custom/win#3", "custom/win#4", "custom/win#5", "custom/win#6"],
        "modules-center": ["group/datetime"],
        "modules-right": [
            "custom/record", "network", "backlight", "pulseaudio", "battery",
            "custom/divider#tray", "custom/nightlight", "custom/wallpaper",
            "bluetooth", "tray", "custom/notifications", "custom/power"
        ],

        // the 24px λ is crisp text (cyan on hover); icon-only buttons carry a zero-width space
        "custom/start": {
            "format": "λ",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>LAUNCHER</span>  <span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='80%'>SUPER D</span>",
            "on-click": "walker"
        },
        "custom/wallpaper": {
            "format": "\u200b",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>WALLPAPER</span>  Open picker  <span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='80%'>SUPER W</span>",
            "on-click": "waypaper"
        },
        "custom/power": {
            "format": "\u200b",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>POWER</span>  Session menu  <span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='80%'>SUPER ESC  P</span>",
            "on-click": "wlogout -b 6 --protocol layer-shell"
        },

        // tags 1-4 (super+1..4); style.css gives .empty, occupied, .active and .urgent their own looks
        "mango/workspaces": {
            "format": "{name}",
            "tag-filter": [1, 2, 3, 4],
            "on-click": "activate",
            "on-click-right": "toggle"
        },

        // the drawable glyph (layouts/<symbol>-symbolic.svg)
        "custom/layout": {
            "exec": "~/.local/bin/waybar-layout",
            "return-type": "json",
            "restart-interval": 1,
            "format": "{}",
            "on-click": "mmsg dispatch switch_layout"
        },

        // windows pinned, kept on top or minimized; hidden when none is
        "custom/winstate": {
            "exec": "~/.local/bin/waybar-winstate",
            "return-type": "json",
            "interval": 10,
            "signal": 11,
            "on-click": "~/.local/bin/mango-state --clear"
        },

        // the open key mode (super+esc, super+n or super+m)
        "mango/keymode": {
            "format": "{mode}",
            "format-default": ""
        },

        // the windows in view by title, one chip each
        "custom/windows": {
            "exec": "~/.local/bin/waybar-windows feed",
            "restart-interval": 1,
            "tooltip": false
        },
        "custom/win#1": {
            "exec": "~/.local/bin/waybar-windows slot 1",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 1",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#2": {
            "exec": "~/.local/bin/waybar-windows slot 2",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 2",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#3": {
            "exec": "~/.local/bin/waybar-windows slot 3",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 3",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#4": {
            "exec": "~/.local/bin/waybar-windows slot 4",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 4",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#5": {
            "exec": "~/.local/bin/waybar-windows slot 5",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 5",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },
        "custom/win#6": {
            "exec": "~/.local/bin/waybar-windows slot 6",
            "return-type": "json",
            "signal": 12,
            "tooltip": false,
            "on-click": "~/.local/bin/waybar-windows focus 6",
            "on-scroll-up": "mmsg dispatch focusstack,prev",
            "on-scroll-down": "mmsg dispatch focusstack,next"
        },

        // tag 0, mango's special tag (super+0); visually bracketed apart from 1-4 in style.css
        "custom/special": {
            "exec": "~/.local/bin/waybar-windows special",
            "return-type": "json",
            "signal": 12,
            "format": "0",
            "tooltip": false,
            "on-click": "mmsg dispatch toggle_special_tag"
        },

        // day, time (calendar tooltip) and date
        "group/datetime": {
            "orientation": "horizontal",
            "modules": ["custom/day", "clock#time", "custom/date"]
        },
        "custom/day": { "exec": "date '+%^a'", "interval": 60, "tooltip": false },
        "clock#time": {
            "format": "{:%H:%M}",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>CALENDAR</span>  {:%A, %e %B %Y · W%V}\n\n<tt><span letter_spacing='0'>{calendar}</span></tt>"
        },
        "custom/date": { "exec": "date '+%-d %^b'", "interval": 60, "tooltip": false },

        "network": {
            "format-wifi": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>NET</span> {essid:.16}",
            "format-ethernet": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>NET</span> {ifname}",
            "format-disconnected": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>OFFLINE</span>",
            "format-alt": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>DN</span> {bandwidthDownBytes} <span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>UP</span> {bandwidthUpBytes}",
            "align": 1,
            "tooltip-format-wifi": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>WI-FI</span>  {essid} · {signalStrength}%\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click toggles speeds</span>",
            "tooltip-format-ethernet": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>ETHERNET</span>  {ifname} · connected\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click toggles speeds</span>",
            "tooltip-format-disconnected": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>NETWORK</span>  Offline\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click toggles speeds</span>"
        },
        // laptop panel brightness; scroll uses osd-brightness bup/bdown (1% steps without OSD spam)
        "backlight": {
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>BRI</span> {percent}",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BRIGHTNESS</span>  {percent}%\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Scroll ±1%</span>",
            "align": 1,
            "on-scroll-up": "~/.local/bin/osd-brightness bup",
            "on-scroll-down": "~/.local/bin/osd-brightness bdown"
        },
        "pulseaudio": {
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>VOL</span> {volume}",
            "format-muted": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>MUTE</span>",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>VOLUME</span>  {volume}%\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Scroll ±5 · Click, right- or middle-click mutes</span>",
            "align": 1,
            "on-click": "pamixer -t",
            "on-click-right": "pamixer -t",
            "on-click-middle": "pamixer -t",
            "on-scroll-up": "pamixer -i 5",
            "on-scroll-down": "pamixer -d 5"
        },
        "battery": {
            "states": { "warning": 20, "critical": 10 },
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>BAT</span> {capacity}",
            "format-charging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>CHG</span> {capacity}",
            "format-plugged": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>AC</span> {capacity}",
            "format-full": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>AC</span> {capacity}",
            "format-not-charging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>AC</span> {capacity}",
            "tooltip-format-discharging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BATTERY</span>  {capacity}% · on battery\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens the session menu</span>",
            "tooltip-format-charging": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BATTERY</span>  {capacity}% · charging\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens the session menu</span>",
            "tooltip-format-plugged": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BATTERY</span>  {capacity}% · plugged in\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens the session menu</span>",
            "tooltip-format-full": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BATTERY</span>  {capacity}% · full\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens the session menu</span>",
            "align": 1,
            "on-click": "wlogout -b 6 --protocol layer-shell"
        },

        "custom/nightlight": {
            "exec": "~/.local/bin/nightlight status",
            "return-type": "json",
            "interval": 60,
            "signal": 9,
            "format": "\u200b",
            "on-click": "~/.local/bin/nightlight toggle",
            "on-click-right": "~/.local/bin/nightlight menu"
        },

        "custom/record": {
            "exec": "~/.local/bin/gpurecord status",
            "signal": 8,
            "format": "\u200b",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>RECORDING</span>  Click stops",
            "on-click": "~/.local/bin/gpurecord"
        },

        "custom/notifications": {
            "exec": "~/.local/bin/waybar-notifications",
            "return-type": "json",
            "interval": 2,
            "signal": 10,
            "format": "{}",
            "on-click": "swaync-client -t -sw",
            "on-click-middle": "swaync-client -C && pkill -RTMIN+10 waybar",
            "on-click-right": "swaync-client -d -sw && pkill -RTMIN+10 waybar"
        },

        "bluetooth": {
            "format": "\u200b",
            "format-connected": "{num_connections}",
            "format-off": "\u200b",
            "format-disabled": "\u200b",
            "format-no-controller": "",
            "tooltip-format-on": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BLUETOOTH</span>  On · none connected",
            "tooltip-format-connected": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BLUETOOTH</span>  {num_connections} connected",
            "tooltip-format-off": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BLUETOOTH</span>  Off",
            "tooltip-format-disabled": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>BLUETOOTH</span>  Off",
            "on-click": "blueman-manager"
        },

        "tray": { "icon-size": 14, "spacing": 0 },

        "custom/divider#left": { "format": "\u200b", "tooltip": false },
        "custom/divider#tray": { "format": "\u200b", "tooltip": false }
    },
    // the media & telemetry floor (38px, mirrored top ruler): triad, CPU+MEM, left ribbon, player
    // with 1px cyan progress rail, right ribbon, TMP+DSK, CLUT key.
    {
        "layer": "top",
        "position": "bottom",
        "height": 38,
        "spacing": 0,
        "expand-left": true,
        "expand-right": true,

        "modules-left": [
            "cffi/triad", "custom/divider#bleft1", "cpu", "memory",
            "custom/divider#bleft2", "cffi/ribbons#left"
        ],
        "modules-center": ["mpris#prev", "mpris#play", "mpris#next", "custom/player"],
        "modules-right": [
            "cffi/ribbons#right", "custom/divider#bright1", "custom/temperature", "disk",
            "custom/divider#bright2", "custom/clut"
        ],

        "cffi/triad": {
            "module_path": "/usr/lib/waybar-ribbons/triad.so"
        },
        "custom/clut": {
            "format": "\u200b",
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>CLUT</span>  Palette picker  <span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='80%'>SUPER P</span>\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>16 energy steps · Click switches palette</span>",
            "on-click": "~/.local/bin/theme pick"
        },

        // hardware telemetry flanks (CLUT tiers: cyan idle -> green active -> warn -> crit)
        "cpu": {
            "interval": 5,
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>CPU</span> {usage}",
            "states": { "active": 50, "warning": 85 },
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>CPU</span>  {usage}%\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens btop</span>",
            "align": 1,
            "on-click": "ghostty --class=com.mitchellh.ghostty-float -e btop"
        },
        "memory": {
            "interval": 5,
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>MEM</span> {percentage}",
            "states": { "active": 50, "warning": 80, "critical": 90 },
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>MEMORY</span>  {percentage}%\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens btop</span>",
            "align": 1,
            "on-click": "ghostty --class=com.mitchellh.ghostty-float -e btop"
        },
        "custom/temperature": {
            "exec": "~/.local/bin/waybar-temperature",
            "return-type": "json",
            "interval": 5,
            "align": 1,
            "format": "{}",
            "on-click": "ghostty --class=com.mitchellh.ghostty-float -e btop"
        },
        "disk": {
            "interval": 30,
            "paths": ["/"],
            "format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>DSK</span> {percentage_used}",
            "states": { "active": 50, "warning": 80, "critical": 90 },
            "tooltip-format": "<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>DISK</span>  {percentage_used}%\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens Thunar</span>",
            "align": 1,
            "on-click": "thunar /"
        },

        "cffi/ribbons#left": { "module_path": "/usr/lib/waybar-ribbons/ribbons.so", "channel": "left", "expand": true },
        "cffi/ribbons#right": { "module_path": "/usr/lib/waybar-ribbons/ribbons.so", "channel": "right", "expand": true },

        // transport buttons stay native mpris; custom/player adds the 1px cyan progress rail & scroll seek
        "mpris#prev": { "format": "\u200b", "tooltip": false, "on-click": "playerctl previous" },
        "mpris#play": { "format": "\u200b", "tooltip": false },
        "mpris#next": { "format": "\u200b", "tooltip": false, "on-click": "playerctl next" },
        "custom/player": {
            "exec": "~/.local/bin/waybar-player",
            "return-type": "json",
            "interval": 1,
            "format": "{}",
            "on-click": "playerctl play-pause",
            "on-click-middle": "playerctl previous",
            "on-click-right": "playerctl next",
            "on-scroll-up": "playerctl position 5+",
            "on-scroll-down": "playerctl position 5-"
        },

        "custom/divider#bleft1": { "format": "\u200b", "tooltip": false },
        "custom/divider#bleft2": { "format": "\u200b", "tooltip": false },
        "custom/divider#bright1": { "format": "\u200b", "tooltip": false },
        "custom/divider#bright2": { "format": "\u200b", "tooltip": false }
    }
]
