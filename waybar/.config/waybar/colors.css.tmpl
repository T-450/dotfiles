/* waybar colors from {{name}} (palette {{slug}}); rendered by theme from colors.css.tmpl, never edit. */
/* The strip, and the stripe pair on its top edge: the palette's two brand colors, as the teal and
   cobalt stripes run along a cassette J-card (on a palette whose badge is its accent, one band). */
@define-color bar      {{bg_desktop}};
@define-color stripe_a {{accent}};
@define-color stripe_b {{badge}};

/* Type: text = values, occupied tags, the λ, the focused window, the time; dim = what is empty,
   off or in the background (empty tags, other windows, icons at rest, muted, offline). Labels are
   text at 55% (Pango fgalpha in the formats), so they need no role. rule = the 1px dividers. */
@define-color text     {{fg_editor|mix:fg_bright:0.78|legible:bg_desktop}};
@define-color dim      {{fg_editor|mix:fg_muted:0.6|legible:bg_desktop}};
@define-color rule     {{border_hairline|mix:border_inactive:0.5}};

/* Color only where it means something. A warning has no hue: it is the chip inverted (text block,
   bar type), which reads on every palette.
   signal = the viewed tag (a block, its number in bar)
   held   = time held by hand: the night light forced warm
   crit   = critical or asking now: a crit block, an urgent tag, a held critical notification,
            recording in progress, power under the pointer */
@define-color signal   {{accent|legible:bg_desktop}};
@define-color held     {{badge|legible:bg_desktop}};
@define-color crit     {{error|legible:bg_desktop}};

/* the tooltip's 1px ring, and the selected text in tray menus */
@define-color tipline  {{fg_disabled}};
@define-color sel      {{selection_bg}};
@define-color selfg    {{selection_fg}};
