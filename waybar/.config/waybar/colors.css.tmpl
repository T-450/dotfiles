/* waybar colors from {{name}} (palette {{slug}}); rendered by theme from colors.css.tmpl, never edit. */
/* "Viewport": one shared role set (vp_*) computed once in theme for dark and light palettes. */
@define-color bar      {{vp_bar}};
@define-color text     {{vp_text}};
@define-color dim      {{vp_dim}};
@define-color cyan     {{vp_cyan}};
@define-color magenta  {{vp_magenta}};
@define-color orange   {{vp_orange}};
@define-color green    {{vp_green}};
@define-color warn     {{vp_warn}};
@define-color crit     {{vp_crit}};
@define-color signal   {{vp_signal}};
@define-color grid     {{vp_grid}};

/* CLUT: 16 steps by energy (read by name by waybar-ribbons and the media bar's CLUT legend) */
@define-color clut0    {{vp_clut0}};
@define-color clut1    {{vp_clut1}};
@define-color clut2    {{vp_clut2}};
@define-color clut3    {{vp_clut3}};
@define-color clut4    {{vp_clut4}};
@define-color clut5    {{vp_clut5}};
@define-color clut6    {{vp_clut6}};
@define-color clut7    {{vp_clut7}};
@define-color clut8    {{vp_clut8}};
@define-color clut9    {{vp_clut9}};
@define-color clut10   {{vp_clut10}};
@define-color clut11   {{vp_clut11}};
@define-color clut12   {{vp_clut12}};
@define-color clut13   {{vp_clut13}};
@define-color clut14   {{vp_clut14}};
@define-color clut15   {{vp_clut15}};

/* the selected text in tray menus */
@define-color sel      {{selection_bg}};
@define-color selfg    {{selection_fg}};
