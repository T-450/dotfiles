/* waybar colors from {{name}} (palette {{slug}}); rendered by theme from colors.css.tmpl, never edit. */
/* The surface, its 1px ring and the design's 1px sheen: the ring is the hairline mixed toward the
   inactive border, the sheen is white at 5% in style.css. */
@define-color bar     {{bg_desktop}};
@define-color edge    {{border_hairline|mix:border_inactive:0.3}};
@define-color sheen   {{selection_fg}};

/* Text: text is the editor color lifted toward the bright foreground, dim the same color blended
   with the muted one. text = primary facts (occupied tags, the layout), editor =
   secondary facts and controls (every chip's icon, value and level bar), dim = labels and
   whatever is off or empty (day, date, title, empty tags, muted, disconnected). */
@define-color text    {{fg_editor|mix:fg_bright:0.78|legible:bg_desktop}};
@define-color dim     {{fg_editor|mix:fg_muted:0.6|legible:bg_desktop}};
@define-color editor  {{fg_editor|legible:bg_desktop}};

/* Colour carries meaning or is absent (the Quiet Instrument rule). Everything on the bar is one
   of the three neutrals above unless it is one of these, each kept legible on the bar:
   signal = the one thing that matters now: the viewed tag
   live   = real time and live connections: the wall clock, network up (its name and strength),
            a bluetooth device connected
   held   = time held by hand: the night light forced warm ("warm now"), whatever the hour
   ok     = success in progress: battery charging
   warn   = pending: cpu/memory/disk/temperature high, battery low, a window pinned to every tag
   crit   = failure, irreversible, or asking now: memory/disk/temperature critical, battery nearly
            empty, an urgent tag, a held critical notification, a recording in progress, power under
            the pointer */
@define-color signal  {{accent|legible:bg_desktop}};
@define-color live    {{link|legible:bg_desktop}};
@define-color held    {{badge|legible:bg_desktop}};
@define-color ok      {{success|legible:bg_desktop}};
@define-color warn    {{warning|legible:bg_desktop}};
@define-color crit    {{error|legible:bg_desktop}};

/* the tooltip's 1px ring, and the selected text in tray menus */
@define-color tipline {{fg_disabled}};
@define-color sel     {{selection_bg}};
@define-color selfg   {{selection_fg}};
