/* waybar colors from {{name}} (palette {{slug}}); rendered by theme from colors.css.tmpl, never edit. */
/* "Viewport": the media bar's role set (the top bar's Material 3 roles are at the end). Each hue
   has one job: cyan = chrome, text = the one fact in focus, orange = action, magenta = someone
   else's. Every role is legible on bg_desktop, so on the darker bar too. */

/* the bar: near-black on a dark palette, the desktop itself on a light one, where a darker bar
   would sit under type made legible on the desktop. prefer_dark is 1 or 0, so GTK's mix() picks. */
@define-color bar      mix({{bg_desktop}}, {{bg_desktop|mix:shadow:0.6}}, {{prefer_dark}});

/* text = the track title, the triad's origin, the ribbons' specular edge */
@define-color text     {{fg_editor|mix:fg_bright:0.78|legible:bg_desktop}};

/* cyan = chrome: the rule, prev/next, the track time, the triad's Z axis */
@define-color cyan     {{ansi6|legible:bg_desktop}};
/* magenta = the artist */
@define-color magenta  {{ansi5|legible:bg_desktop}};
/* orange = action: play, the triad's X axis */
@define-color orange   {{warning|mix:error:0.4|legible:bg_desktop}};
/* green = the triad's Y axis */
@define-color green    {{success|legible:bg_desktop}};
/* grid = the desktop's dot grid, the ribbons' floor */
@define-color grid     {{ansi4}};

/* CLUT: 16 steps by energy, blue to red through cyan, green, yellow and orange. The ribbons
   (waybar-ribbons reads these by name) and the media bar's legend. */
@define-color clut0    {{ansi4}};
@define-color clut1    {{ansi4|mix:ansi6:0.33}};
@define-color clut2    {{ansi4|mix:ansi6:0.67}};
@define-color clut3    {{ansi6}};
@define-color clut4    {{ansi6|mix:success:0.33}};
@define-color clut5    {{ansi6|mix:success:0.67}};
@define-color clut6    {{success}};
@define-color clut7    {{success|mix:warning:0.33}};
@define-color clut8    {{success|mix:warning:0.67}};
@define-color clut9    {{warning}};
@define-color clut10   {{warning|mix:error:0.133}};
@define-color clut11   {{warning|mix:error:0.267}};
@define-color clut12   {{warning|mix:error:0.4}};
@define-color clut13   {{warning|mix:error:0.6}};
@define-color clut14   {{warning|mix:error:0.8}};
@define-color clut15   {{error}};

/* ---- the top bar, Material 3 (docs/designs/material-shapeshifter/SPEC-bar.md): m3_* roles and
   the state-layer tokens, so style.css never mixes a color itself */
/* pieces: surface_container_high pills, on_surface type, on_surface_variant icons */
@define-color piece         {{m3_surface_container_high}};
@define-color piece_hover   {{m3_surface_container_high|mix:m3_on_surface:state_hover}};
@define-color piece_press   {{m3_surface_container_high|mix:m3_on_surface:state_pressed}};
@define-color on_piece      {{m3_on_surface}};
@define-color on_piece_var  {{m3_on_surface_variant}};
@define-color piece_outline {{m3_outline}};
/* the core: the clock on primary_container */
@define-color core          {{m3_primary_container}};
@define-color on_core       {{m3_on_primary_container}};
/* the selected state: the viewed tag. secondary, not secondary_container: on a light palette the
   container is as light as the pill (Space Light 1.1:1), and the selected fill is the tag's edge */
@define-color selected      {{m3_secondary}};
@define-color selected_hover {{m3_secondary|mix:m3_on_secondary:state_hover}};
@define-color on_selected   {{m3_on_secondary}};
/* an armed key mode: a tertiary chip */
@define-color mode          {{m3_tertiary_container}};
@define-color on_mode       {{m3_on_tertiary_container}};
/* active: charging, the brightness slider's active track */
@define-color active        {{m3_primary}};
@define-color track         {{m3_surface_container_highest}};
/* error: the count badge, low battery, a pinned window, recording */
@define-color badge         {{m3_error}};
/* error as type on a piece (low battery): pushed to 4.5:1 on the pill */
@define-color badge_text    {{m3_error|legible:m3_surface_container_high}};
@define-color on_badge      {{m3_on_error}};
@define-color alert         {{m3_error_container}};
@define-color on_alert      {{m3_on_error_container}};
/* plain tooltips: inverse_surface */
@define-color tip           {{m3_inverse_surface}};
@define-color on_tip        {{m3_inverse_on_surface}};
