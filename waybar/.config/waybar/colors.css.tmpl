/* waybar colors from {{name}} (palette {{slug}}); rendered by theme from colors.css.tmpl, never edit. */
@define-color bar     {{bg_surface}};
@define-color widget  {{bg_widget}};
@define-color line    {{border_hairline}};
@define-color fg      {{fg_text}};
@define-color sel     {{selection_bg}};
@define-color selfg   {{selection_fg}};

/* segments: every accent role of the palette, its purple and a raised surface (agnoster's dark
   segment); ink_* = legible text on each */
@define-color raised  {{bg_hover}};
@define-color ink_raised  {{bg_hover|ink}};
@define-color purple  {{ansi13}};
@define-color ink_purple  {{ansi13|ink}};
@define-color accent  {{accent}};
@define-color ink_accent  {{accent|ink}};
@define-color link    {{link}};
@define-color ink_link    {{link|ink}};
@define-color badge   {{badge}};
@define-color ink_badge   {{badge|ink}};
@define-color success {{success}};
@define-color ink_success {{success|ink}};
@define-color warn    {{warning}};
@define-color ink_warn    {{warning|ink}};
@define-color error   {{error}};
@define-color ink_error   {{error|ink}};
