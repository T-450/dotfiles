/* waybar colors from {{name}} (palette {{slug}}); rendered by theme from colors.css.tmpl, never edit. */
@define-color bar     {{bg_surface}};
@define-color widget  {{bg_widget}};
@define-color line    {{border_hairline}};
@define-color fg      {{fg_text}};
@define-color sel     {{selection_bg|legible:selection_fg}};
@define-color selfg   {{selection_fg}};
/* on the bar itself: dim = an occupied tag's text, logo = the Arch logo; both made legible on it */
@define-color dim     {{fg_secondary|legible:bg_surface}};
@define-color logo    {{accent|legible:bg_surface}};

/* segments: neutrals (a raised surface and a grey) serve the static modules, the palette's
   accents and its purple the live ones; ink_* = legible text on each. Blues carry white text
   (selection_fg), each darkened only as far as white needs; disk's accent is mixed toward the
   desktop first so it stays distinct from memory's badge beside it. faint_raised = dimmed text
   (muted, night light off) and rec = the recording dot's red, both kept legible on their segment. */
@define-color raised  {{bg_hover}};
@define-color ink_raised  {{bg_hover|ink}};
@define-color faint_raised {{bg_hover|ink|mix:bg_hover:0.4|legible:bg_hover}};
@define-color grey    {{fg_disabled}};
@define-color ink_grey    {{fg_disabled|ink}};
@define-color rec     {{error|legible:fg_disabled}};
@define-color purple  {{ansi13}};
@define-color ink_purple  {{ansi13|ink}};
@define-color accent  {{accent|mix:bg_desktop:0.4|legible:selection_fg}};
@define-color ink_accent  {{selection_fg}};
@define-color link    {{link|legible:selection_fg}};
@define-color ink_link    {{selection_fg}};
@define-color badge   {{badge|legible:selection_fg}};
@define-color ink_badge   {{selection_fg}};
@define-color success {{success}};
@define-color ink_success {{success|ink}};
@define-color warn    {{warning}};
@define-color ink_warn    {{warning|ink}};
@define-color error   {{error}};
@define-color ink_error   {{error|ink}};

/* split chevrons. strong = the selected tag's text, glow = the hover ring (accent mixed into the
   bar, opaque), dots = the selected tag's dotted line (accent, legible on the bar it sits on). */
@define-color strong  {{fg_bright|legible:bg_surface}};
@define-color glow    {{accent|mix:bg_surface:0.35}};
@define-color dots    {{accent|legible:bg_surface}};
