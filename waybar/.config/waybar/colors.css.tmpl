/* waybar colors from {{name}} (palette {{slug}}); rendered by theme from colors.css.tmpl, never edit. */
/* The surface, its 1px ring and the design's 1px sheen: the ring is the hairline mixed toward the
   inactive border, the sheen is white at 5% in style.css. */
@define-color bar     {{bg_desktop}};
@define-color edge    {{border_hairline|mix:border_inactive:0.3}};
@define-color sheen   {{selection_fg}};

/* Text: text is the editor color lifted toward the bright foreground, dim the same color blended
   with the muted one for tags/title/date. editor is the neutral chip color (volume, wallpaper). */
@define-color text    {{fg_editor|mix:fg_bright:0.78|legible:bg_desktop}};
@define-color dim     {{fg_editor|mix:fg_muted:0.6|legible:bg_desktop}};
@define-color editor  {{fg_editor|legible:bg_desktop}};

/* Accents: the terminal's bright colors, each kept legible on the bar. blue = start/cpu/viewed
   tag, sky = viewed tag text/disk, teal = memory, orange = temperature/night light warm,
   purple = battery, green = network/charging, amber = brightness/urgent/hot cpu,
   red = alerts/critical. */
@define-color blue    {{ansi4|legible:bg_desktop}};
@define-color sky     {{ansi12|legible:bg_desktop}};
@define-color teal    {{ansi6|legible:bg_desktop}};
@define-color orange  {{ansi11|legible:bg_desktop}};
@define-color purple  {{ansi5|legible:bg_desktop}};
@define-color green   {{ansi2|legible:bg_desktop}};
@define-color amber   {{ansi3|legible:bg_desktop}};
@define-color red     {{ansi1|legible:bg_desktop}};

/* the tooltip's 1px ring, and the selected text in tray menus */
@define-color tipline {{fg_disabled}};
@define-color sel     {{selection_bg}};
@define-color selfg   {{selection_fg}};
