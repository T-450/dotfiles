#!/usr/bin/env bash
# waybar-notifications: print swaync's held notifications as one waybar JSON line (custom/notifications).
# text = count ("99+" above 99; zero-width space at 0 so the bell stays); class gets unread and dnd.
# Read-only: only `swaync-client -c` and `swaync-client -D`.

n=$(swaync-client -c 2>/dev/null) || n=0
[[ $n =~ ^[0-9]+$ ]] || n=0
dnd_raw=$(swaync-client -D 2>/dev/null) || dnd_raw=false
[[ $dnd_raw == true ]] && dnd=true || dnd=false

jq -cn --argjson n "$n" --argjson dnd "$dnd" '
	{
		text: (if $n == 0 then "\u200b" elif $n > 99 then "99+" else ($n | tostring) end),
		class: ([if $n > 0 then "unread" else empty end,
			if $dnd then "dnd" else empty end]),
		tooltip: ("<span font_desc=\u0027Terminess Nerd Font 12px\u0027 letter_spacing=\u00271024\u0027 fgalpha=\u002760%\u0027>NOTIFICATIONS</span>  "
			+ (if $dnd then "Do not disturb · \($n) held"
				elif $n > 0 then "\($n) unread"
				else "None" end)
			+ "\n<span font_desc=\u0027Terminess Nerd Font 12px\u0027 letter_spacing=\u00270\u0027 fgalpha=\u002760%\u0027>Click toggles drawer · Middle clears all · Right toggles do not disturb</span>")
	}'
