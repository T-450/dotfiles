#!/usr/bin/env bash
# waybar-temperature: print the CPU package temperature as one waybar JSON line (custom/temperature)
# Waybar's own temperature module ignores "states", so the lN level class (min(100, C), sized by
# levels.css) comes from here; "critical" is added from 80 C.

# the design's tooltip line: dim uppercase name, then the value (see docs/apps/waybar.md)
name="<span font_desc='Inter Semi-Bold 11px' letter_spacing='507' fgalpha='66%'>TEMPERATURE</span>  "

for label in /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp*_label; do
	[[ -r $label ]] || continue
	[[ $(<"$label") == "Package id 0" ]] || continue
	milli=$(<"${label%_label}_input")
	break
done

if [[ -z ${milli:-} ]]; then
	printf '{"text": "n/a", "class": ["l0"], "tooltip": "%sn/a"}\n' "$name"
	exit 0
fi

c=$(((milli + 500) / 1000))
level=$((c > 100 ? 100 : c))
class="\"l$level\""
((c >= 80)) && class+=", \"critical\""
tip="$c °C"
((c >= 80)) && tip+=" · high"
printf '{"text": "%d°", "class": [%s], "tooltip": "%s%s"}\n' "$c" "$class" "$name" "$tip"
