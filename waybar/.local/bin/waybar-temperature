#!/usr/bin/env bash
# waybar-temperature: print the CPU package temperature as one waybar JSON line (custom/temperature)
# Waybar's own temperature module ignores "states", so the classes come from here: "active" from
# 60 C (green), "high" from 80 C (warn block), "critical" from 95 C (crit block; throttles at 100).

label="<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024'>TMP</span>"
name="<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>TEMPERATURE</span>  "
hint="\n<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click opens btop</span>"

for sensor in /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp*_label; do
	[[ -r $sensor ]] || continue
	[[ $(<"$sensor") == "Package id 0" ]] || continue
	milli=$(<"${sensor%_label}_input")
	break
done

if [[ -z ${milli:-} ]]; then
	printf '{"text": "%s n/a", "class": [], "tooltip": "%sn/a%s"}\n' "$label" "$name" "$hint"
	exit 0
fi

c=$(((milli + 500) / 1000))
class=""
tip="$c °C"
if ((c >= 95)); then
	class='"critical"'
	tip+=" · critical"
elif ((c >= 80)); then
	class='"high"'
	tip+=" · high"
elif ((c >= 60)); then
	class='"active"'
	tip+=" · warm"
fi
printf '{"text": "%s %d", "class": [%s], "tooltip": "%s%s%s"}\n' "$label" "$c" "$class" "$name" "$tip" "$hint"
