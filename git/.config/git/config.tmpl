# git: your identity comes from tags filled at render time (`theme`): your existing git config,
# else GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL, else a prompt. Never write the values here.
[user]
	name = {{git_name}}
	email = {{git_email}}
# GitHub over HTTPS signs in through the GitHub CLI (gh auth login)
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
# diffs, logs and `git add -p` through delta (git/packages), in the terminal's ANSI colors so they
# follow the palette, on the palette's diff tints (added, removed; the changed words a step
# stronger); n and N jump between files
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	syntax-theme = ansi
	plus-style = syntax "{{diff_add|mix:term_bg:0.85}}"
	minus-style = syntax "{{diff_remove|mix:term_bg:0.85}}"
	plus-emph-style = syntax "{{diff_add|mix:term_bg:0.75}}"
	minus-emph-style = syntax "{{diff_remove|mix:term_bg:0.75}}"
