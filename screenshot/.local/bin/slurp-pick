#!/usr/bin/env bash
# slurp-pick [slurp args...]: slurp in the active palette's Viewport CAD colors
# Used by screenshot and the screencast output chooser (xdg-desktop-portal-wlr).
colors=~/.config/theme/colors.sh
if [[ ! -r $colors ]]; then
	notify-send -u critical -a theme "Colors not rendered" "run ~/.local/bin/theme init"
	exec slurp "$@"
fi
# shellcheck source=/dev/null
. "$colors"
exec slurp -b "${THEME_VP_BAR}88" -c "${THEME_VP_CYAN}ff" "$@"
