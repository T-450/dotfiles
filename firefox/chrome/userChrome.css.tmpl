/* Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
   Firefox chrome (tabs, toolbars, url bar, panels, sidebar) in the palette's colors.
   Variable names are ones Firefox 159's own browser CSS defines on :root (checked in
   omni.ja); a renamed variable is simply ignored, so an update only falls back to the default.
   Linked into the profile by firefox/setup.sh; needs toolkit.legacyUserProfileCustomizations.stylesheets (user.js). */
:root {
	--toolbox-background-color: {{bg_desktop}} !important;
	--toolbox-background-color-inactive: {{bg_desktop}} !important;
	--toolbox-text-color: {{fg_text}} !important;
	--toolbox-text-color-inactive: {{fg_secondary}} !important;
	--toolbar-background-color: {{bg_surface}} !important;
	--toolbar-text-color: {{fg_text}} !important;
	--toolbar-field-background-color: {{bg_desktop}} !important;
	--toolbar-field-background-color-focus: {{bg_desktop}} !important;
	--toolbar-field-text-color: {{fg_text}} !important;
	--toolbar-field-text-color-focus: {{fg_bright}} !important;
	--toolbar-field-border-color: {{border_inactive}} !important;
	--toolbar-field-border-color-focus: {{accent}} !important;
	--toolbarbutton-icon-fill: {{fg_secondary}} !important;
	--toolbarbutton-background-color-hover: {{bg_hover}} !important;
	--toolbarbutton-background-color-active: {{bg_hover|mix:fg_text:0.08}} !important;
	--tab-background-color-selected: {{bg_surface}} !important;
	--tab-text-color-selected: {{fg_bright}} !important;
	--tab-text-color: {{fg_secondary}} !important;
	--tab-background-color-hover: {{bg_hover}} !important;
	--tab-icon-fill-loading: {{accent}} !important;
	--focus-outline-color: {{accent}} !important;
	--chrome-content-separator-color: {{border_hairline}} !important;
	--panel-background-color: {{bg_widget}} !important;
	--panel-text-color: {{fg_text}} !important;
	--panel-border-color: {{border_hairline}} !important;
	--urlbarview-background-color-hover: {{bg_hover}} !important;
	--urlbarview-background-color-selected: {{selection_bg}} !important;
	--urlbarview-text-color-selected: {{selection_fg}} !important;
	--urlbarview-text-color-secondary: {{fg_secondary}} !important;
	--urlbarview-separator-color: {{border_hairline}} !important;
	--sidebar-background-color: {{bg_surface}} !important;
	--sidebar-text-color: {{fg_text}} !important;
	--sidebar-border-color: {{border_hairline}} !important;
	--tabpanel-background-color: {{bg_desktop}} !important;
}
