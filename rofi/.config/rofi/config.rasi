configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Tela-mango"; // icons/render.sh; rofi doesn't follow GTK's setting on Wayland
    sort: true;
    sorting-method: "fzf";
    matching: "fuzzy";
    display-drun: "run";
    display-run: "cmd";
    // supporting text after the name (M3 list row); 80% alpha keeps it 4.5:1 on the selected row too
    drun-display-format: "{name}[<span fgalpha='80%'>  {generic}</span>]";
}

@theme "quickinput"
