/* Every rofi menu (the launcher, the clipboard, night light, the palette picker): a Material 3
   docked search view (docs/designs/material-shapeshifter/SPEC-bar.md). One surface_container_high
   card, corner extra large (28px), its elevation (level 3) by tone, not shadow (mango draws none):
   a 56px search row, an outline_variant divider, then 56px rows; the selected row a secondary pill.
   Type: body large (16px: Pango's 12pt at 96 dpi). Colors: colors.rasi, rendered by theme/theme.
   Menus open centred; the launcher (launcher.rasi) opens under its bar piece. */
@import "colors.rasi"
* {
  background-color: transparent; text-color: @on-surface; font: "IBM Plex Sans 12";
}
window { background-color: @surface; border: 0; border-radius: 28px; width: 560px; padding: 0; }
mainbox { spacing: 0; children: [ inputbar, listview ]; }
inputbar {
  padding: 16px 20px; spacing: 16px; border: 0 0 1px; border-color: @divider;
  children: [ icon-search, prompt, entry ];
}
icon-search { expand: false; filename: "system-search"; size: 24px; vertical-align: 0.5; }
prompt { text-color: @on-variant; vertical-align: 0.5; }
entry { placeholder: "Search"; placeholder-color: @on-variant; vertical-align: 0.5; cursor: text; }
listview { lines: 8; padding: 8px; spacing: 0; fixed-height: false; scrollbar: false; }
element { padding: 12px 16px; spacing: 16px; border-radius: 9999px; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @on-surface; }
element selected.normal, element selected.active { background-color: @selected; text-color: @on-selected; }
element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 24px; vertical-align: 0.5; }
