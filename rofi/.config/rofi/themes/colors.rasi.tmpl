/* Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit. */
/* Material 3 roles (docs/designs/material-shapeshifter/SPEC-bar.md). The selected row is secondary,
   the shell's selected state: secondary_container is as light as the container on a light palette */
* {
  surface: {{m3_surface_container_high}}; on-surface: {{m3_on_surface}}; on-variant: {{m3_on_surface_variant}};
  divider: {{m3_outline_variant}}; hover: {{m3_surface_container_high|mix:m3_on_surface:state_hover}};
  selected: {{m3_secondary}}; on-selected: {{m3_on_secondary}}; primary: {{m3_primary}};
}
/* highlight takes a literal color, not a variable */
element-text { highlight: bold {{m3_primary}}; }
element-text selected { highlight: bold {{m3_on_secondary}}; }
