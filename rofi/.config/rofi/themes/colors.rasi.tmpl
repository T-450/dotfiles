/* Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit. */
* {
  bg: {{bg_widget}}; input: {{bg_surface}}; line: {{border_hairline}}; inborder: {{border_inactive}};
  fg: {{fg_text}}; muted: {{fg_secondary}}; placeholder: {{fg_muted}}; accent: {{accent}};
  sel: {{selection_bg}}; selfg: {{selection_fg}}; hl: {{link}}; hover: {{bg_hover}};
}
/* highlight takes a literal color, not a variable */
element-text { highlight: bold {{link}}; }
element-text selected { highlight: bold {{selection_fg}}; }
