/* Launcher layout, modelled on VS Code's Quick Open (quickInput) widget.
   Colors: colors.rasi, rendered from the active palette by theme/theme. */
@import "colors.rasi"
* {
  background-color: transparent; text-color: @fg; font: "Inter 12";
}
window { background-color: @bg; border: 1px; border-color: @line; border-radius: 6px; width: 560px; padding: 6px; }
mainbox { spacing: 6px; }
inputbar { background-color: @input; border: 1px; border-color: @accent; border-radius: 2px; padding: 6px 8px; spacing: 8px; children: [ prompt, entry ]; }
prompt { text-color: @muted; }
entry { placeholder: "Search"; placeholder-color: @placeholder; }
listview { lines: 9; spacing: 0; fixed-height: false; scrollbar: false; }
element { padding: 4px 8px; border-radius: 3px; spacing: 8px; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal, element selected.active { background-color: @sel; text-color: @selfg; }
element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 16px; }
