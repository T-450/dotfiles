{
    "label" : "lock",
    "action" : "pidof -q hyprlock || hyprlock &",
    "text" : "LOCK [L]",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "~/.local/bin/mango-quit",
    "text" : "LOGOUT [M]",
    "keybind" : "m"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "SUSPEND [S]",
    "keybind" : "s"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "HIBERNATE [H]",
    "keybind" : "h"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "REBOOT [R]",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "SHUTDOWN [D]",
    "keybind" : "d"
}
