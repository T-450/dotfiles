[Unit]
Description=Display manager (way-displays)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/way-displays
# Empty, not removed: mango watches the file. A stale disable rule would start mango with no output.
# `mango-monitor stop-hook` empties it when the session ends, or when the lid rule no longer holds
# (a manual stop, the start limit: nothing would turn the panel back on). It keeps it while the lid
# is closed over an external display, so a restart (install.sh, Restart=) does not light the panel
# behind the lid until way-displays is back. The "-" keeps a failing hook from failing the unit.
ExecStopPost=-%h/.local/bin/mango-monitor stop-hook
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
