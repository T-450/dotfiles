" {{name}}: vim's colorscheme from the active palette, rendered by `theme`; .vimrc selects it.
" The same roles as helix's palette theme: syntax from the palette's syn_* roles (its [syntax] table,
" else text and punctuation in the palette's greys and the terminal's hues), made legible on
" term_bg, the ground: vim runs only in the terminal, so its background meets Ghostty's padding
" (bg_desktop is the desktop chrome's). The selection is the palette's selection fill.
hi clear
if exists('syntax_on')
	syntax reset
endif
set background={{variant}}
let g:colors_name = 'palette'

" --- editor ---
hi Normal       guifg={{fg_editor}} guibg={{term_bg}} gui=NONE cterm=NONE
hi NonText      guifg={{fg_disabled}} guibg=NONE gui=NONE cterm=NONE
hi SpecialKey   guifg={{fg_disabled}} guibg=NONE gui=NONE cterm=NONE
hi LineNr       guifg={{fg_disabled}} guibg=NONE gui=NONE cterm=NONE
hi CursorLineNr guifg={{fg_secondary}} guibg={{bg_surface}} gui=NONE cterm=NONE
hi CursorLine   guifg=NONE guibg={{bg_surface}} gui=NONE cterm=NONE
hi CursorColumn guifg=NONE guibg={{bg_surface}} gui=NONE cterm=NONE
hi ColorColumn  guifg=NONE guibg={{bg_surface}} gui=NONE cterm=NONE
hi SignColumn   guifg={{fg_muted|legible:term_bg}} guibg={{term_bg}} gui=NONE cterm=NONE
hi FoldColumn   guifg={{fg_disabled}} guibg={{term_bg}} gui=NONE cterm=NONE
hi Folded       guifg={{fg_muted|legible:term_bg}} guibg={{bg_surface}} gui=NONE cterm=NONE
hi VertSplit    guifg={{border_inactive}} guibg={{term_bg}} gui=NONE cterm=NONE
hi WinSeparator guifg={{border_inactive}} guibg={{term_bg}} gui=NONE cterm=NONE
hi Visual       guifg=NONE guibg={{selection_bg}} gui=NONE cterm=NONE
hi VisualNOS    guifg=NONE guibg={{selection_bg|mix:term_bg:0.4}} gui=NONE cterm=NONE
hi Search       guifg={{fg_bright}} guibg={{bg_hover}} gui=NONE cterm=NONE
hi CurSearch    guifg={{term_bg}} guibg={{accent}} gui=NONE cterm=NONE
hi IncSearch    guifg={{term_bg}} guibg={{accent}} gui=NONE cterm=NONE
hi MatchParen   guifg={{fg_bright}} guibg={{border_inactive}} gui=bold cterm=bold
hi QuickFixLine guifg=NONE guibg={{bg_hover}} gui=NONE cterm=NONE
hi Directory    guifg={{ansi4|legible:term_bg}} guibg=NONE gui=NONE cterm=NONE
hi Title        guifg={{fg_bright}} guibg=NONE gui=bold cterm=bold
hi Conceal      guifg={{fg_muted|legible:term_bg}} guibg=NONE gui=NONE cterm=NONE

