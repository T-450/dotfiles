{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": { "dark": "{{accent}}", "light": "{{accent}}" },
    "secondary": { "dark": "{{link}}", "light": "{{link}}" },
    "accent": { "dark": "{{link}}", "light": "{{link}}" },
    "error": { "dark": "{{error}}", "light": "{{error}}" },
    "warning": { "dark": "{{warning}}", "light": "{{warning}}" },
    "success": { "dark": "{{success}}", "light": "{{success}}" },
    "info": { "dark": "{{link}}", "light": "{{link}}" },
    "text": { "dark": "{{fg_text}}", "light": "{{fg_text}}" },
    "textMuted": { "dark": "{{fg_secondary}}", "light": "{{fg_secondary}}" },
    "background": { "dark": "{{term_bg}}", "light": "{{term_bg}}" },
    "backgroundPanel": { "dark": "{{bg_widget}}", "light": "{{bg_widget}}" },
    "backgroundElement": { "dark": "{{bg_hover}}", "light": "{{bg_hover}}" },
    "backgroundMenu": { "dark": "{{bg_widget}}", "light": "{{bg_widget}}" },
    "border": { "dark": "{{border_inactive}}", "light": "{{border_inactive}}" },
    "borderActive": { "dark": "{{accent}}", "light": "{{accent}}" },
    "borderSubtle": { "dark": "{{border_hairline}}", "light": "{{border_hairline}}" },
    "selectedListItemText": { "dark": "{{selection_fg}}", "light": "{{selection_fg}}" },
    "diffAdded": { "dark": "{{success}}", "light": "{{success}}" },
    "diffRemoved": { "dark": "{{error}}", "light": "{{error}}" },
    "diffContext": { "dark": "{{fg_secondary}}", "light": "{{fg_secondary}}" },
    "diffHunkHeader": { "dark": "{{fg_muted}}", "light": "{{fg_muted}}" },
    "diffHighlightAdded": { "dark": "{{success|mix:fg_bright:0.3}}", "light": "{{success|mix:fg_bright:0.3}}" },
    "diffHighlightRemoved": { "dark": "{{error|mix:fg_bright:0.3}}", "light": "{{error|mix:fg_bright:0.3}}" },
    "diffAddedBg": { "dark": "{{term_bg|mix:success:0.15}}", "light": "{{term_bg|mix:success:0.15}}" },
    "diffRemovedBg": { "dark": "{{term_bg|mix:error:0.15}}", "light": "{{term_bg|mix:error:0.15}}" },
    "diffContextBg": { "dark": "{{term_bg}}", "light": "{{term_bg}}" },
    "diffLineNumber": { "dark": "{{fg_muted}}", "light": "{{fg_muted}}" },
    "diffAddedLineNumberBg": { "dark": "{{term_bg|mix:success:0.25}}", "light": "{{term_bg|mix:success:0.25}}" },
    "diffRemovedLineNumberBg": { "dark": "{{term_bg|mix:error:0.25}}", "light": "{{term_bg|mix:error:0.25}}" },
    "markdownText": { "dark": "{{fg_text}}", "light": "{{fg_text}}" },
    "markdownHeading": { "dark": "{{fg_bright}}", "light": "{{fg_bright}}" },
    "markdownLink": { "dark": "{{link}}", "light": "{{link}}" },
    "markdownLinkText": { "dark": "{{accent}}", "light": "{{accent}}" },
    "markdownCode": { "dark": "{{warning}}", "light": "{{warning}}" },
    "markdownBlockQuote": { "dark": "{{fg_secondary}}", "light": "{{fg_secondary}}" },
    "markdownEmph": { "dark": "{{fg_text}}", "light": "{{fg_text}}" },
    "markdownStrong": { "dark": "{{fg_bright}}", "light": "{{fg_bright}}" },
    "markdownHorizontalRule": { "dark": "{{border_inactive}}", "light": "{{border_inactive}}" },
    "markdownListItem": { "dark": "{{accent}}", "light": "{{accent}}" },
    "markdownListEnumeration": { "dark": "{{accent}}", "light": "{{accent}}" },
    "markdownImage": { "dark": "{{link}}", "light": "{{link}}" },
    "markdownImageText": { "dark": "{{fg_secondary}}", "light": "{{fg_secondary}}" },
    "markdownCodeBlock": { "dark": "{{fg_editor}}", "light": "{{fg_editor}}" },
    "syntaxComment": { "dark": "{{fg_muted}}", "light": "{{fg_muted}}" },
    "syntaxKeyword": { "dark": "{{ansi12|mix:fg_text:0.25}}", "light": "{{ansi12|mix:fg_text:0.25}}" },
    "syntaxFunction": { "dark": "{{ansi11|mix:fg_text:0.35}}", "light": "{{ansi11|mix:fg_text:0.35}}" },
    "syntaxVariable": { "dark": "{{fg_editor}}", "light": "{{fg_editor}}" },
    "syntaxString": { "dark": "{{warning}}", "light": "{{warning}}" },
    "syntaxNumber": { "dark": "{{ansi10|mix:fg_text:0.35}}", "light": "{{ansi10|mix:fg_text:0.35}}" },
    "syntaxType": { "dark": "{{ansi14|mix:fg_text:0.25}}", "light": "{{ansi14|mix:fg_text:0.25}}" },
    "syntaxOperator": { "dark": "{{fg_text}}", "light": "{{fg_text}}" },
    "syntaxPunctuation": { "dark": "{{fg_secondary}}", "light": "{{fg_secondary}}" }
  }
}
