/* Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
   Shared Viewport (SGI CAD) GTK3/GTK4 color tokens imported by waybar and desktop overlays. */
@define-color vp_bar      {{vp_bar}};
@define-color vp_text     {{vp_text}};
@define-color vp_dim      {{vp_dim}};
@define-color vp_cyan     {{vp_cyan}};
@define-color vp_magenta  {{vp_magenta}};
@define-color vp_orange   {{vp_orange}};
@define-color vp_green    {{vp_green}};
@define-color vp_warn     {{vp_warn}};
@define-color vp_crit     {{vp_crit}};
@define-color vp_signal   {{vp_signal}};
@define-color vp_grid     {{vp_grid}};

/* translucent chrome & hover shades (pre-mixed for GTK3 + GTK4 portability) */
@define-color vp_border   {{vp_cyan|rgba:0.45}};
@define-color vp_rule     {{vp_cyan|rgba:0.7}};
@define-color vp_tick_maj {{vp_cyan|rgba:0.55}};
@define-color vp_tick_min {{vp_cyan|rgba:0.25}};
@define-color vp_hover    {{vp_cyan|rgba:0.14}};
@define-color vp_crit_bg  {{vp_crit|rgba:0.16}};
@define-color vp_trough   {{vp_cyan|rgba:0.22}};

/* 16-step energy CLUT */
@define-color vp_clut0    {{vp_clut0}};
@define-color vp_clut1    {{vp_clut1}};
@define-color vp_clut2    {{vp_clut2}};
@define-color vp_clut3    {{vp_clut3}};
@define-color vp_clut4    {{vp_clut4}};
@define-color vp_clut5    {{vp_clut5}};
@define-color vp_clut6    {{vp_clut6}};
@define-color vp_clut7    {{vp_clut7}};
@define-color vp_clut8    {{vp_clut8}};
@define-color vp_clut9    {{vp_clut9}};
@define-color vp_clut10   {{vp_clut10}};
@define-color vp_clut11   {{vp_clut11}};
@define-color vp_clut12   {{vp_clut12}};
@define-color vp_clut13   {{vp_clut13}};
@define-color vp_clut14   {{vp_clut14}};
@define-color vp_clut15   {{vp_clut15}};

/* menu selection */
@define-color vp_sel      {{selection_bg}};
@define-color vp_selfg    {{selection_fg}};
