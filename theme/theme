#!/usr/bin/env python3
"""theme: one palette drives every app's colors.

usage: theme list | current | lint
       theme init [NAME]                 render only (no reloads); used by link.sh
       theme set NAME [--to DIR]         render + run hooks/ (reload running apps)
       theme pick                        rofi menu of palettes -> set
       theme import-vscode SRC SLUG      VS Code theme JSON (file or URL) -> palettes/SLUG.toml
       theme import-omarchy SRC SLUG     Omarchy colors.toml -> palette
       theme import-base24 SRC SLUG      tinted-theming base16/base24 YAML -> palette
       theme install-greeter             render greeter art, then sudo-install it

Palettes (palettes/*.toml) hold semantic roles; templates/*.tmpl use {{role|filter}};
targets.toml maps each template to the file it renders (paths relative to the repo).
Stdlib only, so it runs on a bare Arch install with just `python`.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
PALETTES = HERE / "palettes"
TEMPLATES = HERE / "templates"
HOOKS = HERE / "hooks"
CURRENT = HERE / "current"
DEFAULT = "dark-2026"

ROLES = [
    "bg_desktop", "bg_surface", "bg_widget", "bg_hover", "border_hairline", "border_inactive",
    "fg_text", "fg_editor", "fg_secondary", "fg_muted", "fg_bright", "fg_disabled",
    "accent", "badge", "selection_bg", "selection_fg", "link",
    "error", "warning", "success", "shadow",
]
TERMINAL = ["fg", "bg", "cursor"]
ART = ["planet_light", "planet_dark", "ring_outer", "ring_inner"]
HEX = re.compile(r"#[0-9a-fA-F]{6}")


class ThemeError(Exception):
    pass


# ---------------------------------------------------------------- colors

def rgb(value, where=""):
    if not isinstance(value, str) or not HEX.fullmatch(value):
        raise ThemeError(f"{where}: expected #rrggbb, got {value!r}")
    return tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))


def to_hex(c):
    return "#" + "".join(f"{v:02x}" for v in c)


def mix(a, b, t):
    """Blend color a toward b by t (0 = a, 1 = b)."""
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def flatten(value, over):
    """#rrggbb or #rrggbbaa -> opaque rgb tuple composited over `over`."""
    v = value.strip()
    if re.fullmatch(r"#[0-9a-fA-F]{3,4}", v):  # VS Code allows #rgb / #rgba
        v = "#" + "".join(ch * 2 for ch in v[1:])
    if not re.fullmatch(r"#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?", v):
        raise ThemeError(f"unsupported color {value!r}")
    c = rgb(v[:7])
    if len(v) == 9:
        c = mix(over, c, int(v[7:9], 16) / 255)
    return c


# ---------------------------------------------------------------- palettes

def palette_names():
    return sorted(p.stem for p in PALETTES.glob("*.toml"))


def load_palette(slug):
    path = PALETTES / f"{slug}.toml"
    if not path.is_file():
        raise ThemeError(f"no palette {slug!r} (have: {', '.join(palette_names())})")
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as e:
        raise ThemeError(f"{path.name}: {e}") from None
    meta = data.get("meta", {})
    variant = meta.get("variant")
    if variant not in ("dark", "light"):
        raise ThemeError(f"{path.name}: meta.variant must be 'dark' or 'light'")
    colors, term, art = data.get("colors", {}), data.get("terminal", {}), data.get("art", {})
    missing = [r for r in ROLES if r not in colors] + [f"terminal.{k}" for k in TERMINAL if k not in term]
    if missing:
        raise ThemeError(f"{path.name}: missing {', '.join(missing)}")
    ansi = term.get("ansi", [])
    if len(ansi) != 16:
        raise ThemeError(f"{path.name}: terminal.ansi needs 16 colors, has {len(ansi)}")

    v = {r: rgb(colors[r], f"{path.name} colors.{r}") for r in ROLES}
    for k in TERMINAL:
        v[f"term_{k}"] = rgb(term[k], f"{path.name} terminal.{k}")
    for i, c in enumerate(ansi):
        v[f"ansi{i}"] = rgb(c, f"{path.name} terminal.ansi[{i}]")
    # greeter art is optional: imported palettes get it derived from their roles
    derived = {
        "planet_light": mix(v["link"], (255, 255, 255), 0.3),
        "planet_dark": mix(v["bg_desktop"], v["accent"], 0.15),
        "ring_outer": v["warning"],
        "ring_inner": mix(v["warning"], v["bg_desktop"], 0.2),
    }
    for k in ART:
        v[f"art_{k}"] = rgb(art[k], f"{path.name} art.{k}") if k in art else derived[k]

    dark = variant == "dark"
    words = {
        "name": meta.get("name", slug),
        "slug": slug,
        "variant": variant,
        "prefer_dark": "1" if dark else "0",
        "gtk_theme": "Adwaita-dark" if dark else "Adwaita",
        "color_scheme": "prefer-dark" if dark else "prefer-light",
    }
    return v, words


# ---------------------------------------------------------------- templates

TOKEN = re.compile(r"\{\{(.*?)\}\}")


def apply_filters(name, filters, colors, words, where):
    if name in words:
        if filters:
            raise ThemeError(f"{where}: {name!r} is not a color; filters not allowed")
        return words[name]
    if name not in colors:
        raise ThemeError(f"{where}: unknown role {name!r}")
    c = colors[name]
    fmt, arg = "hex", None
    for i, f in enumerate(filters):
        op, _, rest = f.partition(":")
        if op == "mix":
            other, _, t = rest.partition(":")
            if other not in colors:
                raise ThemeError(f"{where}: mix with unknown role {other!r}")
            try:
                c = mix(c, colors[other], float(t))
            except ValueError:
                raise ThemeError(f"{where}: mix amount {t!r} is not a number") from None
        elif op in ("hex", "bare", "0x", "rgb", "rgba"):
            if i != len(filters) - 1:
                raise ThemeError(f"{where}: format filter {op!r} must come last")
            fmt, arg = op, rest or None
        else:
            raise ThemeError(f"{where}: unknown filter {op!r}")
    if arg is not None and fmt in ("hex", "bare", "0x") and not re.fullmatch(r"[0-9a-fA-F]{2}", arg):
        raise ThemeError(f"{where}: alpha {arg!r} must be two hex digits")
    h = to_hex(c)[1:]
    if fmt == "hex":
        return f"#{h}{arg or ''}"
    if fmt == "bare":
        return f"{h}{arg or ''}"
    if fmt == "0x":
        return f"0x{h}{arg or 'ff'}"
    if fmt == "rgb":
        if arg:
            raise ThemeError(f"{where}: rgb takes no argument")
        return ", ".join(map(str, c))
    try:  # rgba
        a = float(arg)
    except (TypeError, ValueError):
        raise ThemeError(f"{where}: rgba needs an alpha like rgba:0.9") from None
    if not 0 <= a <= 1:
        raise ThemeError(f"{where}: rgba alpha must be 0-1")
    return f"rgba({', '.join(map(str, c))}, {arg})"


def render_template(path, colors, words):
    out = []
    for n, line in enumerate(path.read_text().splitlines(keepends=True), 1):
        def sub(m):
            parts = [p.strip() for p in m.group(1).split("|")]
            return apply_filters(parts[0], parts[1:], colors, words, f"{path.name}:{n}")
        out.append(TOKEN.sub(sub, line))
    return "".join(out)


def targets():
    data = tomllib.loads((HERE / "targets.toml").read_text())
    return data.get("target", [])


def render_all(slug, dest_root):
    """Render every target in memory first, then swap them all into place."""
    colors, words = load_palette(slug)
    rendered = []
    for t in targets():
        tmpl = TEMPLATES / t["template"]
        out = (dest_root / t["out"]).resolve()
        rendered.append((out, render_template(tmpl, colors, words), t.get("mode")))
    staged = []
    try:
        for out, text, mode in rendered:
            out.parent.mkdir(parents=True, exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=out.parent, prefix=f".{out.name}.")
            with os.fdopen(fd, "w") as f:
                f.write(text)
            os.chmod(tmp, int(mode, 8) if mode else 0o644)
            staged.append((tmp, out))
        for tmp, out in staged:
            os.replace(tmp, out)
    finally:
        for tmp, _ in staged:
            if os.path.exists(tmp):
                os.unlink(tmp)
    return words, [out for out, _, _ in rendered]


def run_hooks(words):
    hooks = sorted(h for h in HOOKS.glob("*") if h.is_file() and os.access(h, os.X_OK))
    env = dict(os.environ, THEME_NAME=words["name"], THEME_SLUG=words["slug"],
               THEME_VARIANT=words["variant"], THEME_ROOT=str(REPO))

    def run(h):
        try:
            p = subprocess.run([str(h)], env=env, capture_output=True, text=True, timeout=30)
            return h.name, p.returncode, (p.stderr or p.stdout).strip()
        except subprocess.TimeoutExpired:
            return h.name, -1, "timed out after 30s"

    with ThreadPoolExecutor() as pool:
        results = list(pool.map(run, hooks))
    failed = [r for r in results if r[1] != 0]
    for name, code, msg in failed:
        print(f"hook {name} failed ({code}): {msg}", file=sys.stderr)
    if failed:
        notify("Theme: some apps did not reload", ", ".join(r[0] for r in failed), urgent=True)
    return not failed


def notify(title, body, urgent=False):
    try:
        subprocess.run(["notify-send", "-a", "theme", *(["-u", "critical"] if urgent else []), title, body],
                       timeout=5, capture_output=True)
    except (OSError, subprocess.TimeoutExpired):
        pass


def current():
    try:
        return CURRENT.read_text().strip() or DEFAULT
    except FileNotFoundError:
        return DEFAULT


# ---------------------------------------------------------------- lint

LITERALS = [
    re.compile(r"#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?\b"),
    re.compile(r"\b0x[0-9a-fA-F]{8}\b"),
    re.compile(r"\brgba?\(\s*\d"),
    re.compile(r"=\s*[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?\s*$"),  # foot/swaylock bare hex
]
LINT_SKIP = ("theme/", "plans/")


def lint():
    files = subprocess.run(["git", "-C", str(REPO), "ls-files", "-co", "--exclude-standard"],
                           capture_output=True, text=True, check=True).stdout.split()
    hits = 0
    for f in files:
        if f.startswith(LINT_SKIP):
            continue
        try:
            text = (REPO / f).read_text()
        except (UnicodeDecodeError, FileNotFoundError, IsADirectoryError):
            continue
        for n, line in enumerate(text.splitlines(), 1):
            if any(p.search(line) for p in LITERALS):
                print(f"{f}:{n}: {line.strip()}")
                hits += 1
    print(f"{hits} color literal(s) outside theme/" if hits else "ok: no color literals outside theme/")
    return hits == 0


# ---------------------------------------------------------------- importers

def fetch(src):
    if re.match(r"https?://", src):
        with urllib.request.urlopen(src, timeout=20) as r:
            return r.read().decode()
    return Path(src).expanduser().read_text()


def sibling(src, rel):
    if re.match(r"https?://", src):
        return urllib.parse.urljoin(src, rel)
    return str(Path(src).expanduser().parent / rel)


def jsonc(text):
    text = re.sub(r'("(?:\\.|[^"\\])*")|//[^\n]*|/\*.*?\*/', lambda m: m.group(1) or "", text, flags=re.S)
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", text))


VSCODE_ANSI = {  # src/vs/workbench/contrib/terminal/common/terminalColorRegistry.ts
    "dark": ["#000000", "#cd3131", "#0dbc79", "#e5e510", "#2472c8", "#bc3fbc", "#11a8cd", "#e5e5e5",
             "#666666", "#f14c4c", "#23d18b", "#f5f543", "#3b8eea", "#d670d6", "#29b8db", "#e5e5e5"],
    "light": ["#000000", "#cd3131", "#107c10", "#949800", "#0451a5", "#bc05bc", "#0598bc", "#555555",
              "#666666", "#f14c4c", "#14ce14", "#b5ba00", "#3b8eea", "#d670d6", "#29b8db", "#a5a5a5"],
}
ANSI_KEYS = ["Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White"]


def import_vscode(src):
    chain, s = [], src
    while True:  # follow "include" back to the root theme
        d = jsonc(fetch(s))
        chain.insert(0, d)
        if not d.get("include"):
            break
        s = sibling(s, d["include"])
    c = {}
    for d in chain:
        c.update(d.get("colors", {}))
    top = chain[-1]
    variant = "light" if top.get("type") in ("light", "hc-light") else "dark"

    def pick(keys, over=None, default=None):
        for k in keys:
            if k in c and c[k]:
                return flatten(c[k], over or (0, 0, 0))
        if default is None:
            raise ThemeError(f"theme has none of {keys}")
        return default

    v, src_keys = {}, {}
    def role(name, keys, over=None, default=None):
        v[name] = pick(keys, over, default)
        src_keys[name] = next((k for k in keys if k in c), "derived")

    role("bg_desktop", ["editor.background"])
    role("bg_surface", ["statusBar.background", "panel.background", "sideBar.background"], v["bg_desktop"])
    role("bg_widget", ["quickInput.background", "notifications.background", "menu.background",
                       "editorWidget.background"], v["bg_surface"], v["bg_surface"])
    role("fg_text", ["foreground", "editor.foreground"], v["bg_surface"])
    role("bg_hover", ["statusBarItem.hoverBackground", "list.hoverBackground"], v["bg_surface"],
         mix(v["bg_surface"], v["fg_text"], 0.1))
    role("border_hairline", ["widget.border", "panel.border", "editorGroup.border"], v["bg_surface"],
         mix(v["bg_surface"], v["fg_text"], 0.08))
    role("border_inactive", ["input.border", "contrastBorder"], v["bg_surface"],
         mix(v["bg_surface"], v["fg_text"], 0.15))
    role("fg_editor", ["editor.foreground", "foreground"], v["bg_desktop"])
    role("fg_secondary", ["descriptionForeground", "statusBar.foreground"], v["bg_surface"],
         mix(v["fg_text"], v["bg_surface"], 0.3))
    role("fg_muted", ["editorLineNumber.foreground"], v["bg_desktop"], mix(v["fg_text"], v["bg_desktop"], 0.4))
    role("fg_bright", ["list.activeSelectionForeground"], v["bg_surface"], v["fg_text"])
    role("fg_disabled", ["disabledForeground"], v["bg_surface"], mix(v["fg_text"], v["bg_surface"], 0.6))
    # focusBorder often carries alpha: use its opaque hue rather than flattening it to grey
    if "tab.activeBorderTop" in c:
        role("accent", ["tab.activeBorderTop"], v["bg_surface"])
    else:
        role("accent", ["focusBorder", "button.background"], v["bg_surface"])
        if "focusBorder" in c:
            v["accent"] = flatten(c["focusBorder"][:7], (0, 0, 0))
    role("badge", ["badge.background"], v["bg_surface"], v["accent"])
    role("selection_bg", ["quickInputList.focusBackground", "list.activeSelectionBackground"], v["bg_widget"],
         v["accent"])
    role("selection_fg", ["quickInputList.focusForeground", "list.activeSelectionForeground"], v["selection_bg"],
         v["fg_bright"])
    role("link", ["textLink.foreground"], v["bg_desktop"], v["accent"])
    role("error", ["errorForeground", "editorError.foreground"], v["bg_desktop"])
    role("warning", ["list.warningForeground", "editorWarning.foreground"], v["bg_desktop"])
    role("success", ["gitDecoration.addedResourceForeground"], v["bg_desktop"], rgb(VSCODE_ANSI[variant][2]))
    v["shadow"], src_keys["shadow"] = (0, 0, 0), "constant"

    term = {
        "fg": pick(["terminal.foreground", "foreground"], v["bg_surface"]),
        "bg": pick(["terminal.background", "panel.background"], v["bg_desktop"], v["bg_surface"]),
        "cursor": pick(["terminalCursor.foreground", "foreground"], v["bg_surface"]),
    }
    ansi = []
    for i in range(16):
        key = f"terminal.ansi{'Bright' if i >= 8 else ''}{ANSI_KEYS[i % 8]}"
        ansi.append(pick([key], term["bg"], rgb(VSCODE_ANSI[variant][i])))
    meta = {"name": top.get("name", "imported"), "variant": variant, "source": f"vscode:{src}"}
    return meta, v, src_keys, term, ansi


def import_omarchy(src):
    d = tomllib.loads(fetch(src))
    g = lambda k, default=None: rgb(d[k], k) if k in d else default
    variant = "light" if d.get("mode") == "light" else "dark"
    fg, bg = g("foreground"), g("background")
    if fg is None or bg is None:
        raise ThemeError("Omarchy colors.toml needs at least foreground and background")
    v = {
        "bg_desktop": g("dark_background", mix(bg, (0, 0, 0), 0.2)),
        "bg_surface": bg,
        "bg_widget": g("lighter_background", mix(bg, fg, 0.06)),
        "fg_text": fg,
        "fg_editor": fg,
        "fg_bright": g("bright_foreground", fg),
        "fg_muted": g("dark_foreground", mix(fg, bg, 0.45)),
        "accent": g("accent", g("blue")),
    }
    if v["accent"] is None:
        raise ThemeError("Omarchy colors.toml needs accent or blue")
    v["bg_hover"] = mix(v["bg_widget"], fg, 0.08)
    v["border_hairline"] = mix(bg, fg, 0.08)
    v["border_inactive"] = g("muted", mix(bg, fg, 0.18))
    v["fg_secondary"] = g("light_foreground", mix(fg, bg, 0.25)) if variant == "light" else mix(fg, bg, 0.25)
    v["fg_disabled"] = mix(fg, bg, 0.6)
    v["badge"] = mix(v["accent"], bg, 0.15)
    v["selection_bg"] = g("selection", mix(v["accent"], bg, 0.35))
    v["selection_fg"] = v["fg_bright"]
    v["link"] = g("cyan", v["accent"])
    v["error"] = g("red", (0xcd, 0x31, 0x31))
    v["warning"] = g("yellow", g("orange", (0xe5, 0xba, 0x7d)))
    v["success"] = g("green", (0x73, 0xc9, 0x91))
    v["shadow"] = (0, 0, 0)
    names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    base = VSCODE_ANSI[variant]
    ansi = []
    for i in range(16):
        explicit = d.get(f"color{i}")
        named = f"{'bright_' if i >= 8 else ''}{names[i % 8]}"
        ansi.append(rgb(explicit, f"color{i}") if explicit else g(named, rgb(base[i])))
    term = {"fg": fg, "bg": bg, "cursor": g("cursor", fg)}
    meta = {"name": d.get("name", Path(src).parent.name or "imported"), "variant": variant, "source": f"omarchy:{src}"}
    return meta, v, {k: "omarchy" for k in v}, term, ansi


def import_base24(src):
    text = fetch(src)
    pal = {k.lower(): "#" + h.lower() for k, h in
           re.findall(r"\b(base[0-9A-Fa-f]{2})\s*:\s*[\"']?#?([0-9a-fA-F]{6})", text)}
    top = dict(re.findall(r"^(name|variant|system)\s*:\s*[\"']?([^\"'\n]+)", text, flags=re.M))
    need = [f"base0{x}" for x in "0123456789abcdef"]
    if any(k not in pal for k in need):
        raise ThemeError(f"not a base16/base24 scheme (missing {[k for k in need if k not in pal]})")
    b = {k: rgb(x) for k, x in pal.items()}
    variant = top.get("variant", "dark").strip()
    variant = "light" if variant == "light" else "dark"
    # base16 has no base10-17: derive darker backgrounds and reuse normal hues for "bright"
    b.setdefault("base10", mix(b["base00"], (0, 0, 0) if variant == "dark" else (255, 255, 255), 0.25))
    for k, src_k in {"base12": "base08", "base13": "base0a", "base14": "base0b", "base15": "base0c",
                     "base16": "base0d", "base17": "base0e"}.items():
        b.setdefault(k, b[src_k])
    v = {
        "bg_desktop": b["base10"], "bg_surface": b["base00"], "bg_widget": b["base01"],
        "bg_hover": b["base02"], "border_hairline": mix(b["base01"], b["base02"], 0.5),
        "border_inactive": b["base02"], "fg_text": b["base05"], "fg_editor": b["base05"],
        "fg_secondary": b["base04"], "fg_muted": b["base03"], "fg_bright": b["base06"],
        "fg_disabled": mix(b["base03"], b["base00"], 0.4), "accent": b["base0d"],
        "badge": mix(b["base0d"], b["base00"], 0.15), "selection_bg": mix(b["base0d"], b["base00"], 0.25),
        "selection_fg": b["base07"] if variant == "dark" else b["base00"], "link": b["base0c"],
        "error": b["base08"], "warning": b["base0a"], "success": b["base0b"], "shadow": (0, 0, 0),
    }
    # tinted-theming base24 terminal mapping
    order = ["base01", "base08", "base0b", "base0a", "base0d", "base0e", "base0c", "base06",
             "base02", "base12", "base14", "base13", "base16", "base17", "base15", "base07"]
    ansi = [b[k] for k in order]
    term = {"fg": b["base05"], "bg": b["base00"], "cursor": b["base05"]}
    meta = {"name": top.get("name", "imported").strip(), "variant": variant, "source": f"base24:{src}"}
    return meta, v, {k: "base24" for k in v}, term, ansi


def write_palette(slug, meta, v, src_keys, term, ansi):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
        raise ThemeError(f"slug {slug!r}: use lowercase letters, digits and dashes")
    q = lambda s: json.dumps(s)  # TOML basic strings are JSON-compatible for our values
    lines = [f"# Imported with `theme import-*` from {meta['source']}", "", "[meta]",
             f"name = {q(meta['name'])}", f"variant = {q(meta['variant'])}", f"source = {q(meta['source'])}",
             "", "[colors]"]
    for r in ROLES:
        lines.append(f"{r:<15} = \"{to_hex(v[r])}\"  # {src_keys.get(r, 'derived')}")
    lines += ["", "[terminal]"] + [f"{k:<6} = \"{to_hex(term[k])}\"" for k in TERMINAL]
    lines += ["ansi = ["]
    for row in (ansi[:8], ansi[8:]):
        lines.append("\t" + ", ".join(f'"{to_hex(c)}"' for c in row) + ",")
    lines += ["]", ""]
    out = PALETTES / f"{slug}.toml"
    out.write_text("\n".join(lines))
    load_palette(slug)  # validate what we wrote
    return out


# ---------------------------------------------------------------- greeter

GREETER_HOME = Path("/var/lib/greeter")


def install_greeter():
    if os.geteuid() == 0:
        raise ThemeError("run as your user; it calls sudo itself (art is rendered as you)")
    g = REPO / "greeter"
    toml = g / "themes" / "mango.toml"
    if not toml.exists():
        raise ThemeError("greeter/themes/mango.toml missing: run `theme init` first")
    subprocess.run([str(g / "make-wallpaper.sh")], check=True)
    wall = g / "wallpapers" / "sysc-greet-mango.png"
    prefs = GREETER_HOME / ".cache/sysc-greet/preferences"
    script = f"""set -e
install -Dm644 -o greeter -g greeter {q_sh(toml)} {GREETER_HOME}/.config/sysc-greet/themes/mango.toml
install -Dm644 {q_sh(wall)} /usr/share/sysc-greet/wallpapers/sysc-greet-mango.png
# one-time move from the old fixed theme name to the stable "Mango" theme
if [ -f {prefs} ] && grep -q '"theme": *"Dark 2026"' {prefs}; then
	sed -i 's/"theme": *"Dark 2026"/"theme": "Mango"/' {prefs}
fi
"""
    subprocess.run(["sudo", "sh", "-c", script], check=True)
    print("greeter: installed Mango theme + wallpaper")


def q_sh(p):
    return "'" + str(p).replace("'", "'\\''") + "'"


# ---------------------------------------------------------------- cli

def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("help", [])
    if cmd in ("help", "-h", "--help"):
        print(__doc__.strip())
    elif cmd == "list":
        cur = current()
        for n in palette_names():
            print(("* " if n == cur else "  ") + n)
    elif cmd == "current":
        print(current())
    elif cmd == "lint":
        return 0 if lint() else 1
    elif cmd in ("init", "set"):
        to = None
        if "--to" in args:
            i = args.index("--to")
            if i + 1 >= len(args):
                raise ThemeError("--to needs a directory")
            to = Path(args[i + 1]).expanduser()
            args = args[:i] + args[i + 2:]
        if cmd == "set" and not args:
            raise ThemeError("usage: theme set NAME")
        slug = args[0] if args else current()
        words, outs = render_all(slug, to or REPO)
        if to:
            print(f"rendered {len(outs)} files for {slug} into {to}")
            return 0
        CURRENT.write_text(slug + "\n")
        print(f"{words['name']}: rendered {len(outs)} files")
        if cmd == "set":
            ok = run_hooks(words)
            notify("Theme", words["name"])
            return 0 if ok else 1
    elif cmd == "pick":
        names = palette_names()
        p = subprocess.run(["rofi", "-dmenu", "-i", "-p", "theme", "-selected-row",
                            str(names.index(current()) if current() in names else 0)],
                           input="\n".join(names), capture_output=True, text=True)
        if p.returncode != 0 or not p.stdout.strip():
            return 0
        return main(["set", p.stdout.strip()])
    elif cmd in ("import-vscode", "import-omarchy", "import-base24"):
        if len(args) != 2:
            raise ThemeError(f"usage: theme {cmd} SRC SLUG")
        fn = {"import-vscode": import_vscode, "import-omarchy": import_omarchy,
              "import-base24": import_base24}[cmd]
        print(write_palette(args[1], *fn(args[0])))
    elif cmd == "install-greeter":
        install_greeter()
    else:
        raise ThemeError(f"unknown command {cmd!r} (see `theme help`)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except ThemeError as e:
        print(f"theme: {e}", file=sys.stderr)
        sys.exit(2)
    except (OSError, subprocess.CalledProcessError, urllib.error.URLError, json.JSONDecodeError) as e:
        print(f"theme: {e}", file=sys.stderr)
        sys.exit(1)
