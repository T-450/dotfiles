#!/usr/bin/env bash
# nightlight [status|toggle|menu]: wlsunset as the bar's night light.
#   status  JSON for waybar's custom/nightlight (text, class auto|warm|off, tooltip)
#   toggle  off <-> on (the last mode); off persists across logins
#   menu    rofi: automatic / warm now / off, and the night temperature
# Choices live in ~/.local/state/nightlight/: `env` (MODE, NIGHT_TEMP) is read by wlsunset.service;
# `off` keeps the unit from starting (ConditionPathExists).
set -euo pipefail
state=${XDG_STATE_HOME:-$HOME/.local/state}/nightlight
env=$state/env
off=$state/off
unit=wlsunset.service
temps=(3000 3500 4000 4500)

MODE=auto NIGHT_TEMP=3500
[[ -r $env ]] && . "$env"

save() {
	mkdir -p "$state"
	printf 'MODE=%s\nNIGHT_TEMP=%s\n# wlsunset needs day > night: "warm" pins day one kelvin above night\nDAY_TEMP=%s\n' \
		"$MODE" "$NIGHT_TEMP" "$([[ $MODE == warm ]] && echo $((NIGHT_TEMP + 1)) || echo 6500)" >"$env"
}

refresh() { pkill -RTMIN+9 -x waybar || true; }

turn_on() {
	rm -f "$off"
	systemctl --user restart "$unit"
}

turn_off() {
	mkdir -p "$state"
	: >"$off"
	systemctl --user stop "$unit"
}

status() {
	local text class tip
	if [[ -e $off ]] || ! systemctl --user -q is-active "$unit"; then
		text=󰖙 class=off tip="Off"
	elif [[ $MODE == warm ]]; then
		text=󰖔 class=warm tip="Warm now · ${NIGHT_TEMP} K"
	else
		text=󰖔 class=auto tip="Automatic · ${NIGHT_TEMP} K after sunset"
	fi
	# the design's tooltip line (dim name, value, dim hint); single quotes keep the JSON unescaped
	local name="<span font_desc='Terminess Nerd Font 12px' letter_spacing='1024' fgalpha='60%'>NIGHT LIGHT</span>"
	local hint="<span font_desc='Terminess Nerd Font 12px' letter_spacing='0' fgalpha='60%'>Click toggles · Right-click options</span>"
	printf '{"text":"%s","class":"%s","tooltip":"%s  %s\\n%s"}\n' "$text" "$class" "$name" "$tip" "$hint"
}

menu() {
	local cur=auto rows=() t pick mark
	[[ -e $off ]] && cur=off || cur=$MODE
	mark() { [[ $1 == "$2" ]] && printf '● ' || printf '  '; }
	rows+=(
		"$(mark "$cur" auto)Automatic: warm after sunset"
		"$(mark "$cur" warm)Warm now"
		"$(mark "$cur" off)Off"
	)
	for t in "${temps[@]}"; do
		rows+=("$(mark "$NIGHT_TEMP" "$t")Night temperature ${t} K")
	done
	pick=$(printf '%s\n' "${rows[@]}" | walker --dmenu -p "NIGHT LIGHT") || exit 0
	pick=${pick#● }
	pick=${pick#  }
	case $pick in
	"Automatic: warm after sunset") MODE=auto && save && turn_on ;;
	"Warm now") MODE=warm && save && turn_on ;;
	"Off") turn_off ;;
	"Night temperature "*" K")
		t=${pick#Night temperature }
		NIGHT_TEMP=${t% K}
		save
		[[ -e $off ]] || turn_on
		;;
	esac
}

case ${1:-status} in
status) status ;;
toggle) if [[ -e $off ]] || ! systemctl --user -q is-active "$unit"; then save && turn_on; else turn_off; fi && refresh ;;
menu) menu && refresh ;;
*) echo "usage: nightlight [status|toggle|menu]" >&2 && exit 2 ;;
esac
