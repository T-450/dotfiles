[Unit]
Description=Wallpaper (swaybg)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# solid desktop color from the active palette (theme/colors.sh, rendered by theme/theme)
EnvironmentFile=%h/.config/mango/theme/colors.sh
ExecStart=/usr/bin/swaybg -c ${THEME_BG_DESKTOP}
Restart=on-failure

[Install]
WantedBy=graphical-session.target
