/* Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit. */
/* Tabs (ctrl+shift+t) in Viewport CAD style, mirroring waybar's window strip: 0px vp_bar ground,
   Terminess pixel type, dim inactive, crisp text bold + 1px signal underline active, cyan 14%
   hover. Loaded by config.ghostty (gtk-custom-css); `theme set` reloads it with the config. */
tabbar .box {
	padding: 0;
	background: {{vp_bar}};
	box-shadow: inset 0 -1px 0 {{vp_cyan|rgba:0.45}};
}
tabbar tabbox {
	min-height: 26px;
	padding: 0;
}
tabbar .start-action,
tabbar .end-action {
	padding: 0;
}
tabbar tabbox > tabboxchild {
	border-radius: 0;
}
tabbar tabbox > separator {
	margin: 0;
	opacity: 0;
}
tabbar tab {
	min-height: 26px;
	padding: 0 8px;
	border-radius: 0;
	background: {{vp_bar}};
	color: {{vp_dim}};
	font-family: "Terminess Nerd Font";
	font-size: 14px;
	letter-spacing: 1px;
}
tabbar tab:hover {
	background: {{vp_cyan|rgba:0.14}};
	color: {{vp_text}};
	box-shadow: inset 0 -1px 0 {{vp_cyan}};
}
tabbar tab:selected {
	background: {{vp_bar}};
	color: {{vp_text}};
	font-weight: bold;
	box-shadow: inset 0 -1px 0 {{vp_signal}};
}
tabbar tab button.image-button {
	min-width: 18px;
	min-height: 18px;
}
