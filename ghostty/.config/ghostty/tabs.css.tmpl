/* Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit. */
/* Tabs (ctrl+shift+t) as square segments one cell tall, in the terminal's font, like the bar: the
   selected one in the accent. Overrides libadwaita's tab bar (rounded, 34 px pills). Loaded by
   config.ghostty (gtk-custom-css); `theme set` reloads it with the config. */
tabbar .box {
	padding: 5px 0 0;
	background: {{bg_surface}};
	box-shadow: none;
}
tabbar tabbox {
	min-height: 22px;
	padding: 0;
}
tabbar .start-action,
tabbar .end-action {
	padding: 0;
}
tabbar tabbox > tabboxchild {
	border-radius: 0;
}
tabbar tabbox > separator {
	margin: 0;
	opacity: 0;
}
tabbar tab {
	min-height: 22px;
	padding: 0 4px;
	border-radius: 0;
	background: {{bg_hover}};
	color: {{fg_secondary|legible:bg_hover}};
	font-family: "JetBrainsMono Nerd Font";
	font-size: 12pt;
}
tabbar tab:selected {
	background: {{accent}};
	color: {{accent|ink}};
	font-weight: bold;
}
tabbar tab button.image-button {
	min-width: 18px;
	min-height: 18px;
}
