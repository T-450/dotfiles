# btop's theme from the active palette ({{name}}): theme renders mango.theme from this file
# boxes in fg_muted: the border roles sit at 1-2:1 on term_bg, too faint for btop's only structure
theme[main_bg]="{{term_bg}}"
theme[main_fg]="{{fg_text}}"
theme[title]="{{fg_bright}}"
theme[hi_fg]="{{accent|legible:term_bg}}"
theme[selected_bg]="{{selection_bg}}"
theme[selected_fg]="{{selection_fg}}"
theme[inactive_fg]="{{fg_disabled}}"
theme[graph_text]="{{fg_secondary|legible:term_bg}}"
theme[meter_bg]="{{fg_muted|mix:term_bg:0.5}}"
theme[proc_misc]="{{info|legible:term_bg}}"
theme[cpu_box]="{{fg_muted}}"
theme[mem_box]="{{fg_muted}}"
theme[net_box]="{{fg_muted}}"
theme[proc_box]="{{fg_muted}}"
theme[div_line]="{{fg_muted|mix:term_bg:0.4}}"
theme[proc_pause_bg]="{{warning|mix:term_bg:0.9}}"
theme[proc_follow_bg]="{{accent|mix:term_bg:0.9}}"
theme[proc_banner_bg]="{{bg_widget}}"
theme[proc_banner_fg]="{{fg_bright}}"
theme[followed_bg]="{{accent}}"
theme[followed_fg]="{{accent|ink}}"

# gradients run from the role mixed halfway into the background to the role itself: load and
# heat in success, warning, error; memory in info (free), link (cached), success (available)
theme[temp_start]="{{success|legible:term_bg}}"
theme[temp_mid]="{{warning|legible:term_bg}}"
theme[temp_end]="{{error|legible:term_bg}}"
theme[cpu_start]="{{success|legible:term_bg}}"
theme[cpu_mid]="{{warning|legible:term_bg}}"
theme[cpu_end]="{{error|legible:term_bg}}"
theme[process_start]="{{success|legible:term_bg}}"
theme[process_mid]="{{warning|legible:term_bg}}"
theme[process_end]="{{error|legible:term_bg}}"
theme[used_start]="{{warning|mix:term_bg:0.5}}"
theme[used_mid]="{{warning|legible:term_bg}}"
theme[used_end]="{{error|legible:term_bg}}"
theme[free_start]="{{info|mix:term_bg:0.5}}"
theme[free_mid]="{{info|mix:term_bg:0.25}}"
theme[free_end]="{{info|legible:term_bg}}"
theme[cached_start]="{{link|mix:term_bg:0.5}}"
theme[cached_mid]="{{link|mix:term_bg:0.25}}"
theme[cached_end]="{{link|legible:term_bg}}"
theme[available_start]="{{success|mix:term_bg:0.5}}"
theme[available_mid]="{{success|mix:term_bg:0.25}}"
theme[available_end]="{{success|legible:term_bg}}"
theme[download_start]="{{success|mix:term_bg:0.5}}"
theme[download_mid]="{{success|mix:term_bg:0.25}}"
theme[download_end]="{{success|legible:term_bg}}"
theme[upload_start]="{{accent|mix:term_bg:0.5}}"
theme[upload_mid]="{{accent|mix:term_bg:0.25}}"
theme[upload_end]="{{accent|legible:term_bg}}"
