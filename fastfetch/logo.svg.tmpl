<!-- Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
     fastfetch's logo: a λ in the palette's bright green (ansi10: the shell prompt's and the bar's λ),
     rasterized to .config/fastfetch/logo.png by fastfetch/render.sh.

     Drawn on the logo's 34x22 terminal cells at 10x22.5 units a cell: the terminal fits the picture
     to the cells, and Lilex's are 10x22 px at 12 pt and 10x23 px at 13 pt, so the middle keeps the
     stretch at 2% either way. One 36-unit stroke with round ends. The stem falls at 67° and curves
     in from a level start and out to a level end, the same curve turned half around the middle of
     the canvas; the leg leaves it 46% of the way down at the mirrored angle and passes under it
     (the mask cuts a 6-unit gap around the stem). The stem's color runs from ansi10 toward ansi14,
     the leg is the status green in the stem's shadow, and both glow faintly: 10% once render.sh
     has cut the glow's tail, since Ghostty blends in linear light, where a light glow on a dark
     ground reads stronger. Around the same middle an orbit runs from the accent at its one
     satellite into the border tone and fades out. -->
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 340 495">
	<defs>
		<path id="stem" d="M38.5 46Q84.5 46 102.4 88.3L237.6 406.7Q255.5 449 301.5 449"/>
		<path id="leg" d="M163.2 231.4L70.8 449"/>
		<linearGradient id="lit" gradientUnits="userSpaceOnUse" x1="84.5" y1="46" x2="255.5" y2="449">
			<stop offset="0" stop-color="{{ansi10}}"/>
			<stop offset="1" stop-color="{{ansi10|mix:ansi14:0.55}}"/>
		</linearGradient>
		<linearGradient id="shade" gradientUnits="userSpaceOnUse" x1="163.2" y1="231.4" x2="70.8" y2="449">
			<stop offset="0.12" stop-color="{{success|mix:term_bg:0.5}}"/>
			<stop offset="1" stop-color="{{success|mix:term_bg:0.1}}"/>
		</linearGradient>
		<linearGradient id="orbit" gradientUnits="userSpaceOnUse" x1="288.2" y1="155.2" x2="51.8" y2="339.8">
			<stop offset="0" stop-color="{{border_inactive|mix:accent:0.6}}"/>
