// Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
// fastfetch: the λ (logo.png, rasterized by fastfetch/render.sh from logo.svg.tmpl) beside the system
// summary in three groups, after the "groups" preset of LierB/fastfetch: a group is a bold label
// with its members on a tree under it. The label and its icons share one syntax color (keyword,
// constant, special); the tree and the bars' tracks are the border tone, the label's own value is
// bright and the rest the text color. Icons are Nerd Font Material Design glyphs (nf-md-*), named
// above each key. Comments stand on their own lines: tests/unit.d/configs-test.sh strips only those.
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		// kitty-direct: the terminal reads the PNG itself and fits it to the cell box below, so the
		// λ sits on the same rows in every window. "kitty" has fastfetch scale it from the window's
		// pixel size per cell, which Ghostty reports with the window's leftover padding included
		// (23.5 px rows instead of 23): the picture then covers part of one more row, and the
		// summary starts a row lower in some windows and not in others.
		"type": "kitty-direct",
		"source": "~/.config/fastfetch/logo.png",
		// the cell box logo.svg.tmpl is drawn on: the summary's 19 rows with a blank row above and
		// below, and the picture's own side margins
		"width": 34,
		"height": 21,
		"padding": {
			"top": 0,
			"left": 0,
			"right": 2
		}
	},
	"display": {
		// keys are five columns wide (a label, or the tree, an icon and a space)
		"separator": " ",
		// a window too narrow for a line clips it instead of wrapping it under the logo
		"disableLinewrap": true,
		"color": {
			// the tree; each key colors its own label or icon
			"keys": "{{border_inactive}}",
			"output": "{{fg_text}}"
		},
		"bar": {
			"width": 8,
			"char": {
				"elapsed": "■",
				"total": "■"
			},
			"border": {
				"left": "",
				"right": ""
			},
			"color": {
				"total": "{{border_inactive}}"
			}
		},
		"percent": {
			"type": ["bar", "num"],
			"color": {
				"green": "{{success|legible:term_bg}}",
				"yellow": "{{warning|legible:term_bg}}",
				"red": "{{error|legible:term_bg}}"
			}
		}
	},
	"modules": [
		// a blank first row: the summary starts where the λ does
		"break",
		{
			"type": "os",
			"outputColor": "{{fg_bright}}",
			"key": "{#{{syn_keyword|legible:term_bg}}}OS   ",
			"format": "{pretty-name} {arch}"
		},
		{
			"type": "title",
			// nf-md-account
			"key": "├─ {#{{syn_keyword|legible:term_bg}}}󰀄 ",
			"format": "{user-name}@{host-name}"
		},
		{
			"type": "kernel",
			// nf-md-linux
			"key": "├─ {#{{syn_keyword|legible:term_bg}}}󰌽 ",
			"format": "{release}"
		},
		{
			"type": "packages",
			// nf-md-package_variant
			"key": "├─ {#{{syn_keyword|legible:term_bg}}}󰏖 "
		},
		{
			"type": "shell",
			// nf-md-console_line
			"key": "╰─ {#{{syn_keyword|legible:term_bg}}}󰞷 "
		},
		"break",
		{
			"type": "wm",
			"outputColor": "{{fg_bright}}",
			"key": "{#{{syn_constant|legible:term_bg}}}WM   "
		},
		{
			"type": "terminal",
			// nf-md-console
			"key": "├─ {#{{syn_constant|legible:term_bg}}}󰆍 "
		},
		{
			"type": "terminalfont",
			// nf-md-format_letter_case
			"key": "├─ {#{{syn_constant|legible:term_bg}}}󰬴 "
		},
		{
			// the active palette
			"type": "custom",
			// nf-md-palette
			"key": "╰─ {#{{syn_constant|legible:term_bg}}}󰏘 ",
			"format": "{{name}}"
		},
		"break",
		{
			"type": "host",
			"outputColor": "{{fg_bright}}",
			"key": "{#{{syn_special|legible:term_bg}}}PC   ",
			// the model's name (ThinkPad T14 Gen 1), else its number
			"format": "{?family}{family}{?}{/family}{name}{/}"
		},
		{
			"type": "cpu",
			// nf-md-memory (Material Design's name for the plain processor chip)
			"key": "├─ {#{{syn_special|legible:term_bg}}}󰍛 ",
			"format": "{name} ({cores-logical})"
		},
		{
			"type": "gpu",
			// nf-md-expansion_card
			"key": "├─ {#{{syn_special|legible:term_bg}}}󰢮 ",
			"format": "{name}"
		},
		{
			"type": "memory",
			// nf-md-chip
			"key": "├─ {#{{syn_special|legible:term_bg}}}󰘚 ",
			"format": "{percentage-bar} {used} / {total}"
		},
		{
			"type": "disk",
			// nf-md-harddisk
			"key": "├─ {#{{syn_special|legible:term_bg}}}󰋊 ",
			"folders": "/",
			"format": "{size-percentage-bar} {size-used} / {size-total}"
		},
		{
			"type": "battery",
			// nf-md-battery
			"key": "├─ {#{{syn_special|legible:term_bg}}}󰁹 ",
			"format": "{capacity-bar} {capacity} {status}"
		},
		{
			"type": "uptime",
			// nf-md-timer_outline
			"key": "╰─ {#{{syn_special|legible:term_bg}}}󰔛 "
		},
		"break",
		{
			"type": "colors",
			"symbol": "circle"
		},
		// room between the λ and the prompt
		"break"
	]
}
