// Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
// fastfetch: perler-bead Godzilla (fastfetch/logo.png, drawn as sixel by foot) beside
// a short system summary. Text colors come from the palette; the logo keeps its own.
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "sixel",
		"source": "~/.config/fastfetch/logo.png",
		// width only: with both set fastfetch stretched the image ~2x vertically in foot
		"width": 24,
		"padding": {
			"top": 1,
			"left": 2,
			"right": 4
		}
	},
	"display": {
		"separator": "  ",
		"color": {
			"keys": "{{accent}}",
			"title": "{{fg_bright}}",
			"output": "{{fg_text}}",
			"separator": "{{fg_muted}}"
		},
		"key": {
			"type": "both-2",
			"width": 14
		},
		"bar": {
			"width": 12,
			"char": {
				"elapsed": "■",
				"total": "■"
			},
			"border": {
				"left": "",
				"right": ""
			},
			"color": {
				"total": "{{border_inactive}}"
			}
		},
		"percent": {
			"type": ["bar", "num"],
			"color": {
				"green": "{{success}}",
				"yellow": "{{warning}}",
				"red": "{{error}}"
			}
		}
	},
	"modules": [
		"break",
		{
			"type": "title",
			"format": "{user-name}@{host-name}"
		},
		{
			"type": "custom",
			"format": "──────────────────────────────────────",
			"outputColor": "{{fg_disabled}}"
		},
		{
			"type": "os",
			"key": "os",
			"format": "{pretty-name} {arch}"
		},
		{
			"type": "kernel",
			"key": "kernel"
		},
		{
			"type": "packages",
			"key": "packages"
		},
		{
			"type": "wm",
			"key": "wm"
		},
		{
			"type": "terminal",
			"key": "terminal"
		},
		{
			"type": "shell",
			"key": "shell"
		},
		{
			"type": "custom",
			"format": "──────────────────────────────────────",
			"outputColor": "{{fg_disabled}}"
		},
		{
			"type": "cpu",
			"key": "cpu",
			"format": "{name} ({cores-logical})"
		},
		{
			"type": "gpu",
			"key": "gpu",
			"format": "{name}"
		},
		{
			"type": "memory",
			"key": "memory"
		},
		{
			"type": "disk",
			"key": "disk",
			"folders": "/"
		},
		{
			"type": "battery",
			"key": "battery"
		},
		{
			"type": "uptime",
			"key": "uptime"
		},
		"break",
		{
			"type": "colors",
			"symbol": "circle",
			"paddingLeft": 2
		}
	]
}
