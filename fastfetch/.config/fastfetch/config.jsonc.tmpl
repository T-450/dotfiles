// Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
// fastfetch: Godzilla (logo.png, made by fastfetch/render.sh and drawn by kitty's graphics
// protocol) beside a short system summary in the palette's colors.
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "kitty",
		"source": "~/.config/fastfetch/logo.png",
		// the exact cell box render.sh sizes the image for (260x374 px at kitty's 10x22 px cells),
		// so nothing rescales it; it spans the title down to the color dots
		"width": 26,
		"height": 17,
		"padding": {
			"top": 1,
			"left": 2,
			"right": 3
		}
	},
	"display": {
		"separator": "  ",
		// a window too narrow for a line clips it instead of wrapping it under the logo
		"disableLinewrap": true,
		"color": {
			"keys": "{{accent}}",
			"title": "{{fg_bright}}",
			"output": "{{fg_text}}",
			"separator": "{{fg_muted}}"
		},
		"key": {
			"type": "both-2",
			"width": 14
		},
		"bar": {
			"width": 8,
			"char": {
				"elapsed": "■",
				"total": "■"
			},
			"border": {
				"left": "",
				"right": ""
			},
			"color": {
				"total": "{{border_inactive}}"
			}
		},
		"percent": {
			"type": ["bar", "num"],
			"color": {
				"green": "{{success}}",
				"yellow": "{{warning}}",
				"red": "{{error}}"
			}
		}
	},
	"modules": [
		// a blank first row lines the title up with the logo's top (its padding.top)
		"break",
		{
			"type": "title",
			"format": "{user-name}@{host-name}",
			"color": {
				"user": "{{accent}}",
				"at": "{{fg_muted}}",
				"host": "{{fg_bright}}"
			}
		},
		{
			"type": "separator",
			"string": "─",
			"outputColor": "{{border_inactive}}"
		},
		{
			"type": "os",
			"key": "os",
			"format": "{pretty-name} {arch}"
		},
		{
			"type": "kernel",
			"key": "kernel"
		},
		{
			"type": "packages",
			"key": "packages"
		},
		{
			"type": "wm",
			"key": "wm"
		},
		{
			"type": "terminal",
			"key": "terminal"
		},
		{
			"type": "shell",
			"key": "shell"
		},
		"break",
		// hardware in the palette's purple, as on the bar
		{
			"type": "cpu",
			"key": "cpu",
			"keyColor": "{{ansi13}}",
			"format": "{name} ({cores-logical})"
		},
		{
			"type": "gpu",
			"key": "gpu",
			"keyColor": "{{ansi13}}",
			"format": "{name}"
		},
		{
			"type": "memory",
			"key": "memory",
			"keyColor": "{{ansi13}}",
			"format": "{percentage-bar} {used} / {total}"
		},
		{
			"type": "disk",
			"key": "disk",
			"keyColor": "{{ansi13}}",
			"folders": "/",
			"format": "{size-percentage-bar} {size-used} / {size-total}"
		},
		{
			"type": "battery",
			"key": "battery",
			"keyColor": "{{ansi13}}",
			"format": "{capacity-bar} {capacity} {status}"
		},
		{
			"type": "uptime",
			"key": "uptime",
			"keyColor": "{{ansi13}}"
		},
		"break",
		{
			"type": "colors",
			"symbol": "circle"
		},
		// room between the logo and the prompt
		"break"
	]
}
