{
	"$schema": "https://pi.dev/schemas/theme.schema.json",
	"name": "{{slug}}",
	"appearance": "{{variant}}",
	"colors": {
		"accent": "{{accent}}",
		"border": "{{fg_muted}}",
		"borderAccent": "{{accent}}",
		"borderMuted": "{{border_inactive}}",
		"success": "{{success}}",
		"error": "{{error}}",
		"warning": "{{warning}}",
		"muted": "{{fg_secondary}}",
		"dim": "{{fg_muted}}",
		"text": "{{fg_text}}",
		"thinkingText": "{{fg_secondary}}",
		"selectedBg": "{{selection_bg}}",
		"scrollbarTrack": "{{border_hairline}}",
		"scrollbarThumb": "{{fg_muted}}",
		"searchMatchBg": "{{term_bg|mix:warning:0.25}}",
		"searchMatchText": "{{fg_bright}}",
		"userMessageBg": "{{term_bg|mix:accent:0.14}}",
		"userMessageText": "{{fg_text}}",
		"customMessageBg": "{{term_bg|mix:ansi5:0.14}}",
		"customMessageText": "{{fg_secondary}}",
		"customMessageLabel": "{{ansi5|legible:term_bg}}",
		"toolPendingBg": "{{term_bg|mix:fg_muted:0.12}}",
		"toolSuccessBg": "{{term_bg|mix:success:0.14}}",
		"toolErrorBg": "{{term_bg|mix:error:0.14}}",
		"toolTitle": "{{fg_bright}}",
		"toolOutput": "{{fg_secondary}}",
		"mdHeading": "{{fg_bright}}",
		"mdLink": "{{link}}",
		"mdLinkUrl": "{{fg_muted}}",
		"mdCode": "{{warning}}",
		"mdCodeBlock": "{{fg_editor}}",
		"mdCodeBlockBorder": "{{border_inactive}}",
		"mdQuote": "{{fg_secondary}}",
		"mdQuoteBorder": "{{border_inactive}}",
		"mdHr": "{{border_inactive}}",
		"mdListBullet": "{{accent}}",
		"toolDiffAdded": "{{success}}",
		"toolDiffRemoved": "{{error}}",
		"toolDiffContext": "{{fg_secondary}}",
		"syntaxComment": "{{fg_muted}}",
		"syntaxKeyword": "{{ansi12|mix:fg_text:0.25}}",
		"syntaxFunction": "{{ansi11|mix:fg_text:0.35}}",
		"syntaxVariable": "{{fg_editor}}",
		"syntaxString": "{{warning}}",
		"syntaxNumber": "{{ansi10|mix:fg_text:0.35}}",
		"syntaxType": "{{ansi14|mix:fg_text:0.25}}",
		"syntaxOperator": "{{fg_text}}",
		"syntaxPunctuation": "{{fg_secondary}}",
		"thinkingOff": "{{fg_muted}}",
		"thinkingMinimal": "{{fg_muted|mix:accent:0.5}}",
		"thinkingLow": "{{accent}}",
		"thinkingMedium": "{{ansi5|legible:term_bg}}",
		"thinkingHigh": "{{ansi13|legible:term_bg}}",
		"thinkingXhigh": "{{warning}}",
		"thinkingMax": "{{error}}",
		"bashMode": "{{success}}"
	},
	"export": {
		"pageBg": "{{term_bg}}",
		"cardBg": "{{bg_widget}}",
		"infoBg": "{{term_bg|mix:warning:0.2}}"
	}
}
