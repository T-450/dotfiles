{
	"$schema": "https://pi.dev/schemas/theme.schema.json",
	"name": "{{slug}}",
	"appearance": "{{variant}}",
	"vars": {
		"bg": "{{term_bg}}",
		"panel": "{{bg_widget}}",
		"text": "{{fg_text}}",
		"bright": "{{fg_bright}}",
		"secondary": "{{fg_secondary}}",
		"muted": "{{fg_muted}}",
		"line": "{{border_inactive}}",
		"hairline": "{{border_hairline}}",
		"accent": "{{accent|mix:ansi12:0.35|legible:term_bg}}",
		"glow": "{{accent|mix:fg_bright:0.3|legible:term_bg}}",
		"link": "{{link|legible:term_bg}}",
		"green": "{{success|legible:term_bg}}",
		"red": "{{error|legible:term_bg}}",
		"amber": "{{warning|legible:term_bg}}",
		"keyword": "{{ansi1|legible:term_bg}}",
		"function": "{{ansi5|legible:term_bg}}",
		"string": "{{ansi12|legible:term_bg}}",
		"constant": "{{ansi4|legible:term_bg}}",
		"type": "{{ansi11|legible:term_bg}}",
		"violet": "{{ansi13|legible:term_bg}}"
	},
	"colors": {
		"accent": "accent",
		"border": "line",
		"borderAccent": "accent",
		"borderMuted": "hairline",
		"success": "green",
		"error": "red",
		"warning": "amber",
		"muted": "secondary",
		"dim": "muted",
		"text": "text",
		"thinkingText": "muted",
		"selectedBg": "{{term_bg|mix:accent:0.32}}",
		"scrollbarTrack": "hairline",
		"scrollbarThumb": "muted",
		"searchMatchBg": "{{term_bg|mix:warning:0.3}}",
		"searchMatchText": "bright",
		"userMessageBg": "{{term_bg|mix:accent:0.16}}",
		"userMessageText": "bright",
		"customMessageBg": "{{term_bg|mix:ansi5:0.14}}",
		"customMessageText": "secondary",
		"customMessageLabel": "function",
		"toolPendingBg": "panel",
		"toolSuccessBg": "{{term_bg|mix:success:0.12}}",
		"toolErrorBg": "{{term_bg|mix:error:0.14}}",
		"toolTitle": "glow",
		"toolOutput": "secondary",
		"mdHeading": "glow",
		"mdLink": "link",
		"mdLinkUrl": "muted",
		"mdCode": "type",
		"mdCodeBlock": "text",
		"mdCodeBlockBorder": "line",
		"mdQuote": "secondary",
		"mdQuoteBorder": "accent",
		"mdHr": "line",
		"mdListBullet": "accent",
		"toolDiffAdded": "green",
		"toolDiffRemoved": "red",
		"toolDiffContext": "muted",
		"syntaxComment": "muted",
		"syntaxKeyword": "keyword",
		"syntaxFunction": "function",
		"syntaxVariable": "{{fg_editor}}",
		"syntaxString": "string",
		"syntaxNumber": "constant",
		"syntaxType": "type",
		"syntaxOperator": "keyword",
		"syntaxPunctuation": "secondary",
		"thinkingOff": "line",
		"thinkingMinimal": "muted",
		"thinkingLow": "link",
		"thinkingMedium": "accent",
		"thinkingHigh": "function",
		"thinkingXhigh": "violet",
		"thinkingMax": "keyword",
		"bashMode": "amber"
	},
	"export": {
		"pageBg": "bg",
		"cardBg": "panel",
		"infoBg": "{{term_bg|mix:accent:0.16}}"
	}
}
