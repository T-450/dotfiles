# {{name}}: helix's theme from the active palette, rendered by `theme`; config.toml selects it
# as "palette". Syntax comes from the palette's syn_* roles (its [syntax] table), each made legible
# on term_bg, the ground (helix runs only in the terminal: its background meets Ghostty's padding,
# while bg_desktop is the desktop chrome's). Without the table, colour is a cue: text and punctuation stay the palette's greys,
# and the syntax takes the terminal's hues (light palettes darken them): keywords magenta, types
# bright magenta, functions bright blue, strings green, constants yellow, attributes and escapes
# cyan, lifetimes and labels bright red. The cursor is the accent, the selection the
# palette's selection fill; popups and menus use the same tiers as the desktop's.

# --- syntax ---
"comment" = { fg = "syn-comment", modifiers = ["italic"] }
"keyword" = "syn-keyword"
"keyword.directive" = "syn-preproc"
"keyword.storage.modifier" = "syn-keyword"
"keyword.operator" = "syn-keyword"
"operator" = "syn-operator"
"punctuation" = "syn-operator"
"punctuation.special" = "syn-special"
"type" = "syn-type"
"type.builtin" = "syn-type"
"type.enum.variant" = "syn-type"
"constructor" = "syn-type"
"namespace" = "syn-type"
"function" = "syn-function"
"function.macro" = "syn-function"
"function.builtin" = "syn-function"
"string" = "syn-string"
"string.regexp" = "syn-special"
"string.special" = "syn-special"
"constant" = "syn-constant"
"constant.builtin" = "syn-constant"
"constant.builtin.boolean" = "syn-boolean"
"constant.numeric" = "syn-number"
"constant.character" = "syn-string"
"constant.character.escape" = "syn-special"
"variable" = "text"
"variable.builtin" = { fg = "syn-keyword", modifiers = ["italic"] }
"variable.parameter" = "text"
"variable.other.member" = "text"
"attribute" = "syn-special"
"label" = "pink"
"special" = "syn-function"
"tag" = "syn-keyword"
"tag.attribute" = "syn-type"

"markup.heading" = { fg = "bright", modifiers = ["bold"] }
"markup.list" = "purple"
"markup.bold" = { modifiers = ["bold"] }
"markup.italic" = { modifiers = ["italic"] }
"markup.strikethrough" = { modifiers = ["crossed_out"] }
"markup.link.url" = { fg = "cyan", modifiers = ["underlined"] }
"markup.link.text" = "sky"
"markup.quote" = { fg = "muted", modifiers = ["italic"] }
"markup.raw" = "mint"

"diff.plus" = "diff-add"
"diff.minus" = "diff-remove"
"diff.delta" = "diff-change"

# --- diagnostics ---
"error" = "error"
"warning" = "warning"
"info" = "info"
"hint" = "muted"
"diagnostic.error" = { underline = { color = "error", style = "curl" } }
"diagnostic.warning" = { underline = { color = "warning", style = "curl" } }
"diagnostic.info" = { underline = { color = "info", style = "curl" } }
"diagnostic.hint" = { underline = { color = "muted", style = "curl" } }
"diagnostic.unnecessary" = { modifiers = ["dim"] }
"diagnostic.deprecated" = { modifiers = ["crossed_out"] }

# --- interface ---
# ui.background's fg is the default for cells nothing else styles: the picker's borders
"ui.background" = { fg = "border", bg = "ground" }
"ui.background.separator" = "disabled"
"ui.text" = "text"
"ui.text.focus" = { fg = "selection-text", bg = "selection" }
"ui.text.inactive" = "muted"
"ui.text.info" = "text"
"ui.text.directory" = "blue"
"ui.cursor" = { fg = "ground", bg = "secondary" }
"ui.cursor.primary" = { fg = "ground", bg = "accent" }
"ui.cursor.primary.insert" = { fg = "ground", bg = "mint" }
"ui.cursor.primary.select" = { fg = "ground", bg = "purple" }
"ui.cursor.match" = { fg = "bright", bg = "border", modifiers = ["bold"] }
"ui.cursorline.primary" = { bg = "surface" }
"ui.selection" = { bg = "selection-dim" }
"ui.selection.primary" = { bg = "selection" }
"ui.highlight" = { bg = "hover" }
"ui.highlight.frameline" = { bg = "hover" }
"ui.linenr" = "disabled"
"ui.linenr.selected" = "secondary"
"ui.gutter" = { bg = "ground" }
"ui.statusline" = { fg = "text", bg = "surface" }
"ui.statusline.inactive" = { fg = "muted", bg = "ground" }
"ui.statusline.normal" = { fg = "ground", bg = "accent", modifiers = ["bold"] }
"ui.statusline.insert" = { fg = "ground", bg = "mint", modifiers = ["bold"] }
"ui.statusline.select" = { fg = "ground", bg = "purple", modifiers = ["bold"] }
"ui.statusline.separator" = "border"
"ui.bufferline" = { fg = "muted", bg = "surface" }
"ui.bufferline.active" = { fg = "bright", bg = "ground", underline = { color = "accent", style = "line" } }
"ui.bufferline.background" = { bg = "surface" }
"ui.breadcrumb" = "secondary"
"ui.breadcrumb.separator" = "disabled"
"ui.popup" = { fg = "text", bg = "widget" }
"ui.popup.info" = { fg = "text", bg = "widget" }
"ui.popup.border" = "border"
"ui.help" = { fg = "text", bg = "widget" }
"ui.menu" = { fg = "text", bg = "widget" }
"ui.menu.selected" = { fg = "selection-text", bg = "selection" }
"ui.menu.scroll" = { fg = "border", bg = "widget" }
"ui.picker.header" = { fg = "muted", modifiers = ["bold"] }
"ui.picker.header.column" = "muted"
"ui.picker.header.column.active" = { fg = "bright", modifiers = ["bold"] }
"ui.window" = "hairline"
"ui.virtual" = "disabled"
"ui.virtual.whitespace" = "hairline"
"ui.virtual.indent-guide" = "hairline"
"ui.virtual.ruler" = { bg = "surface" }
"ui.virtual.wrap" = "disabled"
"ui.virtual.fold-decoration" = "muted"
"ui.virtual.inlay-hint" = { fg = "disabled", modifiers = ["italic"] }
"ui.virtual.jump-label" = { fg = "yellow", modifiers = ["bold"] }
"ui.debug.breakpoint" = "error"
"ui.debug.active" = "yellow"
"tabstop" = { bg = "hover" }

# nested brackets: the lighter (bright) shades, so nesting reads without shouting
rainbow = ["secondary", "lilac", "sky", "mint-light", "yellow-light", "pink"]

[palette]
ground = "{{term_bg}}"
surface = "{{bg_surface}}"
widget = "{{bg_widget}}"
hover = "{{bg_hover}}"
hairline = "{{border_hairline}}"
border = "{{border_inactive}}"
disabled = "{{fg_disabled}}"
muted = "{{fg_muted|legible:term_bg}}"
secondary = "{{fg_secondary}}"
text = "{{fg_editor}}"
bright = "{{fg_bright}}"
accent = "{{accent}}"
selection = "{{selection_bg}}"
selection-dim = "{{selection_bg|mix:term_bg:0.4}}"
selection-text = "{{selection_fg}}"
error = "{{error|legible:term_bg}}"
warning = "{{warning|legible:term_bg}}"
purple = "{{ansi5|legible:term_bg}}"
lilac = "{{ansi13|legible:term_bg}}"
blue = "{{ansi4|legible:term_bg}}"
sky = "{{ansi12|legible:term_bg}}"
cyan = "{{ansi6|legible:term_bg}}"
mint = "{{ansi2|legible:term_bg}}"
mint-light = "{{ansi10|legible:term_bg}}"
yellow = "{{ansi3|legible:term_bg}}"
yellow-light = "{{ansi11|legible:term_bg}}"
pink = "{{ansi9|legible:term_bg}}"
syn-keyword = "{{syn_keyword|legible:term_bg}}"
syn-preproc = "{{syn_preproc|legible:term_bg}}"
syn-type = "{{syn_type|legible:term_bg}}"
syn-function = "{{syn_function|legible:term_bg}}"
syn-string = "{{syn_string|legible:term_bg}}"
syn-constant = "{{syn_constant|legible:term_bg}}"
syn-number = "{{syn_number|legible:term_bg}}"
syn-boolean = "{{syn_boolean|legible:term_bg}}"
syn-special = "{{syn_special|legible:term_bg}}"
syn-operator = "{{syn_operator}}"
syn-comment = "{{syn_comment|legible:term_bg}}"
diff-add = "{{diff_add|legible:term_bg}}"
diff-remove = "{{diff_remove|legible:term_bg}}"
diff-change = "{{diff_change|legible:term_bg}}"
info = "{{info|legible:term_bg}}"
