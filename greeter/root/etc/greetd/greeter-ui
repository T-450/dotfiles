-- ---------------------------------------------------------------- auth flow

local STEP_USER, STEP_PASS, STEP_VISIBLE = 1, 2, 3
local step = STEP_USER
local current_user = ""
local greetd_conn = nil
local busy = false

local function show_error(msg)
	if msg and msg ~= "" then
		err_lbl.label = msg:upper()
		err_lbl:show()
		add_class(input_wrap, "error-state")
	else
		err_lbl:hide()
		remove_class(input_wrap, "error-state")
	end
end

local function flush_ui()
	while Gtk.events_pending() do
		Gtk.main_iteration()
	end
end

local function close_greetd(cancel)
	if greetd_conn then
		if cancel then
			pcall(function() greetd_conn:cancel_session() end)
		end
		greetd_conn:close()
		greetd_conn = nil
	end
end

local function set_step_user(keep_err)
	close_greetd(true)
	step = STEP_USER
	current_user = ""
	step_lbl.label = "USERNAME"
	user_chip:hide()
	entry.visibility = true
	entry.placeholder_text = "ENTER USERNAME"
	entry.text = ""
	hint_lbl.label = "ENTER CONTINUE"
	if not keep_err then show_error(nil) end
	entry:grab_focus()
end

local function set_step_prompt(is_secret, prompt_text)
	step = is_secret and STEP_PASS or STEP_VISIBLE
	local clean = trim((prompt_text or ""):gsub(":%s*$", ""))
	step_lbl.label = (clean ~= "" and clean:upper()) or (is_secret and "PASSWORD" or "RESPONSE")
	user_chip.label = "USER · " .. current_user:upper()
	user_chip:show()
	entry.visibility = not is_secret
	if is_secret then
		entry.invisible_char = 0x25CF -- ●
	end
	entry.placeholder_text = is_secret and "ENTER PASSWORD" or "ENTER RESPONSE"
	entry.text = ""
	hint_lbl.label = "ENTER LOGIN · ESC BACK"
	entry:grab_focus()
end

local function handle_greetd_reply(reply, err)
	if not reply then
		show_error(err or "GREETD IPC ERROR")
		set_step_user(true)
		return
	end

	if reply.type == "success" then
		local s = sessions[sess_idx]
		save_state(current_user, s.id)
		local r2, e2 = greetd_conn:start_session(s.cmd, s.env)
		if r2 and r2.type == "success" then
			greetd_conn:close()
			greetd_conn = nil
			Gtk.main_quit()
			return
		end
		show_error((r2 and r2.description) or e2 or "SESSION START FAILED")
		set_step_user(true)
		return
	end

	if reply.type == "auth_message" then
		local kind = reply.auth_message_type
		if kind == "secret" then
			set_step_prompt(true, reply.auth_message)
			return
		elseif kind == "visible" then
			set_step_prompt(false, reply.auth_message)
			return
		elseif kind == "info" or kind == "error" then
			if kind == "error" and reply.auth_message then
				show_error(reply.auth_message)
			end
			local nxt, nerr = greetd_conn:post_auth(nil)
			handle_greetd_reply(nxt, nerr)
			return
		end
	end

	if reply.type == "error" then
		local msg = (reply.error_type == "auth_error") and "AUTH FAILED" or (reply.description or "AUTH ERROR")
		show_error(msg)
		if step ~= STEP_USER and current_user ~= "" then
			-- Re-initiate session for the same user so user can retry password immediately
			local retry_user = current_user
			close_greetd(true)
			local g, gerr = Greetd.connect(os.getenv("GREETD_SOCK"))
			if g then
				greetd_conn = g
				local r, rerr = g:create_session(retry_user)
				if r and r.type == "auth_message" and r.auth_message_type == "secret" then
					current_user = retry_user
					set_step_prompt(true, r.auth_message)
					return
				end
				if not r then show_error(rerr) end
			else
				show_error(gerr)
			end
		end
		set_step_user(true)
		return
	end

	show_error("UNEXPECTED REPLY")
	set_step_user(true)
end

local function submit()
	if busy then return end
	local val = entry.text or ""
	if step == STEP_USER then
		val = trim(val)
		if val == "" then return end
		busy = true
		show_error(nil)
		current_user = val
		hint_lbl.label = "CONNECTING..."
		flush_ui()

		close_greetd(true)
		local g, err = Greetd.connect(os.getenv("GREETD_SOCK"))
		if not g then
			busy = false
			show_error(err or "NO GREETD SOCKET")
			set_step_user(true)
			return
		end
		greetd_conn = g
		local reply, rerr = g:create_session(current_user)
		busy = false
		handle_greetd_reply(reply, rerr)
	else
		busy = true
		show_error(nil)
		hint_lbl.label = "AUTHENTICATING..."
		flush_ui()
		local reply, rerr = greetd_conn:post_auth(val)
		busy = false
		handle_greetd_reply(reply, rerr)
	end
end

function entry:on_activate()
	submit()
end

function win:on_key_press_event(event)
	local kv = event.keyval
	if kv == Gdk.KEY_Escape then
		set_step_user(false)
		return true
	elseif kv == Gdk.KEY_F2 then
		cycle_session()
		return true
	end
	return false
end

function win:on_destroy()
	close_greetd(true)
	Gtk.main_quit()
end

update_clock()
update_session_labels()
GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, 15, update_clock)

win:show_all()
if last_user and last_user ~= "" then
	entry.text = last_user
	entry:select_region(0, -1)
end
entry:grab_focus()
Gtk.main()
