-- ---------------------------------------------------------------- clock & session helpers

local last_clock_min = ""
local function update_clock()
	local now = os.time()
	local hm = os.date("%H:%M", now)
	if hm ~= last_clock_min then
		last_clock_min = hm
		bar_day.label = os.date("%a", now):upper()
		bar_time.label = hm
		bar_date.label = os.date("%d %b", now):gsub("^0", ""):upper()
		con_clock.label = hm
		con_date.label = os.date("%a · %d %b %Y", now):gsub("· 0", "· "):upper()
	end
	return true
end

local function update_session_labels()
	local s = sessions[sess_idx]
	local label = s.name:upper() .. " (" .. s.kind:upper() .. ")"
	sess_val.label = label
	sess_btn.label = "SESSION · " .. s.name:upper()
end

local function cycle_session()
	sess_idx = (sess_idx % #sessions) + 1
	update_session_labels()
	entry:grab_focus()
end

function sess_btn:on_clicked()
	cycle_session()
end

function reboot_btn:on_clicked()
