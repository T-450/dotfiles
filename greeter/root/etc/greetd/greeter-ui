#!/usr/bin/env luajit
-- greeter-ui: native Viewport (SGI CAD) GTK3 layer-shell greeter for greetd.
-- Speaks greetd-ipc over $GREETD_SOCK (4-byte native uint32 length prefix + UTF-8 JSON) via
-- Gio.UnixSocketAddress, styled with /etc/greetd/greeter.css + /etc/greetd/colors.css (rendered
-- by theme) to match waybar, walker, mango-keys-ui, and hyprlock.
-- usage: greeter-ui [--test-ipc SOCKET]

local ffi = require("ffi")
local lgi = require("lgi")
local GLib = lgi.require("GLib", "2.0")
local Gio = lgi.require("Gio", "2.0")

local css_path = os.getenv("GREETER_CSS") or "/etc/greetd/greeter.css"
local cache_dir = (os.getenv("XDG_CACHE_HOME") or "/var/lib/greeter/.cache") .. "/viewport-greeter"
local state_path = cache_dir .. "/state"

-- ---------------------------------------------------------------- minimal JSON helpers

local function json_escape(s)
	return (s:gsub('[%z\1-\31\\"]', function(c)
		if c == '\\' then return '\\\\'
		elseif c == '"' then return '\\"'
		elseif c == '\n' then return '\\n'
		elseif c == '\r' then return '\\r'
		elseif c == '\t' then return '\\t'
		elseif c == '\b' then return '\\b'
		elseif c == '\f' then return '\\f'
		else return string.format("\\u%04x", c:byte())
		end
	end))
end

local function json_str(s)
	return '"' .. json_escape(s) .. '"'
end

local function json_array(list)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = json_str(v)
	end
	return "[" .. table.concat(out, ",") .. "]"
end

-- Parse greetd's flat JSON response objects (string/bool/null fields) cleanly
local function json_decode_object(text)
	local obj = {}
	local i, len = 1, #text
	local function skip_ws()
		local _, e = text:find("^[ \t\r\n]*", i)
		i = e + 1
	end
	local function parse_string()
		if text:sub(i, i) ~= '"' then return nil end
		i = i + 1
		local parts = {}
		while i <= len do
			local c = text:sub(i, i)
			if c == '"' then
				i = i + 1
				return table.concat(parts)
			elseif c == '\\' then
				i = i + 1
				local esc = text:sub(i, i)
				if esc == '"' or esc == '\\' or esc == '/' then parts[#parts + 1] = esc
				elseif esc == 'n' then parts[#parts + 1] = '\n'
				elseif esc == 'r' then parts[#parts + 1] = '\r'
				elseif esc == 't' then parts[#parts + 1] = '\t'
				elseif esc == 'b' then parts[#parts + 1] = '\b'
				elseif esc == 'f' then parts[#parts + 1] = '\f'
				elseif esc == 'u' then
					local hex = text:sub(i + 1, i + 4)
					local code = tonumber(hex, 16)
					if code and code < 128 then
						parts[#parts + 1] = string.char(code)
					end
					i = i + 4
				end
				i = i + 1
			else
				local nxt = text:find('[\\"]', i) or (len + 1)
				parts[#parts + 1] = text:sub(i, nxt - 1)
				i = nxt
			end
		end
		return nil
	end

	skip_ws()
	if text:sub(i, i) ~= '{' then return obj end
	i = i + 1
	while i <= len do
		skip_ws()
		if text:sub(i, i) == '}' then break end
		local key = parse_string()
		if not key then break end
		skip_ws()
		if text:sub(i, i) ~= ':' then break end
		i = i + 1
		skip_ws()
		local c = text:sub(i, i)
		if c == '"' then
			obj[key] = parse_string()
		elseif text:sub(i, i + 3) == "true" then
			obj[key] = true
			i = i + 4
		elseif text:sub(i, i + 4) == "false" then
			obj[key] = false
			i = i + 5
		elseif text:sub(i, i + 3) == "null" then
			obj[key] = nil
			i = i + 4
		else
			local _, e = text:find("^[^,}%s]+", i)
			if e then
				obj[key] = text:sub(i, e)
				i = e + 1
			else
				break
			end
		end
		skip_ws()
		if text:sub(i, i) == ',' then i = i + 1 end
	end
	return obj
end

-- ---------------------------------------------------------------- greetd-ipc client

local function read_exact(inp, n)
	local chunks = {}
	local got = 0
	while got < n do
		local b, err = inp:read_bytes(n - got)
		if not b then return nil, tostring(err) end
		local s = b:get_data()
		if not s or #s == 0 then return nil, "unexpected EOF from greetd" end
		chunks[#chunks + 1] = s
		got = got + #s
	end
	return table.concat(chunks)
end

local Greetd = {}
Greetd.__index = Greetd

function Greetd.connect(sock_path)
	if not sock_path or sock_path == "" then
		return nil, "GREETD_SOCK not set"
	end
	local client = Gio.SocketClient()
	local addr = Gio.UnixSocketAddress.new(sock_path)
	local conn, err = client:connect(addr)
	if not conn then
		return nil, tostring(err)
	end
	return setmetatable({
		conn = conn,
		inp = conn:get_input_stream(),
		out = conn:get_output_stream(),
	}, Greetd)
end

function Greetd:request(json_payload)
	local len_buf = ffi.new("uint32_t[1]", #json_payload)
	local frame = ffi.string(len_buf, 4) .. json_payload
	local ok, _, err = self.out:write_all(frame)
	if not ok then
		return nil, tostring(err)
	end
	local hdr, rerr = read_exact(self.inp, 4)
	if not hdr then return nil, rerr end
	local rlen = ffi.new("uint32_t[1]")
	ffi.copy(rlen, hdr, 4)
	local n = tonumber(rlen[0])
	if not n or n == 0 or n > 65536 then
		return nil, "invalid greetd reply length: " .. tostring(n)
	end
	local body, berr = read_exact(self.inp, n)
	if not body then return nil, berr end
	return json_decode_object(body)
end

function Greetd:create_session(username)
	return self:request('{"type":"create_session","username":' .. json_str(username) .. '}')
end

function Greetd:post_auth(response)
	if response == nil then
		return self:request('{"type":"post_auth_message_response"}')
	end
	return self:request('{"type":"post_auth_message_response","response":' .. json_str(response) .. '}')
end

function Greetd:start_session(cmd, env)
	return self:request(
		'{"type":"start_session","cmd":' .. json_array(cmd) .. ',"env":' .. json_array(env) .. '}'
	)
end

function Greetd:cancel_session()
	return self:request('{"type":"cancel_session"}')
end

function Greetd:close()
	if self.conn then
		pcall(function() self.conn:close() end)
		self.conn = nil
	end
end

-- Headless binary framing verification (--test-ipc SOCKET)
if arg[1] == "--test-ipc" then
	local g, err = Greetd.connect(arg[2])
	assert(g, err)
	local r1, e1 = g:create_session("alice")
	assert(r1 and r1.type == "auth_message" and r1.auth_message_type == "secret", e1 or tostring(r1 and r1.type))
	local r2, e2 = g:post_auth("s3cr3t")
	assert(r2 and r2.type == "success", e2 or tostring(r2 and r2.type))
	local r3, e3 = g:start_session({ "mango" }, { "XDG_SESSION_TYPE=wayland", "XDG_CURRENT_DESKTOP=mango" })
	assert(r3 and r3.type == "success", e3 or tostring(r3 and r3.type))
	g:close()
	print("ok: greetd-ipc binary framing verified")
	os.exit(0)
end

-- ---------------------------------------------------------------- session & state helpers

local function read_file(path)
	local f = io.open(path, "r")
	if not f then return nil end
	local s = f:read("*a")
	f:close()
	return s
end

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function get_hostname()
	local h = read_file("/etc/hostname")
	if h then
		h = trim(h):gsub("%..*$", "")
		if h ~= "" then return h:upper() end
	end
	return "ARCH"
end

local function split_exec(exec_line)
	local args = {}
	for tok in exec_line:gmatch("%S+") do
		if not tok:match("^%%[a-zA-Z]$") then
			args[#args + 1] = tok
		end
	end
	return args
end

local function discover_sessions()
	local sessions = {}
	local dirs = {
		{ "/usr/share/wayland-sessions", "wayland" },
		{ "/usr/share/xsessions", "x11" },
	}
	for _, d in ipairs(dirs) do
		local dir = Gio.File.new_for_path(d[1])
		local enum = dir:enumerate_children("standard::name", Gio.FileQueryInfoFlags.NONE)
		if enum then
			while true do
				local info = enum:next_file()
				if not info then break end
				local fname = info:get_name()
				if fname:match("%.desktop$") then
					local content = read_file(d[1] .. "/" .. fname)
					if content then
						local name, exec_s, desktops, hidden
						for line in (content .. "\n"):gmatch("([^\r\n]*)\r?\n") do
							if line:match("^%[Desktop Entry%]") then
								-- entry section
							elseif line:match("^%[") then
								break
							elseif line:match("^Name=") then
								name = trim(line:sub(6))
							elseif line:match("^Exec=") then
								exec_s = trim(line:sub(6))
							elseif line:match("^DesktopNames=") then
								desktops = trim(line:sub(14))
							elseif line:match("^Hidden=true") or line:match("^NoDisplay=true") then
								hidden = true
							end
						end
						if not hidden and name and exec_s and exec_s ~= "" then
							local cmd = split_exec(exec_s)
							local primary = desktops and desktops:match("^([^;]+)") or name:lower()
							local env = { "XDG_SESSION_TYPE=" .. d[2] }
							if primary and primary ~= "" then
								env[#env + 1] = "XDG_CURRENT_DESKTOP=" .. primary
								env[#env + 1] = "XDG_SESSION_DESKTOP=" .. primary
							end
							sessions[#sessions + 1] = {
								id = fname:gsub("%.desktop$", ""),
								name = name,
								kind = d[2],
								cmd = cmd,
								env = env,
							}
						end
					end
				end
			end
		end
	end
	table.sort(sessions, function(a, b)
		local am = (a.id == "mango") and 0 or 1
		local bm = (b.id == "mango") and 0 or 1
		if am ~= bm then return am < bm end
		return a.name:lower() < b.name:lower()
	end)
	if #sessions == 0 then
		sessions[1] = {
			id = "mango",
			name = "Mango",
			kind = "wayland",
			cmd = { "mango" },
			env = { "XDG_SESSION_TYPE=wayland", "XDG_CURRENT_DESKTOP=mango", "XDG_SESSION_DESKTOP=mango" },
		}
	end
	return sessions
end

local function load_state()
	local text = read_file(state_path)
	if not text then return nil, nil end
	local u = text:match("user=([^\r\n]+)")
	local s = text:match("session=([^\r\n]+)")
	return u, s
end

local function save_state(user, sess_id)
	pcall(function()
		GLib.mkdir_with_parents(cache_dir, tonumber("755", 8))
		local f = io.open(state_path .. ".tmp", "w")
		if f then
			f:write("user=" .. user .. "\nsession=" .. sess_id .. "\n")
			f:close()
			os.rename(state_path .. ".tmp", state_path)
		end
	end)
end

