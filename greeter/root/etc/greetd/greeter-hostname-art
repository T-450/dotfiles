#!/usr/bin/env bash
# greeter-hostname-art [--check]: the login screen's art is this machine's host name, not the word
# "mango". sysc-greet draws the art of the session it starts (ascii_configs/mango.conf for Mango) and
# reads that only from its package's data dir, so this rewrites the file: the host name in capitals
# (lowercase "p" adds a descender row that runs into the background's eclipse) in sysc-greet's own
# dos_rebel FIGlet font, the blocks in ANSI 97 and their shade in 90, which sysc-greet maps to its
# theme's text and muted colors. Run as root by greeter/setup.sh and by the pacman hook that follows
# each sysc-greet-mango update (which puts the packaged art back). Writes only on a difference;
# --check exits 1 when the file differs, without root.
set -euo pipefail
conf=/usr/share/sysc-greet/ascii_configs/mango.conf
fonts=/usr/share/sysc-greet/fonts
host=$(cat /etc/hostname 2>/dev/null || uname -n)
host=${host%%.*}
art=$(figlet -W -w 1000 -d "$fonts" -f dos_rebel -- "${host^^}" |
	sed -e 's/[[:space:]]*$//' -e '/^$/d' -e 's/█\+/\\033[0;97m&/g' -e 's/░\+/\\033[0;90m&/g' -e 's/$/\\033[0m/')
# name stays Mango: it is the session's; only the art changes
want=$(printf '# %s: the host name (greeter-hostname-art, from the dotfiles greeter app)\nname=Mango\nansi_style=true\nascii_1="""\n%s\n"""\n' \
	"$host" "$art")
[[ $(cat "$conf" 2>/dev/null) == "$want" ]] && exit 0
[[ ${1:-} == --check ]] && exit 1
printf '%s\n' "$want" >"$conf.tmp"
chmod 644 "$conf.tmp"
mv -f "$conf.tmp" "$conf"
echo "art     $conf: $host"
