# Generated by theme/theme from palettes/{{slug}}.toml ({{name}}). Do not edit.
# sysc-greet theme with a stable name, so switching palettes only means
# re-running `theme install-greeter` (the greeter keeps its own preferences).
name = "Mango"

[colors]
bg_base      = "{{bg_desktop}}"
bg_active    = "{{bg_widget}}"
primary      = "{{accent}}"
secondary    = "{{selection_bg}}"
accent       = "{{link}}"
warning      = "{{warning}}"
danger       = "{{error}}"
fg_primary   = "{{fg_text}}"
fg_secondary = "{{fg_secondary}}"
fg_muted     = "{{fg_muted}}"
border_focus = "{{accent}}"
